<section class="apex-trust apex-section"><div class="apex-container"><div class="apex-trust__head"><div><div class="apex-label">{{ section.settings.eyebrow }}</div><h2 class="apex-display">{{ section.settings.heading }}</h2></div><div class="apex-trust__intro">{{ section.settings.intro }}</div></div><div class="apex-trust__grid">{% for block in section.blocks %}<div class="apex-trust-card" {{ block.shopify_attributes }}><span class="apex-trust-card__number">{{ block.settings.number }}</span><h3>{{ block.settings.heading }}</h3><div>{{ block.settings.body }}</div></div>{% endfor %}</div></div></section>
{% stylesheet %}
.apex-trust{padding:92px 0;background:#f7f8f8;color:var(--apex-oxford)}.apex-trust__head{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:40px}.apex-trust h2{font-size:52px;line-height:1;text-transform:uppercase;margin:12px 0 0}.apex-trust__intro{max-width:520px;color:#566173;line-height:1.7}.apex-trust__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(11,29,79,.14);border-left:1px solid rgba(11,29,79,.14)}.apex-trust-card{min-height:270px;border-right:1px solid rgba(11,29,79,.14);border-bottom:1px solid rgba(11,29,79,.14);padding:26px;display:flex;flex-direction:column;justify-content:flex-end}.apex-trust-card__number{font-size:10px;letter-spacing:.16em;color:var(--apex-brandeis);font-weight:700}.apex-trust-card h3{margin:8px 0 10px;font-size:24px;line-height:1.05;text-transform:uppercase}.apex-trust-card>div{color:#687283;line-height:1.6;font-size:14px}@media(max-width:900px){.apex-trust__head{grid-template-columns:1fr}.apex-trust__grid{grid-template-columns:1fr 1fr}}@media(max-width:749px){.apex-trust{padding:68px 0}.apex-trust h2{font-size:40px}.apex-trust__grid{grid-template-columns:1fr}.apex-trust-card{min-height:220px}}
{% endstylesheet %}
{% schema %}
{"name":"APEX Trust","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"06 / TRUST & AUTHENTICITY"},{"type":"text","id":"heading","label":"Heading","default":"EVERY PART EARNS ITS PLACE."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>APEX LAB gives enthusiasts confidence in what goes onto their cars: genuine parts, authentic brands and products selected for performance and reliability.</p>"}],"blocks":[{"type":"proof","name":"Proof point","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"heading","label":"Heading","default":"GENUINE"},{"type":"richtext","id":"body","label":"Body","default":"<p>Sourced, not substituted.</p>"}]}],"presets":[{"name":"APEX Trust","blocks":[{"type":"proof"},{"type":"proof"},{"type":"proof"},{"type":"proof"}]}]}
{% endschema %}
