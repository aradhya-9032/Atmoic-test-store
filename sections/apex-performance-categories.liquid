{% liquid
  assign catalog_collection = section.settings.collection
  assign products = catalog_collection.products
%}

<section class="apex-catalog" id="ApexCatalog-{{ section.id }}">
  <div class="apex-catalog__container">

    <!-- BREADCRUMB -->
    <div class="apex-catalog__breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span>{{ section.settings.heading }}</span>
    </div>

    <!-- TOP -->
    <div class="apex-catalog__top">
      <h1 class="apex-catalog__title" id="ApexCatalogTitle-{{ section.id }}">{{ section.settings.heading }}</h1>

      {% if catalog_collection != blank %}
        <div class="apex-catalog__controls">
          <span class="apex-catalog__count">
            <span id="ApexVisibleCount-{{ section.id }}">{{ products.size }}</span>
            items · Sort
          </span>

          <select class="apex-catalog__sort" id="ApexCatalogSort-{{ section.id }}">
            <option value="featured">Featured</option>
            <option value="title-ascending">Name: A-Z</option>
            <option value="title-descending">Name: Z-A</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
          </select>
        </div>
      {% endif %}
    </div>

    <div class="apex-catalog__layout">

      <!-- FILTER SIDEBAR -->
      <aside class="apex-catalog__sidebar">
        <div class="apex-filter-card">

          <div class="apex-filter-heading">CATEGORY</div>

          {%- assign apex_category_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              {%- assign apex_category_count = apex_category_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="apex-category-list" data-apex-category-list>
            {% if apex_category_count > 0 %}
              {% assign apex_category_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'category' and block.settings.label != blank %}
                  <button
                    type="button"
                    class="apex-filter-row apex-filter-row--category apex-category-toggle{% if apex_category_index == 0 %} is-active{% endif %}"
                    data-category="{{ block.id }}"
                    data-category-title="{{ block.settings.label | escape }}"
                    data-category-filters="{{ block.settings.filter_keys | default: 'price,brand' | downcase | replace: ' ', '' }}"
                    aria-expanded="{% if apex_category_index == 0 %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label }}</span>
                    <span class="apex-filter-arrow">⌃</span>
                  </button>
                  {% assign apex_category_index = apex_category_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            {% else %}
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle is-active" data-category="brakes" data-category-title="Brakes" data-category-filters="type,price,size,brand,material" aria-expanded="true"><span>Brakes</span><span class="apex-filter-arrow">⌃</span></button>
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle" data-category="suspension" data-category-title="Suspension" data-category-filters="price,brand,suspension" aria-expanded="false"><span>Suspension</span><span class="apex-filter-arrow">⌃</span></button>
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle" data-category="engine" data-category-title="Engine" data-category-filters="price,brand,engine" aria-expanded="false"><span>Engine</span><span class="apex-filter-arrow">⌃</span></button>
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle" data-category="exhaust" data-category-title="Exhaust" data-category-filters="price,brand,exhaust" aria-expanded="false"><span>Exhaust</span><span class="apex-filter-arrow">⌃</span></button>
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle" data-category="wheels" data-category-title="Wheels &amp; Tires" data-category-filters="size,brand,wheels" aria-expanded="false"><span>Wheels &amp; Tires</span><span class="apex-filter-arrow">⌃</span></button>
              <button type="button" class="apex-filter-row apex-filter-row--category apex-category-toggle" data-category="racing-gear" data-category-title="Racing Gear" data-category-filters="brand,material" aria-expanded="false"><span>Racing Gear</span><span class="apex-filter-arrow">⌃</span></button>
            {% endif %}
          </div>

          <div class="apex-category-content is-open" data-apex-category-content>

          <!-- TYPE -->
          <div class="apex-filter-item" data-filter-key="type">
            <button
              type="button"
              class="apex-filter-row apex-filter-trigger"
              data-filter-panel="type"
              aria-expanded="false"
            >
              <span>Type</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="type">
              <div class="apex-filter-popup__title">TYPE</div>

              {% assign types_seen = '||' %}
              {% for product in products %}
                {% if product.type != blank %}
                  {% assign type_key = '||' | append: product.type | append: '||' %}
                  {% unless types_seen contains type_key %}
                    <label class="apex-checkbox">
                      <input
                        type="checkbox"
                        class="apex-filter-checkbox"
                        data-filter-group="type"
                        value="{{ product.type | escape }}"
                      >
                      <span class="apex-checkbox-box"></span>
                      <span>{{ product.type }}</span>
                    </label>
                    {% assign types_seen = types_seen | append: product.type | append: '||' %}
                  {% endunless %}
                {% endif %}
              {% endfor %}

              {% if types_seen == '||' %}
                <div class="apex-filter-empty">No Type values found.</div>
              {% endif %}
            </div>
          </div>

          <!-- PRICE -->
          <div class="apex-filter-item" data-filter-key="price">
            <button
              type="button"
              class="apex-filter-row apex-filter-trigger"
              data-filter-panel="price"
              aria-expanded="false"
            >
              <span>Price</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="price">
              <div class="apex-filter-popup__title">PRICE</div>

              <label class="apex-checkbox">
                <input type="checkbox" class="apex-price-filter" data-min="0" data-max="500000">
                <span class="apex-checkbox-box"></span>
                <span>Under ₹5,000</span>
              </label>

              <label class="apex-checkbox">
                <input type="checkbox" class="apex-price-filter" data-min="500000" data-max="2000000">
                <span class="apex-checkbox-box"></span>
                <span>₹5,000 – ₹20,000</span>
              </label>

              <label class="apex-checkbox">
                <input type="checkbox" class="apex-price-filter" data-min="2000000" data-max="10000000">
                <span class="apex-checkbox-box"></span>
                <span>₹20,000 – ₹100,000</span>
              </label>

              <label class="apex-checkbox">
                <input type="checkbox" class="apex-price-filter" data-min="10000000" data-max="999999999999">
                <span class="apex-checkbox-box"></span>
                <span>Above ₹100,000</span>
              </label>
            </div>
          </div>

          <!-- SIZE: PRODUCT TAG FORMAT = Size:18 inch -->
          <div class="apex-filter-item" data-filter-key="size">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="size" aria-expanded="false">
              <span>Size</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="size">
              <div class="apex-filter-popup__title">SIZE</div>
              {% assign size_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 5 %}
                  {% if prefix == 'Size:' %}
                    {% assign option = tag | remove_first: 'Size:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless size_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-size" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign size_seen = size_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if size_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Size:18 inch</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- BRAND -->
          <div class="apex-filter-item" data-filter-key="brand">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="brand" aria-expanded="false">
              <span>Brand</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="brand">
              <div class="apex-filter-popup__title">BRAND</div>

              {% assign vendors_seen = '||' %}
              {% for product in products %}
                {% if product.vendor != blank %}
                  {% assign vendor_key = '||' | append: product.vendor | append: '||' %}
                  {% unless vendors_seen contains vendor_key %}
                    <label class="apex-checkbox">
                      <input
                        type="checkbox"
                        class="apex-filter-checkbox"
                        data-filter-group="vendor"
                        value="{{ product.vendor | escape }}"
                      >
                      <span class="apex-checkbox-box"></span>
                      <span>{{ product.vendor }}</span>
                    </label>
                    {% assign vendors_seen = vendors_seen | append: product.vendor | append: '||' %}
                  {% endunless %}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- MATERIAL: Material:Carbon -->
          <div class="apex-filter-item" data-filter-key="material">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="material" aria-expanded="false">
              <span>Material</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="material">
              <div class="apex-filter-popup__title">MATERIAL</div>
              {% assign material_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 9 %}
                  {% if prefix == 'Material:' %}
                    {% assign option = tag | remove_first: 'Material:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless material_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-material" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign material_seen = material_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if material_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Material:Carbon</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- SUSPENSION: Suspension:Coilovers -->
          <div class="apex-filter-item" data-filter-key="suspension">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="suspension" aria-expanded="false">
              <span>Suspension</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="suspension">
              <div class="apex-filter-popup__title">SUSPENSION</div>
              {% assign suspension_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 11 %}
                  {% if prefix == 'Suspension:' %}
                    {% assign option = tag | remove_first: 'Suspension:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless suspension_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-suspension" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign suspension_seen = suspension_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if suspension_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Suspension:Coilovers</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- ENGINE: Engine:Turbo -->
          <div class="apex-filter-item" data-filter-key="engine">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="engine" aria-expanded="false">
              <span>Engine</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="engine">
              <div class="apex-filter-popup__title">ENGINE</div>
              {% assign engine_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 7 %}
                  {% if prefix == 'Engine:' %}
                    {% assign option = tag | remove_first: 'Engine:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless engine_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-engine" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign engine_seen = engine_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if engine_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Engine:Turbo</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- EXHAUST: Exhaust:Cat Back -->
          <div class="apex-filter-item" data-filter-key="exhaust">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="exhaust" aria-expanded="false">
              <span>Exhaust</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="exhaust">
              <div class="apex-filter-popup__title">EXHAUST</div>
              {% assign exhaust_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 8 %}
                  {% if prefix == 'Exhaust:' %}
                    {% assign option = tag | remove_first: 'Exhaust:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless exhaust_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-exhaust" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign exhaust_seen = exhaust_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if exhaust_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Exhaust:Cat Back</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- WHEELS & TIRES: Wheels:19 inch -->
          <div class="apex-filter-item" data-filter-key="wheels">
            <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="wheels" aria-expanded="false">
              <span>Wheels &amp; Tires</span>
              <span class="apex-filter-arrow">›</span>
            </button>

            <div class="apex-filter-popup" data-filter-popup="wheels">
              <div class="apex-filter-popup__title">WHEELS &amp; TIRES</div>
              {% assign wheels_seen = '||' %}
              {% for product in products %}
                {% for tag in product.tags %}
                  {% assign prefix = tag | slice: 0, 7 %}
                  {% if prefix == 'Wheels:' %}
                    {% assign option = tag | remove_first: 'Wheels:' | strip %}
                    {% assign option_key = '||' | append: option | append: '||' %}
                    {% unless wheels_seen contains option_key %}
                      <label class="apex-checkbox">
                        <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-wheels" value="{{ tag | escape }}">
                        <span class="apex-checkbox-box"></span>
                        <span>{{ option }}</span>
                      </label>
                      {% assign wheels_seen = wheels_seen | append: option | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}
              {% if wheels_seen == '||' %}
                <div class="apex-filter-empty">Add tags like <strong>Wheels:19 inch</strong>.</div>
              {% endif %}
            </div>
          </div>

          <!-- OPTIONAL CUSTOM FILTERS FROM THEME EDITOR -->
          {% for block in section.blocks %}
            {% if block.type == 'tag_filter' and block.settings.label != blank and block.settings.tag_prefix != blank %}
              {% assign panel_id = 'custom-' | append: block.id %}
              {% assign prefix_length = block.settings.tag_prefix | size %}

              <div class="apex-filter-item" data-filter-key="custom-{{ block.id }}" {{ block.shopify_attributes }}>
                <button type="button" class="apex-filter-row apex-filter-trigger" data-filter-panel="{{ panel_id }}" aria-expanded="false">
                  <span>{{ block.settings.label }}</span>
                  <span class="apex-filter-arrow">›</span>
                </button>

                <div class="apex-filter-popup" data-filter-popup="{{ panel_id }}">
                  <div class="apex-filter-popup__title">{{ block.settings.label | upcase }}</div>
                  {% assign custom_seen = '||' %}

                  {% for product in products %}
                    {% for tag in product.tags %}
                      {% assign tag_prefix = tag | slice: 0, prefix_length %}
                      {% if tag_prefix == block.settings.tag_prefix %}
                        {% assign option = tag | remove_first: block.settings.tag_prefix | strip %}
                        {% assign option_key = '||' | append: option | append: '||' %}
                        {% unless custom_seen contains option_key %}
                          <label class="apex-checkbox">
                            <input type="checkbox" class="apex-filter-checkbox" data-filter-group="tag-{{ block.id }}" value="{{ tag | escape }}">
                            <span class="apex-checkbox-box"></span>
                            <span>{{ option }}</span>
                          </label>
                          {% assign custom_seen = custom_seen | append: option | append: '||' %}
                        {% endunless %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}

                  {% if custom_seen == '||' %}
                    <div class="apex-filter-empty">No matching product tags yet.</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          <button type="button" class="apex-clear-filters" id="ApexClearFilters-{{ section.id }}">
            Clear filters
          </button>
          </div>

        </div>
      </aside>

      <!-- PRODUCTS -->
      <div class="apex-catalog__products">
        {% if catalog_collection != blank %}
          <div class="apex-product-grid" id="ApexProductGrid-{{ section.id }}">

            {% for product in products %}
              <article
                class="apex-catalog-product apc-card"
                data-title="{{ product.title | escape }}"
                data-price="{{ product.price }}"
                data-type="{{ product.type | escape }}"
                data-vendor="{{ product.vendor | escape }}"
                data-tags="{{ product.tags | join: '||' | escape }}"
              >
                <div class="apex-catalog-product__image">

                  <!-- IMPORTANT: WISHLIST IS NOT INSIDE THE PRODUCT LINK -->
                  <button
                    type="button"
                    class="apex-product-card__wishlist apc-card__wish"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    aria-pressed="false"
                    data-wishlist-product-handle="{{ product.handle }}"
                  >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>

                  <a href="{{ product.url }}" class="apex-catalog-product__image-link">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          class: 'apex-catalog-product__img apc-card__img',
                          alt: product.title
                      }}
                    {% else %}
                      <div class="apex-catalog-product__placeholder">No image</div>
                    {% endif %}
                  </a>
                </div>

                <div class="apex-catalog-product__content">
                  {% if product.vendor != blank %}
                    <div class="apex-catalog-product__vendor">{{ product.vendor }}</div>
                  {% endif %}

                  <h3 class="apex-catalog-product__title">
                    <a href="{{ product.url }}" class="apc-card__title">{{ product.title }}</a>
                  </h3>

                  <div class="apex-catalog-product__stock">
                    {% if product.available %}
                      <span class="is-in-stock">In stock</span>
                    {% else %}
                      <span class="is-sold-out">Sold out</span>
                    {% endif %}
                  </div>

                  <div class="apex-catalog-product__bottom">
                    <div class="apex-catalog-product__price apc-card__price">{{ product.price | money }}</div>

                    {% if product.available %}
                      <form method="post" action="{{ routes.cart_add_url }}">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" class="apex-add-button">Add</button>
                      </form>
                    {% else %}
                      <button class="apex-add-button" disabled>Sold out</button>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endfor %}

          </div>

          <div class="apex-no-results" id="ApexNoResults-{{ section.id }}" hidden>
            No products found.
          </div>
        {% else %}
          <div class="apex-catalog__empty">
            <h3>Select a collection</h3>
            <p>Select your product collection in the Theme Editor.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.apex-catalog,
.apex-catalog * { box-sizing: border-box; }

.apex-catalog {
  background: #f7f6f2;
  color: #20262e;
  padding: 42px 0 80px;
}

.apex-catalog__container {
  width: min(100% - 64px, 1600px);
  margin: 0 auto;
}

.apex-catalog__breadcrumb {
  display: flex;
  gap: 5px;
  margin-bottom: 22px;
  font-size: 13px;
  color: #777f89;
}

.apex-catalog__breadcrumb a {
  color: inherit;
  text-decoration: none;
}

.apex-catalog__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  gap: 20px;
}

.apex-catalog__title {
  margin: 0;
  font-size: 42px;
  line-height: 1;
  font-weight: 750;
  letter-spacing: -1.8px;
}

.apex-catalog__controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.apex-catalog__count {
  font-size: 13px;
  color: #69717b;
}

.apex-catalog__sort {
  width: 150px;
  height: 48px;
  padding: 0 16px;
  border: 1px solid #d9dce0;
  border-radius: 25px;
  background: #fff;
  color: #4d5661;
  outline: none;
  cursor: pointer;
}

.apex-catalog__layout {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: 28px;
  align-items: start;
}

.apex-filter-card {
  position: relative;
  background: #fff;
  border: 1px solid #e1e2df;
  border-radius: 18px;
  padding: 18px 12px 16px;
  box-shadow: 0 4px 20px rgba(20, 25, 35, .03);
}

.apex-filter-heading {
  padding: 0 10px;
  margin-bottom: 12px;
  color: #747b83;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.apex-filter-row {
  width: 100%;
  min-height: 39px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
