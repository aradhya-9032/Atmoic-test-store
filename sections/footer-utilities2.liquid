<div class="atomic-footer-utilities">

  <div class="atomic-utilities-inner">

    <!-- LEFT : COUNTRY / CURRENCY -->
    <div class="atomic-utility-left">
      {% form 'localization', class: 'atomic-localization-form' %}

        <select
          name="country_code"
          class="atomic-country-select"
          onchange="this.form.submit()"
        >
          {% for country in localization.available_countries %}
            <option
              value="{{ country.iso_code }}"
              {% if country.iso_code == localization.country.iso_code %}
                selected
              {% endif %}
            >
              {{ country.name }} ({{ country.currency.iso_code }})
            </option>
          {% endfor %}
        </select>

      {% endform %}
    </div>


    <!-- CENTER : COPYRIGHT / STORE NAME -->
    <div class="atomic-utility-center">
      <span>
        ATOMIC-SHOP Performance Parts &amp; Motorsport Equipment - UAE
      </span>
    </div>


    <!-- RIGHT : PAYMENT -->
    <div class="atomic-utility-right">

      <span class="atomic-payment-label">
        We accept
      </span>

      <div class="atomic-payment-icons">

        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'atomic-payment-icon' }}
        {% endfor %}

      </div>

    </div>

  </div>

</div>


{% stylesheet %}

/* =========================================
   ATOMIC FOOTER UTILITIES
   ========================================= */

.atomic-footer-utilities {
  width: 100%;

  background: #242424;

  border-top: 1px solid rgba(255,255,255,0.08);

  color: #ffffff;

  box-sizing: border-box;
}


/* =========================================
   MAIN CONTAINER
   ========================================= */

.atomic-utilities-inner {

  width: 100%;

  max-width: 1400px;

  margin: 0 auto;

  padding: 18px 38px;

  box-sizing: border-box;

  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 25px;

}


/* =========================================
   LEFT
   ========================================= */

.atomic-utility-left {

  display: flex;

  align-items: center;

  justify-content: flex-start;
}


.atomic-localization-form {

  margin: 0;

  padding: 0;
}


.atomic-country-select {

  min-width: 95px;

  height: 28px;

  padding: 0 25px 0 8px;

  background: #242424;

  color: #ffffff;

  border: 1px solid rgba(255,255,255,0.15);

  border-radius: 0;

  font-size: 10px;

  cursor: pointer;

  outline: none;

  appearance: auto;
}


.atomic-country-select:hover {

  border-color: rgba(255,255,255,0.35);
}


/* =========================================
   CENTER
   ========================================= */

.atomic-utility-center {

  text-align: center;

  white-space: nowrap;

  color: #ffffff;

  font-size: 10px;

  line-height: 1.5;
}


/* =========================================
   RIGHT
   ========================================= */

.atomic-utility-right {

  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 12px;
}


.atomic-payment-label {

  color: #ffffff;

  font-size: 10px;

  white-space: nowrap;
}


/* =========================================
   PAYMENT ICONS
   ========================================= */

.atomic-payment-icons {

  display: flex;

  align-items: center;

  gap: 5px;

  flex-wrap: nowrap;
}


.atomic-payment-icon {

  display: block;

  width: 28px;

  height: 20px;

  object-fit: contain;
}


/* =========================================
   TABLET
   ========================================= */

@media screen and (min-width: 750px) and (max-width: 989px) {

  .atomic-utilities-inner {

    padding: 18px 25px;

    grid-template-columns: auto 1fr auto;

    gap: 15px;
  }

  .atomic-utility-center {

    font-size: 9px;
  }

  .atomic-payment-label {

    font-size: 9px;
  }

}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

  .atomic-utilities-inner {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 15px;

    padding: 20px 15px;
  }


  .atomic-utility-left {

    justify-content: center;
  }


  .atomic-utility-center {

    order: 2;

    white-space: normal;

    text-align: center;

    font-size: 10px;
  }


  .atomic-utility-right {

    order: 3;

    justify-content: center;

    flex-wrap: wrap;
  }

}


/* =========================================
   REMOVE OLD UTILITY BLOCK OUTPUT
   ========================================= */

.footer-utilities > .section-background,
.footer-utilities > .section {

  display: none !important;
}

{% endstylesheet %}


{% schema %}

{
  "name": "Footer Utilities",
  "tag": "div",
  "class": "footer-utilities",

  "enabled_on": {
    "groups": ["footer"]
  },

  "settings": [],

  "blocks": [],

  "presets": [
    {
      "name": "Footer Utilities",
      "category": "Footer"
    }
  ]
}

{% endschema %}