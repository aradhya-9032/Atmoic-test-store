<section
  class="nissan-gtr-section"
  style="
    --nissan-bg: {{ section.settings.background_color }};
    --nissan-panel: {{ section.settings.panel_background }};
    --nissan-text: {{ section.settings.text_color }};
    --nissan-muted: {{ section.settings.muted_text_color }};
    --nissan-button: {{ section.settings.button_color }};
    --nissan-button-text: {{ section.settings.button_text_color }};
    --nissan-accent: {{ section.settings.accent_color }};
    --nissan-border: {{ section.settings.border_color }};
    --nissan-overlay: {{ section.settings.image_overlay | divided_by: 100.0 }};
    --nissan-width: {{ section.settings.content_width }}px;
  "
>
  <div class="nissan-gtr-section__grid"></div>

  <div class="nissan-gtr-section__container">

    <!-- IMAGE -->
    <div class="nissan-gtr-section__media nissan-reveal">

      {% if section.settings.image != blank %}
        <div class="nissan-gtr-section__image-wrap">

          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '700,1000,1300,1600,1800',
              class: 'nissan-gtr-section__image-img',
              alt: section.settings.image.alt | default: section.settings.heading
          }}

          <div class="nissan-gtr-section__image-overlay"></div>

          <div class="nissan-gtr-section__image-top">
            <span>{{ section.settings.image_kicker }}</span>
            <span>{{ section.settings.image_index }}</span>
          </div>

          <div class="nissan-gtr-section__image-bottom">
            <span>{{ section.settings.image_label }}</span>
          </div>

        </div>
      {% endif %}

    </div>


    <!-- CONTENT -->
    <div class="nissan-gtr-section__content nissan-reveal">

      {% if section.settings.kicker != blank %}
        <p class="nissan-gtr-section__kicker">
          <span></span>
          {{ section.settings.kicker }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="nissan-gtr-section__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.accent_heading != blank %}
        <div class="nissan-gtr-section__accent-heading">
          {{ section.settings.accent_heading }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="nissan-gtr-section__description">
          {{ section.settings.description }}
        </div>
      {% endif %}


      {% if section.settings.show_stats %}
        <div class="nissan-gtr-section__stats">

          <div class="nissan-gtr-section__stat">
            <strong>{{ section.settings.stat_one_value }}</strong>
            <span>{{ section.settings.stat_one_label }}</span>
          </div>

          <div class="nissan-gtr-section__stat">
            <strong>{{ section.settings.stat_two_value }}</strong>
            <span>{{ section.settings.stat_two_label }}</span>
          </div>

          <div class="nissan-gtr-section__stat">
            <strong>{{ section.settings.stat_three_value }}</strong>
            <span>{{ section.settings.stat_three_label }}</span>
          </div>

        </div>
      {% endif %}


      {% if section.settings.button_text != blank %}
        <div class="nissan-gtr-section__actions">

          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="nissan-gtr-section__button"
          >
            <span>{{ section.settings.button_text }}</span>
          </a>

          {% if section.settings.secondary_text != blank %}
            <a
              href="{{ section.settings.secondary_link | default: '#' }}"
              class="nissan-gtr-section__secondary"
            >
              <span>{{ section.settings.secondary_text }}</span>
            </a>
          {% endif %}

        </div>
      {% endif %}


      <div class="nissan-gtr-section__footer-line">
        <span>{{ section.settings.footer_left }}</span>
        <span>{{ section.settings.footer_right }}</span>
      </div>

    </div>

  </div>
</section>


<script>
  (() => {
    const section = document.currentScript.previousElementSibling;

    if (!section) return;

    const elements = section.querySelectorAll('.nissan-reveal');

    if (!('IntersectionObserver' in window)) {
      elements.forEach((element) => {
        element.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          elements.forEach((element, index) => {
            setTimeout(() => {
              element.classList.add('is-visible');
            }, index * 140);
          });

          observer.disconnect();
        });
      },
      {
        threshold: 0.12
      }
    );

    observer.observe(section);
  })();
</script>


{% stylesheet %}

/* ==========================================================
   NISSAN GT-R COLLECTION — PREMIUM PERFORMANCE
========================================================== */

.nissan-gtr-section {
  position: relative;

  width: 100%;

  overflow: hidden;

  background:
    var(--nissan-bg);

  color:
    var(--nissan-text);

  padding:
    76px 0;
}

.nissan-gtr-section,
.nissan-gtr-section * {
  box-sizing: border-box;
}


/* ==========================================================
   TECHNICAL GRID
========================================================== */

.nissan-gtr-section__grid {
  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .65;

  background-image:
    linear-gradient(
      rgba(7,24,43,.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(7,24,43,.055) 1px,
      transparent 1px
    );

  background-size:
    52px 52px;

  mask-image:
    linear-gradient(
      to right,
      black,
      transparent 92%
    );
}


/* ==========================================================
   CONTAINER
========================================================== */

.nissan-gtr-section__container {
  position: relative;

  z-index: 2;

  width:
    min(
      var(--nissan-width),
      calc(100% - 48px)
    );

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.12fr)
    minmax(360px, .88fr);

  align-items: stretch;

  gap:
    0;
}


/* ==========================================================
   IMAGE
========================================================== */

.nissan-gtr-section__media {
  min-width: 0;

  min-height: 520px;

  position: relative;
}

.nissan-gtr-section__image-wrap {
  position: relative;

  width: 100%;
  height: 100%;

  min-height: 520px;

  overflow: hidden;

  background:
    #07182B;
}

.nissan-gtr-section__image-wrap::after {
  content: "";

  position: absolute;

  top: 22px;
  right: 22px;

  width: 54px;
  height: 54px;

  border-top:
    1px solid
    rgba(255,255,255,.7);

  border-right:
    1px solid
    rgba(255,255,255,.7);

  pointer-events: none;
}

.nissan-gtr-section__image-img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  object-position: center;

  transform:
    scale(1.02);

  filter:
    saturate(.82)
    contrast(1.06)
    brightness(.84);

  transition:
    transform .8s
      cubic-bezier(.22,.61,.36,1),
    filter .5s ease;
}

.nissan-gtr-section__media:hover
.nissan-gtr-section__image-img {
  transform:
    scale(1.07);

  filter:
    saturate(1)
    contrast(1.06)
    brightness(.94);
}

.nissan-gtr-section__image-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.12),
      rgba(0,0,0,.18)
    );

  opacity:
    var(--nissan-overlay);

  pointer-events: none;
}

.nissan-gtr-section__image-top,
.nissan-gtr-section__image-bottom {
  position: absolute;

  z-index: 3;

  left: 22px;
  right: 22px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  color: #ffffff;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.nissan-gtr-section__image-top {
  top: 22px;
}

.nissan-gtr-section__image-bottom {
  bottom: 22px;

  color:
    rgba(255,255,255,.72);

  padding-top: 14px;

  border-top:
    1px solid
    rgba(255,255,255,.16);
}

.nissan-gtr-section__image-top span:last-child {
  color:
    #ffffff;

  font-size:
    10px;
}


/* ==========================================================
   CONTENT
========================================================== */

.nissan-gtr-section__content {
  position: relative;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: flex-start;

  padding:
    54px 58px;

  background:
    var(--nissan-panel);

  border:
    1px solid
    var(--nissan-border);

  border-left:
    0;

  overflow: hidden;
}

.nissan-gtr-section__content::before {
  content: "";

  position: absolute;

  top: 0;
  right: 0;

  width: 120px;
  height: 120px;

  background:
    var(--nissan-accent);

  opacity: .08;

  clip-path:
    polygon(
      100% 0,
      0 0,
      100% 100%
    );
}

.nissan-gtr-section__content::after {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 3px;

  background:
    var(--nissan-accent);
}


/* ==========================================================
   KICKER
========================================================== */

.nissan-gtr-section__kicker {
  display: flex;

  align-items: center;

  gap: 10px;

  margin: 0 0 17px;

  color:
    var(--nissan-accent);

  font-size: 9px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .18em;

  text-transform: uppercase;
}

.nissan-gtr-section__kicker span {
  width: 26px;
  height: 1px;

  background:
    currentColor;
}


/* ==========================================================
   HEADING
========================================================== */

.nissan-gtr-section__heading {
  position: relative;

  z-index: 1;

  margin: 0;

  max-width: 510px;

  color:
    var(--nissan-text) !important;

  font-family:
    "Russo One",
    sans-serif !important;

  font-size:
    clamp(
      38px,
      4vw,
      64px
    );

  line-height: .94;

  font-weight: 400;

  letter-spacing: -.025em;

  text-transform: uppercase;
}

.nissan-gtr-section__accent-heading {
  position: relative;

  z-index: 1;

  margin-top: 7px;

  max-width: 520px;

  color:
    var(--nissan-accent);

  font-family:
    "Russo One",
    sans-serif !important;

  font-size:
    clamp(
      28px,
      3vw,
      46px
    );

  line-height: 1;

  font-weight: 400;

  letter-spacing: -.02em;

  text-transform: uppercase;
}


/* ==========================================================
   DESCRIPTION
========================================================== */

.nissan-gtr-section__description {
  position: relative;

  z-index: 1;

  max-width: 470px;

  margin-top: 22px;

  color:
    var(--nissan-muted);

  font-size: 13px;

  line-height: 1.8;
}

.nissan-gtr-section__description p {
  margin: 0;
}


/* ==========================================================
   STATS
========================================================== */

.nissan-gtr-section__stats {
  position: relative;

  z-index: 1;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0,1fr));

  width: 100%;

  max-width: 510px;

  margin-top: 30px;

  border-top:
    1px solid
    var(--nissan-border);

  border-bottom:
    1px solid
    var(--nissan-border);
}

.nissan-gtr-section__stat {
  padding:
    16px 14px 16px 0;

  border-right:
    1px solid
    var(--nissan-border);
}

.nissan-gtr-section__stat + .nissan-gtr-section__stat {
  padding-left:
    14px;
}

.nissan-gtr-section__stat:last-child {
  border-right:
    0;

  padding-right:
    0;
}

.nissan-gtr-section__stat strong {
  display: block;

  color:
    var(--nissan-text);

  font-size:
    clamp(
      20px,
      2vw,
      30px
    );

  line-height: 1;

  font-weight: 800;

  letter-spacing: -.04em;
}

.nissan-gtr-section__stat span {
  display: block;

  margin-top: 7px;

  color:
    var(--nissan-muted);

  font-size: 8px;

  line-height: 1.3;

  font-weight: 800;

  letter-spacing: .12em;

  text-transform: uppercase;
}


/* ==========================================================
   ACTIONS
========================================================== */

.nissan-gtr-section__actions {
  position: relative;

  z-index: 1;

  display: flex;

  align-items: center;

  gap: 13px;

  margin-top: 30px;
}

.nissan-gtr-section__button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 16px;

  min-height: 46px;

  min-width: 180px;

  padding:
    0 18px;

  border:
    1px solid
    var(--nissan-button);

  background:
    var(--nissan-button);

  color:
    var(--nissan-button-text);

  text-decoration: none;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .12em;

  text-transform: uppercase;

  transition:
    transform .25s ease,
    background .25s ease,
    color .25s ease;
}

.nissan-gtr-section__button b {
  font-size:
    16px;

  font-weight:
    400;

  transition:
    transform .25s ease;
}

.nissan-gtr-section__button:hover {
  transform:translateY(-3px);

  background-color:black;

  color:var(--nissan-button-text);
}

.nissan-gtr-section__button:hover b {
  transform:
    translate(
      3px,
      -3px
    );
}

.nissan-gtr-section__secondary {
  display: inline-flex;

  align-items: center;

  min-height: 46px;

  padding:
    0 16px;

  border:
    1px solid
    var(--nissan-border);

  color:
    var(--nissan-text);

  background:
    transparent;

  text-decoration: none;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .12em;

  text-transform: uppercase;

  transition:
    border-color .25s ease,
    color .25s ease,
    background .25s ease;
}

.nissan-gtr-section__secondary:hover {
  border-color:
    var(--nissan-accent);

  color:
    var(--nissan-accent);

  background:
    rgba(2,101,242,.04);
}


/* ==========================================================
   FOOTER LINE
========================================================== */

.nissan-gtr-section__footer-line {
  position: relative;

  z-index: 1;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  width: 100%;

  margin-top: 34px;

  padding-top: 15px;

  border-top:
    1px solid
    var(--nissan-border);

  color:
    var(--nissan-muted);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .12em;

  text-transform: uppercase;
}

.nissan-gtr-section__footer-line span:last-child {
  color:
    var(--nissan-accent);
}


/* ==========================================================
   REVEAL
========================================================== */

.nissan-reveal {
  opacity: 0;

  transform:
    translateY(24px);

  transition:
    opacity .75s ease,
    transform .75s
      cubic-bezier(.22,.61,.36,1);
}

.nissan-reveal.is-visible {
  opacity: 1;

  transform: none;
}


/* ==========================================================
   TABLET
========================================================== */

@media screen
and (max-width: 989px) {

  .nissan-gtr-section {
    padding:
      56px 0;
  }

  .nissan-gtr-section__container {
    grid-template-columns:
      1fr;

    width:
      calc(100% - 40px);
  }

  .nissan-gtr-section__media,
  .nissan-gtr-section__image-wrap {
    min-height:
      450px;
  }

  .nissan-gtr-section__content {
    border-left:
      1px solid
      var(--nissan-border);

    border-top:
      0;

    padding:
      45px;
  }
}


/* ==========================================================
   MOBILE
========================================================== */

@media screen
and (max-width: 749px) {

  .nissan-gtr-section {
    padding:
      42px 0
      48px;
  }

  .nissan-gtr-section__container {
    width:
      calc(100% - 28px);
  }

  .nissan-gtr-section__media,
  .nissan-gtr-section__image-wrap {
    min-height:
      330px;
  }

  .nissan-gtr-section__content {
    padding:
      34px 24px;
  }

  .nissan-gtr-section__heading {
    font-size:
      38px;
  }

  .nissan-gtr-section__accent-heading {
    font-size:
      29px;
  }

  .nissan-gtr-section__description {
    font-size:
      12px;
  }

  .nissan-gtr-section__stats {
    grid-template-columns:
      repeat(3,1fr);
  }

  .nissan-gtr-section__stat {
    padding:
      13px 8px 13px 0;
  }

  .nissan-gtr-section__stat + .nissan-gtr-section__stat {
    padding-left:
      8px;
  }

  .nissan-gtr-section__stat strong {
    font-size:
      18px;
  }

  .nissan-gtr-section__stat span {
    font-size:
      7px;
  }

  .nissan-gtr-section__actions {
    flex-direction:
      column;

    align-items:
      stretch;

    width:
      100%;
  }

  .nissan-gtr-section__button,
  .nissan-gtr-section__secondary {
    width:
      100%;
  }

  .nissan-gtr-section__footer-line {
    flex-direction:
      column;

    align-items:
      flex-start;

    margin-top:
      25px;
  }
}

{% endstylesheet %}


