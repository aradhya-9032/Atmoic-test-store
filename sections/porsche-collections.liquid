<section
  class="porsche-collections"
  style="
    --section-height: {{ section.settings.section_height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --accent-color: {{ section.settings.accent_color }};
    --content-width: {{ section.settings.content_width }}px;
    --card-height: {{ section.settings.card_height }}px;
    --card-gap: {{ section.settings.card_gap }}px;
  "
>
  {% if section.settings.background_image != blank %}
    <div class="porsche-collections__background">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '900,1200,1600,2000,2400',
          class: 'porsche-collections__background-image'
      }}
    </div>
  {% endif %}

  <div class="porsche-collections__base"></div>
  <div class="porsche-collections__overlay"></div>
  <div class="porsche-collections__grid-lines"></div>

  <div class="porsche-collections__content">

    {% if section.settings.heading != blank %}
      <div class="porsche-collections__header">

        <div class="porsche-collections__heading-wrap">

          {% if section.settings.kicker != blank %}
            <div class="porsche-collections__kicker">
              <span></span>
              {{ section.settings.kicker }}
            </div>
          {% endif %}

          <h2 class="porsche-collections__heading">
            {{ section.settings.heading }}
          </h2>

          {% if section.settings.accent_heading != blank %}
            <h3 class="porsche-collections__accent-heading">
              {{ section.settings.accent_heading }}
            </h3>
          {% endif %}

        </div>

        {% if section.settings.description != blank %}
          <div class="porsche-collections__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    <div class="porsche-collections__grid">

      {% for block in section.blocks %}

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="porsche-collections__card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="porsche-collections__card-media">

              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400,700,1000,1200',
                  class: 'porsche-collections__card-image'
              }}

            </div>
          {% endif %}

          <div class="porsche-collections__card-overlay"></div>

          <div class="porsche-collections__card-content">

            <div class="porsche-collections__card-top">

              <span class="porsche-collections__card-number">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

              {% if block.settings.label != blank %}
                <span class="porsche-collections__card-label">
                  {{ block.settings.label }}
                </span>
              {% endif %}

            </div>


            <div class="porsche-collections__card-bottom">

              <div class="porsche-collections__card-copy">

                <h3 class="porsche-collections__title">
                  {{ block.settings.title }}
                </h3>

                {% if block.settings.subtitle != blank %}
                  <p class="porsche-collections__subtitle">
                    {{ block.settings.subtitle }}
                  </p>
                {% endif %}

                <span class="porsche-collections__link">
                  {{ block.settings.link_text }}
                </span>

              </div>


              <span class="porsche-collections__arrow">
                ↗
              </span>

            </div>

          </div>

        </a>

      {% endfor %}

    </div>

  </div>
</section>


<script>
  (() => {
    const section = document.currentScript.previousElementSibling;

    if (!section) return;

    const cards = section.querySelectorAll(
      '.porsche-collections__card'
    );

    const observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (!entry.isIntersecting) return;

          cards.forEach((card, index) => {

            setTimeout(() => {
              card.classList.add('is-visible');
            }, index * 90);

          });

          observer.disconnect();

        });

      },
      {
        threshold: 0.12
      }
    );

    observer.observe(section);
  })();
</script>


{% stylesheet %}

/* ==========================================================
   APEX LAB — PORSCHE COLLECTIONS
========================================================== */

.porsche-collections {

  position: relative;

  width: 100%;

  min-height: var(--section-height);

  overflow: hidden;

  background: #000;

  color: #fff;
}


/* ==========================================================
   BACKGROUND IMAGE
========================================================== */

.porsche-collections__background {

  position: absolute;

  inset: 0;

  z-index: 0;

  overflow: hidden;
}


.porsche-collections__background-image {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  object-position: center;

  filter:
    saturate(.78)
    contrast(1.06);

  transform: scale(1.01);

  transition:
    transform 1.2s
    cubic-bezier(.22,.61,.36,1);
}


.porsche-collections:hover
.porsche-collections__background-image {

  transform:
    scale(1.035);
}


/* ==========================================================
   DARK BASE
========================================================== */

.porsche-collections__base {

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      135deg,
      #000 0%,
      #071329 50%,
      #000 100%
    );

  opacity: .42;
}


/* ==========================================================
   OVERLAY
========================================================== */

.porsche-collections__overlay {

  position: absolute;

  inset: 0;

  z-index: 2;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.92) 0%,
      rgba(0,0,0,.72) 33%,
      rgba(0,0,0,.24) 72%,
      rgba(0,0,0,.68) 100%
    );

  opacity:
    var(--overlay-opacity);
}


/* ==========================================================
   GRID LINES
========================================================== */

.porsche-collections__grid-lines {

  position: absolute;

  inset: 0;

  z-index: 2;

  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(255,255,255,.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.035) 1px,
      transparent 1px
    );

  background-size:
    52px 52px;

  mask-image:
    linear-gradient(
      to right,
      #000,
      transparent 92%
    );
}


/* ==========================================================
   MAIN CONTENT
========================================================== */

.porsche-collections__content {

  position: relative;

  z-index: 4;

  width:
    min(
      var(--content-width),
      calc(100% - 48px)
    );

  margin: 0 auto;

  padding:
    36px 0
    40px;

  box-sizing: border-box;
}


/* ==========================================================
   HEADER
========================================================== */

.porsche-collections__header {

  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(280px, .55fr);

  gap: 60px;

  align-items: end;

  margin-bottom: 18px;
}


.porsche-collections__heading-wrap {

  max-width: 800px;
}


/* ==========================================================
   KICKER
========================================================== */

.porsche-collections__kicker {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 17px;

  color:
    rgba(255,255,255,.62);

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .17em;

  text-transform: uppercase;
}


.porsche-collections__kicker span {

  width: 28px;

  height: 1px;

  background:
    var(--accent-color);
}


/* ==========================================================
   MAIN HEADING
========================================================== */

.porsche-collections__heading {

  margin: 0;

  font-family:
    "Russo One",
    sans-serif !important;

  color: #fff;

  font-size:
    clamp(
      32px,
      3.6vw,
      50px
    );

  line-height: .95;

  font-weight: 400;

  letter-spacing:
    -.025em;

  text-transform: uppercase;
}


.porsche-collections__accent-heading {

  margin:
    7px 0 0;

  font-family:
    "Russo One",
    sans-serif !important;

  font-size:
    clamp(
      23px,
      2.8vw,
      36px
    );

  line-height: 1;

  font-weight: 400;

  letter-spacing:
    -.02em;

  text-transform: uppercase;

  color:
    var(--accent-color);
}


/* ==========================================================
   DESCRIPTION
========================================================== */

.porsche-collections__description {

  max-width: 380px;

  justify-self: end;

  color:
    rgba(255,255,255,.67);

  font-size: 11px;

  line-height: 1.55;
}


/* ==========================================================
   CARD GRID
========================================================== */

.porsche-collections__grid {

  display: grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );

  gap:
    var(--card-gap);
}


/* ==========================================================
   CARD
========================================================== */

.porsche-collections__card {

  position: relative;

  display: block;

  overflow: hidden;

  color: #fff;

  text-decoration: none;

  border:
    1px solid
    rgba(255,255,255,.13);

  background:
    rgba(0,0,0,.22);

  backdrop-filter:
    blur(3px);

  transform:
    translateY(24px);

  opacity: 0;

  transition:
    transform .55s
      cubic-bezier(.22,.61,.36,1),

    opacity .7s ease,

    border-color .3s ease,

    box-shadow .4s ease;
}


.porsche-collections__card.is-visible {

  opacity: 1;

  transform:
    translateY(0);
}


.porsche-collections__card:hover {

  border-color:
    var(--accent-color);

  transform:
    translateY(-6px);

  box-shadow:
    0 22px 60px
    rgba(0,0,0,.42);
}


/* ==========================================================
   CARD IMAGE
========================================================== */

.porsche-collections__card-media {

  position: absolute;

  inset: 0;

  overflow: hidden;
}


.porsche-collections__card-image {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  filter:
    saturate(.75)
    brightness(.7);

  transform:
    scale(1.015);

  transition:
    transform .65s
      cubic-bezier(.22,.61,.36,1),

    filter .45s ease;
}


.porsche-collections__card:hover
.porsche-collections__card-image {

  transform:
    scale(1.07);

  filter:
    saturate(.95)
    brightness(.82);
}


/* ==========================================================
   CARD GRADIENT
========================================================== */

.porsche-collections__card-overlay {

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.94),
      rgba(0,0,0,.36) 57%,
      rgba(0,0,0,.12)
    );
}


/* ==========================================================
   CARD CONTENT
========================================================== */

.porsche-collections__card-content {

  position: relative;

  z-index: 2;

  width: 100%;

  height: 100%;

  min-height:
    190px !important;

  padding: 14px;

  box-sizing: border-box;

  display: flex;

  flex-direction: column;

  justify-content: space-between;
}


/* ==========================================================
   CARD TOP
========================================================== */

.porsche-collections__card-top {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 12px;
}


.porsche-collections__card-number {

  color:
    var(--accent-color);

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .14em;
}


.porsche-collections__card-label {

  padding:
    7px 9px;

  border:
    1px solid
    rgba(255,255,255,.18);

  background:
    rgba(0,0,0,.25);

  color:
    rgba(255,255,255,.7);

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .13em;

  text-transform: uppercase;
}


/* ==========================================================
   CARD BOTTOM
========================================================== */

.porsche-collections__card-bottom {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 18px;
}


.porsche-collections__title {

  margin: 0;

  font-size: 16px;

  line-height: 1.05;

  font-weight: 700;

  letter-spacing:
    -.015em;

  text-transform: uppercase;
}


.porsche-collections__subtitle {

  margin:
    5px 0 8px;

  color:
    rgba(255,255,255,.55);

  font-size: 9px;

  line-height: 1;

  letter-spacing: .14em;

  text-transform: uppercase;
}


.porsche-collections__link {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  color:
    #fff;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .13em;

  text-transform: uppercase;

  transition:
    color .25s ease;
}


.porsche-collections__card:hover
.porsche-collections__link {

  color:
    var(--accent-color);
}


/* ==========================================================
   ARROW
========================================================== */

.porsche-collections__arrow {

  flex: 0 0 auto;

  width: 34px;

  height: 34px;

  display: grid;

  place-items: center;

  background:
    var(--accent-color);

  color: #fff;

  font-size: 16px;

  transition:
    transform .3s ease,

    background .3s ease;
}


.porsche-collections__card:hover
.porsche-collections__arrow {

  transform:
    translate(
      3px,
      -3px
    );

  background:
    #0343C0;
}


/* ==========================================================
   TABLET
========================================================== */

@media screen
and (max-width: 989px) {

  .porsche-collections__content {

    width:
      calc(100% - 56px);

    padding:
      65px 0
      70px;
  }


  .porsche-collections__header {

    grid-template-columns: 1fr;

    gap: 20px;

    margin-bottom: 32px;
  }


  .porsche-collections__description {

    justify-self:
      start;

    max-width:
      550px;
  }


  .porsche-collections__grid {

    grid-template-columns:
      repeat(2, minmax(0,1fr));
  }


  .porsche-collections__card {

    min-height:
      210px !important;
  }


  .porsche-collections__card-content {

    min-height:
      210px !important;
  }
}


/* ==========================================================
   MOBILE
========================================================== */

@media screen
and (max-width: 749px) {

  .porsche-collections {

    min-height:
      auto;
  }


  .porsche-collections__content {

    width:
      calc(100% - 28px);

    padding:
      42px 0
      48px;
  }


  .porsche-collections__header {

    margin-bottom:
      28px;
  }


  .porsche-collections__heading {

    font-size:
      34px;
  }


  .porsche-collections__accent-heading {

    font-size:
      27px;
  }


  .porsche-collections__description {

    font-size:
      13px;
  }


  .porsche-collections__grid {

    grid-template-columns:
      1fr;

    gap:
      11px;
  }


  .porsche-collections__card {

    min-height:
      230px !important;
  }


  .porsche-collections__card-content {

    min-height:
      230px !important;
  }


  .porsche-collections__title {

    font-size:
      19px;
  }

}

{% endstylesheet %}


