<section
  class="nissan-gtr-section"
  style="
    --nissan-bg: {{ section.settings.background_color }};
    --nissan-text: {{ section.settings.text_color }};
    --nissan-button: {{ section.settings.button_color }};
    --nissan-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="nissan-gtr-section__container">

    <!-- LEFT IMAGE -->
    <div class="nissan-gtr-section__image">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'nissan-gtr-section__image-img'
        }}
      {% endif %}
    </div>

    <!-- RIGHT CONTENT -->
    <div class="nissan-gtr-section__content">

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="nissan-gtr-section__button"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>
</section>


{% stylesheet %}

.nissan-gtr-section {
  width: 100%;
  background: var(--nissan-bg);
  padding: 30px 0;
  box-sizing: border-box;
}

.nissan-gtr-section__container {
  width: 100%;
  max-width: 950px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 1fr;

  align-items: center;

  gap: 70px;
}


/* =========================
   LEFT IMAGE
   ========================= */

.nissan-gtr-section__image {
  width: 100%;
  height: 448px;
  overflow: hidden;
}

.nissan-gtr-section__image-img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* =========================
   RIGHT CONTENT
   ========================= */

.nissan-gtr-section__content {
  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 20px;
}

.nissan-gtr-section__content h2 {
  margin: 0 0 25px;

  max-width: 360px;

  color: var(--nissan-text);

  font-size: 25px;
  line-height: 1.15;
  font-family:"Russo One", san serif;
  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .3px;
}


/* =========================
   BUTTON
   ========================= */

.nissan-gtr-section__button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 168px;
  min-height: 40px;

  padding: 12px 25px;

  background: var(--nissan-button);
  color: var(--nissan-button-text);

  text-decoration: none;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;

  transition:
    background .2s ease,
    transform .2s ease;
}

.nissan-gtr-section__button:hover {
  transform: translateY(-2px);

  opacity: .9;
}


/* =========================
   MOBILE
   ========================= */

@media screen and (max-width: 749px) {

  .nissan-gtr-section {
    padding: 25px 20px;
  }

  .nissan-gtr-section__container {
    grid-template-columns: 1fr;

    gap: 30px;

    max-width: 600px;
  }

  .nissan-gtr-section__image {
    height: 380px;
  }

  .nissan-gtr-section__content {
    padding: 10px;
  }

  .nissan-gtr-section__content h2 {
    font-size: 24px;
  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Nissan GT-R Collection",

  "tag": "section",

  "class": "nissan-gtr-collection",

  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Nissan GT-R image"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection for Nissan GT-R R35"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop the collection"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#07182b"
    },

    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#e3261b"
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }

  ],

  "presets": [
    {
      "name": "Nissan GT-R Collection"
    }
  ]

}

{% endschema %}