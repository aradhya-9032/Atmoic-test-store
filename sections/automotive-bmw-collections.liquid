{% liquid
  assign heading = section.settings.heading
%}

<section
  class="automotive-bmw"
  style="
    --bmw-card-height: {{ section.settings.card_height }}px;
    --bmw-mobile-card-height: {{ section.settings.mobile_card_height }}px;
    --bmw-heading-size: {{ section.settings.heading_size }}px;
    --bmw-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --bmw-hover-scale: {{ section.settings.hover_scale }};
  "
>

  {% if heading != blank %}
    <div class="automotive-bmw__heading-wrapper">
      <h2 class="automotive-bmw__heading">
        {{ heading }}
      </h2>
    </div>
  {% endif %}

  <div class="automotive-bmw__grid">

    {% for block in section.blocks %}

      {% assign collection = block.settings.collection %}

      {% if collection != blank %}

        <a
          href="{{ collection.url }}"
          class="automotive-bmw__card"
          {{ block.shopify_attributes }}
        >

          <div class="automotive-bmw__image-wrapper">

            {% if collection.featured_image != blank %}

              {{
                collection.featured_image
                | image_url: width: 1400
                | image_tag:
                  class: 'automotive-bmw__image',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(min-width: 1000px) 25vw, 50vw',
                  alt: collection.title
              }}

            {% else %}

              {{ 'collection-1' | placeholder_svg_tag: 'automotive-bmw__placeholder' }}

            {% endif %}

            <div class="automotive-bmw__dark"></div>

          </div>


          <div class="automotive-bmw__content">

            <span class="automotive-bmw__red-square"></span>

            <h3 class="automotive-bmw__title">
              {{ collection.title }}
            </h3>

          </div>

        </a>

      {% endif %}

    {% endfor %}

  </div>

</section>


{% stylesheet %}

/* =========================================================
   AUTOMOTIVE BMW COLLECTION SECTION
   ========================================================= */

.automotive-bmw {
  width: 100%;
  margin: 0;
  padding: 0;
  background: #ffffff;
  overflow: hidden;
}


/* =========================================================
   HEADING
   ========================================================= */

.automotive-bmw__heading-wrapper {
  width: 100%;
  padding: 30px 20px 34px;
  background: #ffffff;
  font-family:"Russo One", san serif;
  display: flex;
  align-items: center;
  justify-content: center;
}

.automotive-bmw__heading {
  margin: 0;
  font-family:"Russo One", san serif;
  color: #050505;
  font-size: var(--bmw-heading-size);
  line-height: 1;
  font-weight: 800;

  text-align: center;
  text-transform: uppercase;

  letter-spacing: 0;

  /* Reference website heading style */
  -webkit-font-smoothing: antialiased;
}


/* =========================================================
   GRID
   ========================================================= */

.automotive-bmw__grid {
  width: 100%;

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 0;
}


/* =========================================================
   CARD
   ========================================================= */

.automotive-bmw__card {
  position: relative;

  width: 100%;
  height: var(--bmw-card-height);

  display: block;

  overflow: hidden;

  background: #111111;

  color: #ffffff;
  text-decoration: none;

  isolation: isolate;
}


/* =========================================================
   IMAGE WRAPPER
   ========================================================= */

.automotive-bmw__image-wrapper {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


/* =========================================================
   IMAGE
   ========================================================= */

.automotive-bmw__image {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transform: scale(1);

  transform-origin: center center;

  filter: brightness(0.78);

  transition:
    transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.45s ease;
}


/* =========================================================
   DARK OVERLAY
   ========================================================= */

.automotive-bmw__dark {
  position: absolute;
  inset: 0;

  z-index: 1;

  background:
    rgba(0, 0, 0, var(--bmw-overlay));

  pointer-events: none;

  transition:
    background 0.4s ease;
}


/* =========================================================
   CONTENT
   ========================================================= */

.automotive-bmw__content {
  position: absolute;

  left: 22px;
  bottom: 20px;

  right: 15px;

  z-index: 3;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  pointer-events: none;
}


/* =========================================================
   RED SQUARE
   ========================================================= */

.automotive-bmw__red-square {
  width: 13px;
  height: 13px;

  display: block;

  margin-bottom: 8px;

  flex-shrink: 0;

  background: #ff2026;
}


/* =========================================================
   TITLE
   ========================================================= */

.automotive-bmw__title {
  margin: 0;

  color: #ffffff;

  font-family:
    var(--font-heading--family),
    Arial,
    Helvetica,
    sans-serif;

  font-size: 21px;
  line-height: 1.1;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 0;

  text-shadow:
    0 2px 4px rgba(0, 0, 0, 0.55);
}


/* =========================================================
   HOVER
   ========================================================= */

/*
  VERY IMPORTANT:

  Only the image is scaled.

  The card does NOT scale.
  The text does NOT move.
  The red square does NOT move.
*/

.automotive-bmw__card:hover .automotive-bmw__image {
  transform: scale(var(--bmw-hover-scale));

  filter: brightness(0.95);
}


/* Make image slightly brighter on hover */

.automotive-bmw__card:hover .automotive-bmw__dark {
  background: rgba(0, 0, 0, 0.05);
}


/* =========================================================
   CARD FOCUS
   ========================================================= */

.automotive-bmw__card:focus-visible {
  outline: 3px solid #ff2026;
  outline-offset: -3px;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 999px) {

  .automotive-bmw__grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .automotive-bmw__card {
    height: 300px;
  }

  .automotive-bmw__title {
    font-size: 19px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .automotive-bmw__heading-wrapper {
    padding: 25px 15px 28px;
  }

  .automotive-bmw__heading {
    font-size: 28px;
  }

  .automotive-bmw__grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .automotive-bmw__card {
    height: var(--bmw-mobile-card-height);
  }

  .automotive-bmw__content {
    left: 13px;
    bottom: 13px;
    right: 10px;
  }

  .automotive-bmw__red-square {
    width: 10px;
    height: 10px;

    margin-bottom: 6px;
  }

  .automotive-bmw__title {
    font-size: 15px;
    line-height: 1.08;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 480px) {

  .automotive-bmw__heading {
    font-size: 24px;
  }

  .automotive-bmw__card {
    height: 180px;
  }

  .automotive-bmw__content {
    left: 10px;
    bottom: 10px;
  }

  .automotive-bmw__title {
    font-size: 13px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .automotive-bmw__image,
  .automotive-bmw__dark {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "BMW Collections",
  "tag": "section",
  "class": "automotive-bmw-section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection for BMW"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },

    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop card height",
      "min": 200,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 315
    },

    {
      "type": "range",
      "id": "mobile_card_height",
      "label": "Mobile card height",
      "min": 150,
      "max": 350,
      "step": 5,
      "unit": "px",
      "default": 210
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image darkness",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 15
    },

    {
    "type": "range",
    "id": "hover_scale",
    "label": "Hover image zoom",
    "min": 1,
    "max": 1.2,
    "step": 0.1,
    "default": 1.1
    }

  ],

  "blocks": [

    {
      "type": "collection",
      "name": "BMW Collection",

      "settings": [

        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }

      ]
    }

  ],

  "max_blocks": 8,

  "presets": [

    {
      "name": "BMW Collections",

      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }

  ]

}
{% endschema %}