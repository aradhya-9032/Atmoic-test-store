{% liquid
  assign slide_count = section.blocks.size
  assign hero_image = blank

  for block in section.blocks
    if block.settings.image != blank
      assign hero_image = block.settings.image
      break
    endif
  endfor
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }
{% endstyle %}


<section
  id="AutomotiveHero-{{ section.id }}"
  class="automotive-hero automotive-hero--{{ section.settings.image_fit }}"
  style="
    --hero-height: {{ section.settings.height }}px;
    --hero-image-ratio: {% if hero_image != blank %}{{ hero_image.aspect_ratio }}{% else %}2.4{% endif %};
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    --hero-radius: {{ section.settings.border_radius }}px;
    --hero-horizontal-space: {{ section.settings.horizontal_spacing }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg: {{ section.settings.section_background }};
    --slide-duration: {{ section.settings.autoplay_speed }}s;
    --arrow-size: {{ section.settings.arrow_size }}px;
    --dot-gap: {{ section.settings.dot_gap }}px;
    --dot-size: {{ section.settings.dot_size }}px;
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};
    --arrow-bg: {{ section.settings.arrow_background }};
    --arrow-color: {{ section.settings.arrow_color }};
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="automotive-hero__slider">
    {% for block in section.blocks %}
      <div
        class="automotive-hero__slide{% if forloop.first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          <div class="automotive-hero__image automotive-hero__image--{{ section.settings.image_fit }}">
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag:
                widths: '750, 1200, 1600, 1920, 2560, 3840',
                sizes: '100vw',
                loading: 'eager',
                alt: block.settings.image.alt
            }}
          </div>
        {% else %}
          <div class="automotive-hero__image automotive-hero__image--placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.overlay %}
          <div
            class="automotive-hero__overlay"
            style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>
        {% endif %}

        {% assign has_content = false %}
        {% if block.settings.logo != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
          {% assign has_content = true %}
        {% endif %}

        {% if has_content %}
          <div class="automotive-hero__content automotive-hero__content--{{ block.settings.content_position }}">
            {% if block.settings.logo != blank %}
              {{
                block.settings.logo
                | image_url: width: 700
                | image_tag:
                  class: 'automotive-hero__logo',
                  widths: '250, 400, 550, 700',
                  sizes: '(max-width: 749px) 60vw, 35vw',
                  alt: block.settings.logo.alt
              }}
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="automotive-hero__text">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a
                href="{{ block.settings.button_link | default: '#' }}"
                class="automotive-hero__button"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if slide_count > 1 and section.settings.show_arrows %}
    <button
      type="button"
      class="automotive-hero__arrow automotive-hero__arrow--prev"
      aria-label="Previous slide"
    >
      <span aria-hidden="true">‹</span>
    </button>

    <button
      type="button"
      class="automotive-hero__arrow automotive-hero__arrow--next"
      aria-label="Next slide"
    >
      <span aria-hidden="true">›</span>
    </button>
  {% endif %}

  {% if slide_count > 1 and section.settings.show_dots %}
    <div class="automotive-hero__dots" role="tablist" aria-label="Hero slides">
      {% for block in section.blocks %}
        <button
          type="button"
          class="automotive-hero__dot{% if forloop.first %} is-active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
.automotive-hero-wrapper {
  display: block;
  width: 100%;
  margin: 0;
  background: transparent;
}

.automotive-hero {
  position: relative;
  display: block;
  width: calc(100% - (var(--hero-horizontal-space) * 2));
  max-width: none;
  height: var(--hero-height);
  min-height: 0;
  margin: var(--section-padding-top) auto var(--section-padding-bottom);
  padding: 0;
  overflow: hidden;
  border-radius: var(--hero-radius);
  background: var(--section-bg);
  isolation: isolate;
  line-height: 0;
}

/* When "Show full image" is selected, use the real slide image ratio.
   This removes the empty top/bottom bars caused by object-fit: contain
   inside a fixed-height slider. */
.automotive-hero--contain {
  height: auto;
  aspect-ratio: var(--hero-image-ratio);
}

/* Fill mode keeps the editor-controlled fixed hero height. */
.automotive-hero--cover {
  height: var(--hero-height);
}

.automotive-hero__slider {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  border-radius: inherit;
}

.automotive-hero__slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .55s ease, visibility .55s ease;
}

.automotive-hero__slide.is-active {
  position: absolute;
  inset: 0;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  z-index: 2;
}

.automotive-hero__image,
.automotive-hero__image img,
.automotive-hero__image svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.automotive-hero__image {
  overflow: hidden;
  border-radius: inherit;
  background: transparent;
}

.automotive-hero__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-position: center;
  border-radius: inherit;
}

/* Show the complete image without cropping */
.automotive-hero__image--contain img {
  object-fit: contain;
  transform: none;
}

/* Fill the complete hero area */
.automotive-hero__image--cover img {
  object-fit: cover;
  transform: scale(1.001);
}

.automotive-hero__image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.automotive-hero__image--placeholder svg {
  position: static;
  width: 100%;
  height: 100%;
}

.automotive-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: #000;
  opacity: var(--overlay-opacity);
  pointer-events: none;
}

.automotive-hero__content {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
  padding: clamp(28px, 4vw, 70px);
  pointer-events: none;
}

.automotive-hero__content > * {
  pointer-events: auto;
}

.automotive-hero__content--left {
  align-items: flex-start;
  text-align: left;
}

.automotive-hero__content--center {
  align-items: center;
  text-align: center;
}

.automotive-hero__content--right {
  align-items: flex-end;
  text-align: right;
}

.automotive-hero__logo {
  width: min(360px, 70vw);
  height: auto;
  max-height: 180px;
  object-fit: contain;
}

.automotive-hero__content h2 {
  max-width: 700px;
  margin: 0;
  color: #fff;
  font-size: clamp(30px, 4vw, 60px);
  line-height: 1.05;
  letter-spacing: -.03em;
}

.automotive-hero__text {
  max-width: 620px;
  color: rgba(255, 255, 255, .88);
  font-size: 18px;
  line-height: 1.6;
}

.automotive-hero__text p {
  margin: 0;
}

.automotive-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 26px;
  border: 1px solid #fff;
  border-radius: 999px;
  background: var(--arrow-bg);
  color: #111;
  text-decoration: none;
  font-weight: 700;
  transition: transform .2s ease, background .2s ease;
}

.automotive-hero__button:hover {
  transform: translateY(-1px);
}

.automotive-hero__arrow {
  position: absolute;
  top: 50%;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--arrow-size);
  height: var(--arrow-size);
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--arrow-bg);
  color: var(--arrow-color);
  box-shadow: 0 8px 24px rgba(0, 0, 0, .16);
  cursor: pointer;
  transform: translateY(-50%);
  transition: transform .2s ease, opacity .2s ease;
}

.automotive-hero__arrow:hover {
  transform: translateY(-50%) scale(1.06);
}

.automotive-hero__arrow span {
  display: block;
  margin-top: -2px;
  font-size: 30px;
  line-height: 1;
  font-family: Arial, sans-serif;
}

.automotive-hero__arrow--prev {
  left: clamp(14px, 2.5vw, 34px);
}

.automotive-hero__arrow--next {
  right: clamp(14px, 2.5vw, 34px);
}

.automotive-hero__dots {
  position: absolute;
  bottom: 18px;
  left: 50%;
  z-index: 20;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: var(--dot-gap);
  width: auto;
  transform: translateX(-50%);
  pointer-events: auto;
}

.automotive-hero__dot {
  display: block !important;
  position: relative;
  flex: 0 0 auto;
  width: var(--dot-size);
  height: var(--dot-size);
  min-width: var(--dot-size);
  min-height: var(--dot-size);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: var(--dot-color);
  box-shadow: 0 1px 4px rgba(0, 0, 0, .35);
  overflow: hidden;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  transition: width .25s ease, background .25s ease;
}

.automotive-hero__dot.is-active {
  width: 30px;
  min-width: 30px;
  background: var(--dot-active-color);
}

.automotive-hero__dot::after {
  content: '';
  position: absolute;
  inset: 0;
  width: 0;
  background: rgba(255, 255, 255, .45);
}

.automotive-hero__dot.is-active::after {
  animation: heroProgress var(--slide-duration) linear forwards;
}

@keyframes heroProgress {
  from { width: 0; }
  to { width: 100%; }
}

@media screen and (max-width: 749px) {
  .automotive-hero {
    width: calc(100% - (var(--hero-horizontal-space) * 2));
    height: var(--hero-mobile-height);
    margin: var(--section-padding-top) auto var(--section-padding-bottom);
    border-radius: max(14px, calc(var(--hero-radius) * .7));
  }

  .automotive-hero--contain {
    height: auto;
    aspect-ratio: var(--hero-image-ratio);
  }

  .automotive-hero__content {
    padding: 28px 22px 54px;
  }

  .automotive-hero__content h2 {
    font-size: 32px;
  }

  .automotive-hero__text {
    font-size: 16px;
  }

  .automotive-hero__arrow {
    width: calc(var(--arrow-size) * .82);
    height: calc(var(--arrow-size) * .82);
  }

  .automotive-hero__arrow span {
    font-size: 25px;
  }

  .automotive-hero__dots {
    bottom: 14px;
  }
}
{% endstylesheet %}

<script>
  (() => {
    const init = (section) => {
      if (!section || section.dataset.initialized === 'true') return;

      const slides = [...section.querySelectorAll('.automotive-hero__slide')];
      const dots = [...section.querySelectorAll('.automotive-hero__dot')];
      const prev = section.querySelector('.automotive-hero__arrow--prev');
      const next = section.querySelector('.automotive-hero__arrow--next');

      if (slides.length <= 1) return;

      section.dataset.initialized = 'true';

      let current = 0;
      let timer;

      const show = (index) => {
        current = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
        });

        dots.forEach((dot, i) => {
          dot.classList.remove('is-active');
          dot.setAttribute('aria-selected', i === current ? 'true' : 'false');

          if (i === current) {
            void dot.offsetWidth;
            dot.classList.add('is-active');
          }
        });
      };

      const start = () => {
        clearInterval(timer);

        if (section.dataset.autoplay === 'true') {
          timer = setInterval(
            () => show(current + 1),
            Number(section.dataset.speed) || 5000
          );
        }
      };

      prev?.addEventListener('click', () => {
        show(current - 1);
        start();
      });

      next?.addEventListener('click', () => {
        show(current + 1);
        start();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      section.addEventListener('mouseenter', () => clearInterval(timer));
      section.addEventListener('mouseleave', start);

      start();
    };

    const run = () => {
      document.querySelectorAll('.automotive-hero').forEach(init);
    };

    run();
    document.addEventListener('shopify:section:load', run);
  })();
</script>

{% schema %}
{
  "name": "Automotive Hero Slider",
  "tag": "section",
  "class": "automotive-hero-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image display",
      "options": [
        {
          "value": "contain",
          "label": "Show full image"
