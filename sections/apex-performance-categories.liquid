</style>

<script>
(function() {
  const section = document.getElementById('ApexCatalog-{{ section.id }}');
  if (!section) return;

  const products = Array.from(section.querySelectorAll('.apex-catalog-product'));
  const count = section.querySelector('#ApexVisibleCount-{{ section.id }}');
  const noResults = section.querySelector('#ApexNoResults-{{ section.id }}');
  const title = section.querySelector('#ApexCatalogTitle-{{ section.id }}');
  const defaultHeading = {{ section.settings.heading | json }};

  const categoryButtons = Array.from(section.querySelectorAll('.apex-category-toggle'));
  const categoryContent = section.querySelector('[data-apex-category-content]');
  const filterItems = Array.from(section.querySelectorAll('.apex-filter-item[data-filter-key]'));
  const triggers = Array.from(section.querySelectorAll('.apex-filter-trigger'));

  function closeAllFilters() {
    filterItems.forEach(function(item) {
      item.classList.remove('is-open', 'is-active');
      const trigger = item.querySelector('.apex-filter-trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
  }

 function setCategory(button, allowCollapse) {
  if (!button || !categoryContent) return;

  const alreadyActive = button.classList.contains('is-active');
  const isCollapsed = categoryContent.classList.contains('is-collapsed');

  /* =========================================
     SAME CATEGORY CLICK = CLOSE SUBCATEGORIES
  ========================================= */

  if (allowCollapse && alreadyActive && !isCollapsed) {
    closeAllFilters();

    categoryContent.classList.add('is-collapsed');

    button.setAttribute('aria-expanded', 'false');

    return;
  }


  /* =========================================
     ACTIVE CATEGORY
  ========================================= */

  categoryButtons.forEach(function(item) {
    const isCurrentCategory = item === button;

    item.classList.toggle(
      'is-active',
      isCurrentCategory
    );

    item.setAttribute(
      'aria-expanded',
      isCurrentCategory ? 'true' : 'false'
    );
  });


  /* =========================================
     MOVE SUBCATEGORIES DIRECTLY BELOW
     THE ACTIVE CATEGORY
  ========================================= */

  button.insertAdjacentElement(
    'afterend',
    categoryContent
  );


  /* =========================================
     OPEN CATEGORY CONTENT
  ========================================= */

  categoryContent.classList.remove(
    'is-collapsed'
  );


  /* =========================================
     CLOSE OPEN FILTER POPUPS
  ========================================= */

  closeAllFilters();


  /* =========================================
     GET FILTERS FOR CURRENT CATEGORY
  ========================================= */

  const keys = String(
    button.dataset.categoryFilters || ''
  )
    .split(',')
    .map(function(key) {
      return key.trim().toLowerCase();
    })
    .filter(Boolean);


  /* =========================================
     SHOW ONLY CURRENT CATEGORY FILTERS
  ========================================= */

  filterItems.forEach(function(item) {

    const key = String(
      item.dataset.filterKey || ''
    ).toLowerCase();


    const isCustomFilter =
      key.indexOf('custom-') === 0;


    if (isCustomFilter) {

      item.hidden = false;

    } else {

      item.hidden =
        keys.length
          ? !keys.includes(key)
          : false;

    }

  });


  /* =========================================
     CHANGE PAGE TITLE
  ========================================= */

  if (title) {

    title.textContent =
      button.dataset.categoryTitle ||
      defaultHeading;

  }

}

  categoryButtons.forEach(function(button) {
    button.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();
      setCategory(button, true);
    });
  });

  const firstCategory = categoryButtons.find(function(button) {
    return button.classList.contains('is-active');
  }) || categoryButtons[0];

  if (firstCategory) setCategory(firstCategory, false);

  triggers.forEach(function(trigger) {
    trigger.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();

      const currentItem = trigger.closest('.apex-filter-item');
      if (!currentItem || currentItem.hidden) return;

      const isOpen = currentItem.classList.contains('is-open');
      closeAllFilters();

      if (!isOpen) {
        currentItem.classList.add('is-open', 'is-active');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', function(event) {
    if (!section.contains(event.target)) return;
    if (event.target.closest('.apex-filter-popup, .apex-filter-trigger, .apex-category-toggle')) return;
    closeAllFilters();
  });

  /* =========================================
     PRODUCT FILTERING
  ========================================= */

  function normalize(value) {

    return String(value || '')
      .trim()
      .toLowerCase();

  }


  function getSelectedGroups() {

    const selectedGroups = {};


    section.querySelectorAll(
      '.apex-filter-checkbox:checked'
    ).forEach(function(input) {

      const group = input.dataset.filterGroup;

      const value = normalize(
        input.value
      );


      if (!group) return;


      if (!selectedGroups[group]) {

        selectedGroups[group] = [];

      }


      selectedGroups[group].push(value);

    });


    return selectedGroups;

  }


  function filterProducts() {

    const selectedGroups =
      getSelectedGroups();


    const selectedPrices = Array.from(
      section.querySelectorAll(
        '.apex-price-filter:checked'
      )
    );


    let visibleCount = 0;


    products.forEach(function(product) {

      const productType = normalize(
        product.dataset.type
      );

      const productVendor = normalize(
        product.dataset.vendor
      );


      const productTags = String(
        product.dataset.tags || ''
      )
        .split('||')
        .map(normalize)
        .filter(Boolean);


      const price = parseInt(
        product.dataset.price || '0',
        10
      );


      let show = true;


      /* =========================
         FILTER GROUPS
      ========================= */

      Object.keys(selectedGroups).forEach(
        function(group) {

          if (!show) return;


          const selectedValues =
            selectedGroups[group];


          let match = false;


          /* TYPE */

          if (group === 'type') {

            match =
              selectedValues.includes(
                productType
              );

          }


          /* BRAND */

          else if (group === 'vendor') {

            match =
              selectedValues.includes(
                productVendor
              );

          }


          /*
            SIZE
            MATERIAL
            SUSPENSION
            ENGINE
            EXHAUST
            WHEELS
            CUSTOM TAG FILTERS
          */

          else {

            match = selectedValues.some(
              function(value) {

                return productTags.includes(
                  value
                );

              }
            );

          }


          if (!match) {

            show = false;

          }

        }
      );


      /* =========================
         PRICE FILTER
      ========================= */

      if (
        show &&
        selectedPrices.length
      ) {

        const priceMatch =
          selectedPrices.some(
            function(filter) {

              const min = parseInt(
                filter.dataset.min || '0',
                10
              );

              const max = parseInt(
                filter.dataset.max ||
                '999999999999',
                10
              );


              return (
                price >= min &&
                price <= max
              );

            }
          );


        if (!priceMatch) {

          show = false;

        }

      }


      /* =========================
         SHOW / HIDE PRODUCT
      ========================= */

      product.style.display =
        show ? '' : 'none';


      if (show) {

        visibleCount++;

      }

    });


    /* UPDATE COUNT */

    if (count) {

      count.textContent =
        visibleCount;

    }


    /* NO RESULTS */

    if (noResults) {

      noResults.hidden =
        visibleCount !== 0;

    }

  }


  /* =========================================
     FILTER CHECKBOX EVENTS
  ========================================= */

  section.querySelectorAll(
    '.apex-filter-checkbox, .apex-price-filter'
  ).forEach(function(input) {

    input.addEventListener(
      'change',
      filterProducts
    );

  });


  /* =========================================
     CLEAR FILTERS
  ========================================= */

  const clearButton = section.querySelector(
    '#ApexClearFilters-{{ section.id }}'
  );


  if (clearButton) {

    clearButton.addEventListener(
      'click',
      function() {

        section.querySelectorAll(
          '.apex-filter-checkbox, .apex-price-filter'
        ).forEach(function(input) {

          input.checked = false;

        });


        closeAllFilters();


        filterProducts();

      }
    );

  }


  /* =========================================
     SORT
  ========================================= */

  const sortSelect = section.querySelector(
    '#ApexCatalogSort-{{ section.id }}'
  );


  const grid = section.querySelector(
    '#ApexProductGrid-{{ section.id }}'
  );


  if (sortSelect && grid) {

    sortSelect.addEventListener(
      'change',
      function() {

        const items = Array.from(
          grid.querySelectorAll(
            '.apex-catalog-product'
          )
        );


        const value =
          sortSelect.value;


        if (value === 'featured') {

          return;

        }


        items.sort(
          function(a, b) {

            const titleA = normalize(
              a.dataset.title
            );

            const titleB = normalize(
              b.dataset.title
            );


            const priceA = parseInt(
              a.dataset.price || '0',
              10
            );

            const priceB = parseInt(
              b.dataset.price || '0',
              10
            );


            if (
              value === 'title-ascending'
            ) {

              return titleA.localeCompare(
                titleB
              );

            }


            if (
              value === 'title-descending'
            ) {

              return titleB.localeCompare(
                titleA
              );

            }


            if (
              value === 'price-ascending'
            ) {

              return priceA - priceB;

            }


            if (
              value === 'price-descending'
            ) {

              return priceB - priceA;

            }


            return 0;

          }
        );


        items.forEach(function(item) {

          grid.appendChild(item);

        });

      }
    );

  }


  /* =========================================
     WISHLIST COMPATIBILITY
     The global header wishlist owns add/remove logic.
     It uses: apex_lab_wishlist_v1
  ========================================= */

  function syncWishlistButtons() {
    let items = [];

    try {
      const saved = JSON.parse(
        localStorage.getItem('apex_lab_wishlist_v1')
      );

      items = Array.isArray(saved) ? saved : [];
    } catch (error) {
      items = [];
    }

    const savedIds = new Set(
      items.map(function(item) {
        return item && item.id;
      })
    );

    section.querySelectorAll('.apc-card__wish').forEach(function(button) {
      const card = button.closest('.apc-card');
      const link = card
        ? card.querySelector('.apc-card__title')
        : null;

      if (!link || !link.href) return;

      let id = '';

      try {
        id = new URL(
          link.href,
          window.location.origin
        ).pathname;
      } catch (error) {
        return;
      }

      const isAdded = savedIds.has(id);

      button.classList.toggle('is-added', isAdded);
      button.classList.toggle('is-active', isAdded);
      button.setAttribute(
        'aria-pressed',
        isAdded ? 'true' : 'false'
      );
      button.setAttribute(
        'aria-label',
        isAdded
          ? 'Remove from wishlist'
          : 'Add to wishlist'
      );
    });
  }

  window.addEventListener(
    'apex:wishlist:change',
    syncWishlistButtons
  );

  window.addEventListener(
    'storage',
    function(event) {
      if (event.key === 'apex_lab_wishlist_v1') {
        syncWishlistButtons();
      }
    }
  );

  syncWishlistButtons();
})();
</script>

