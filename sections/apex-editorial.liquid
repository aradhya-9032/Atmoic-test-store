<section class="apex-editorial apex-section"><div class="apex-editorial__media" style="background-image:linear-gradient(90deg,rgba(0,0,0,.86),rgba(11,29,79,.35)),{% if section.settings.image %}url('{{ section.settings.image | image_url: width: 2200 }}'){% else %}linear-gradient(120deg,#000,#0b1d4f){% endif %};"></div><div class="apex-container apex-editorial__inner {% if section.settings.image_position == 'right' %}apex-editorial__inner--right{% endif %}"><div class="apex-editorial__copy"><div class="apex-label">{{ section.settings.eyebrow }}</div><h2 class="apex-display">{{ section.settings.heading }}</h2><div class="apex-editorial__body">{{ section.settings.body }}</div>{% if section.settings.button_label != blank %}<a class="apex-button apex-button--blue" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} →</a>{% endif %}</div></div></section>
{% stylesheet %}
.apex-editorial{min-height:620px;background:#03050b;color:#fff}.apex-editorial__media{position:absolute;inset:0;background-size:cover;background-position:center}.apex-editorial__inner{position:relative;min-height:620px;display:flex;align-items:center}.apex-editorial__inner--right{justify-content:flex-end}.apex-editorial__copy{max-width:560px}.apex-editorial h2{font-size:68px;line-height:.95;margin:12px 0 20px;text-transform:uppercase}.apex-editorial__body{font-size:17px;line-height:1.7;color:rgba(255,255,255,.72);margin-bottom:28px}.apex-editorial__body p{margin:0 0 12px}@media(max-width:749px){.apex-editorial,.apex-editorial__inner{min-height:540px}.apex-editorial h2{font-size:48px}.apex-editorial__inner{padding:40px 0}}
{% endstylesheet %}
{% schema %}
{"name":"APEX Editorial","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_position","label":"Content position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"05 / APEX LAB PHILOSOPHY"},{"type":"text","id":"heading","label":"Heading","default":"PRECISION\nWITHOUT COMPROMISE."},{"type":"richtext","id":"body","label":"Body","default":"<p>Performance is not an accessory. It is the result of engineering decisions, authentic parts and a setup built around the way the machine is driven.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Discover the story"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"APEX Editorial"}]}
{% endschema %}
