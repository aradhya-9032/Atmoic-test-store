<section class="apex-brands apex-section"><div class="apex-container"><div class="apex-brands__head"><div><div class="apex-label">{{ section.settings.eyebrow }}</div><h2 class="apex-display">{{ section.settings.heading }}</h2></div><div class="apex-brands__copy">{{ section.settings.copy }}</div></div><div class="apex-brands__grid">{% for block in section.blocks %}<a class="apex-brand" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{% if block.settings.logo %}<img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="360" height="160">{% else %}<span>{{ block.settings.name }}</span>{% endif %}</a>{% endfor %}</div></div></section>
{% stylesheet %}
.apex-brands{padding:88px 0;background:var(--apex-black);color:#fff}.apex-brands__head{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:38px}.apex-brands h2{font-size:50px;line-height:1;text-transform:uppercase;margin:12px 0 0}.apex-brands__copy{max-width:520px;color:rgba(255,255,255,.62);font-size:15px;line-height:1.7}.apex-brands__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.12);border-left:1px solid rgba(255,255,255,.12)}.apex-brand{min-height:145px;display:grid;place-items:center;border-right:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12);padding:18px;text-decoration:none;color:#fff}.apex-brand img{max-width:170px;max-height:70px;object-fit:contain;filter:brightness(0) invert(1);opacity:.85;transition:opacity .2s, transform .2s}.apex-brand:hover img{opacity:1;transform:scale(1.04)}.apex-brand span{font-size:14px;letter-spacing:.1em;font-weight:700}@media(max-width:850px){.apex-brands__head{grid-template-columns:1fr}.apex-brands__grid{grid-template-columns:repeat(2,1fr)}}
{% endstylesheet %}
{% schema %}
{"name":"APEX Brands","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"04 / TRUSTED WORLDWIDE"},{"type":"text","id":"heading","label":"Heading","default":"THE BRANDS BEHIND THE BUILD"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Authentic names. Genuine parts. No substitutions. APEX LAB curates performance brands around reliability, engineering and real-world load.</p>"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Name","default":"APEX LAB"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"APEX Brands","blocks":[{"type":"brand"},{"type":"brand"},{"type":"brand"},{"type":"brand"},{"type":"brand"},{"type":"brand"},{"type":"brand"},{"type":"brand"}]}]}
{% endschema %}
