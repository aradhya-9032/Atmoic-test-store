<section
  class="atomic-footer-newsletter"
  style="
    --afn-accent: {{ section.settings.accent_color }};
    --afn-text: {{ section.settings.text_color }};
    --afn-heading: {{ section.settings.heading_color }};
    --afn-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --afn-section-height: {{ section.settings.section_height }}px;
    --afn-max-width: {{ section.settings.content_width }}px;
    --afn-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="atomic-newsletter-background">

    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '900,1200,1600,2000,2400',
          class: 'atomic-newsletter-background__image'
      }}
    {% endif %}

    <div class="atomic-newsletter-background__overlay"></div>
    <div class="atomic-newsletter-background__grid"></div>

    <div class="atomic-newsletter-container">

      <div class="atomic-newsletter-intro">

        {% if section.settings.kicker != blank %}
          <p class="atomic-newsletter-kicker">
            <span></span>
            {{ section.settings.kicker }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="atomic-newsletter-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="atomic-newsletter-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.show_microcopy and section.settings.microcopy != blank %}
          <div class="atomic-newsletter-microcopy">
            <span class="atomic-newsletter-microcopy__dot"></span>
            {{ section.settings.microcopy }}
          </div>
        {% endif %}

      </div>


      <div class="atomic-newsletter-panel">

        <div class="atomic-newsletter-panel__top">
          <span>{{ section.settings.panel_label }}</span>
          <span>{{ section.settings.panel_number }}</span>
        </div>

        <div class="atomic-newsletter-panel__body">

          <div class="atomic-newsletter-panel__copy">
            <span class="atomic-newsletter-panel__eyebrow">
              {{ section.settings.form_eyebrow }}
            </span>

            <h3>
              {{ section.settings.form_heading }}
            </h3>
          </div>


          {% form 'customer', class: 'atomic-newsletter-form' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <label
              class="visually-hidden"
              for="AtomicNewsletterEmail-{{ section.id }}"
            >
              {{ section.settings.email_label }}
            </label>

            <div class="atomic-newsletter-form__row">

              <input
                id="AtomicNewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                required
              >

              <button type="submit">
                <span>{{ section.settings.button_text }}</span>
              </button>

            </div>

            {% if form.errors %}
              <div class="atomic-newsletter-message atomic-newsletter-message--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <div class="atomic-newsletter-message atomic-newsletter-message--success">
                {{ section.settings.success_message }}
              </div>
            {% endif %}

          {% endform %}

        </div>

        <div class="atomic-newsletter-panel__bottom">
          <span>{{ section.settings.bottom_left_label }}</span>
          <span>{{ section.settings.bottom_right_label }}</span>
        </div>

      </div>

    </div>
  </div>
</section>


<script>
  (() => {
    const section = document.currentScript.previousElementSibling;

    if (!section) return;

    const elements = section.querySelectorAll(
      '.atomic-newsletter-intro, .atomic-newsletter-panel'
    );

    if (!('IntersectionObserver' in window)) {
      elements.forEach((element) => {
        element.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          elements.forEach((element, index) => {
            setTimeout(() => {
              element.classList.add('is-visible');
            }, index * 130);
          });

          observer.disconnect();
        });
      },
      {
        threshold: 0.12
      }
    );

    observer.observe(section);
  })();
</script>


{% stylesheet %}

/* ==========================================================
   APEX / ATOMIC PREMIUM NEWSLETTER
========================================================== */

.atomic-footer-newsletter {
  width: 100%;
  overflow: hidden;
  background: #030914;
}

.atomic-footer-newsletter,
.atomic-footer-newsletter * {
  box-sizing: border-box;
}


/* ==========================================================
   BACKGROUND
========================================================== */

.atomic-newsletter-background {
  position: relative;

  min-height:
    var(--afn-section-height);

  display: flex;

  align-items: center;

  overflow: hidden;

  background:
    #030914;
}

.atomic-newsletter-background__image {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  object-position:
    {{ section.settings.image_position }};

  filter:
    saturate(.72)
    contrast(1.04)
    brightness(.78);

  transform: scale(1.02);

  transition:
    transform 1.2s
    cubic-bezier(.22,.61,.36,1);
}

.atomic-newsletter-background:hover
.atomic-newsletter-background__image {
  transform:
    scale(1.035);
}

.atomic-newsletter-background__overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.93) 0%,
      rgba(0,0,0,.78) 38%,
      rgba(0,0,0,.40) 72%,
      rgba(0,0,0,.72) 100%
    );

  opacity:
    var(--afn-overlay);
}

.atomic-newsletter-background__grid {
  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .8;

  background-image:
    linear-gradient(
      rgba(255,255,255,.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.035) 1px,
      transparent 1px
    );

  background-size:
    50px 50px;

  mask-image:
    linear-gradient(
      to right,
      black,
      transparent 88%
    );
}


/* ==========================================================
   CONTAINER
========================================================== */

.atomic-newsletter-container {
  position: relative;

  z-index: 3;

  width:
    min(
      var(--afn-max-width),
      calc(100% - 48px)
    );

  margin: 0 auto;

  padding:
    76px 0;

  display: grid;

  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(360px, .75fr);

  align-items: center;

  gap:
    70px;
}


/* ==========================================================
   INTRO
========================================================== */

.atomic-newsletter-intro {
  opacity: 0;

  transform:
    translateY(24px);

  transition:
    opacity .8s ease,
    transform .8s
    cubic-bezier(.22,.61,.36,1);
}

.atomic-newsletter-intro.is-visible {
  opacity: 1;

  transform: none;
}

.atomic-newsletter-kicker {
  display: flex;

  align-items: center;

  gap: 10px;

  margin: 0 0 18px;

  color:
    var(--afn-accent);

  font-size: 10px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .18em;

  text-transform: uppercase;
}

.atomic-newsletter-kicker span {
  width: 28px;
  height: 1px;

  background:
    currentColor;
}

.atomic-newsletter-heading {
  margin: 0;

  max-width: 720px;

  font-family:
    "Russo One",
    sans-serif !important;

  font-size:
    clamp(
      46px,
      6vw,
      88px
    );

  line-height: .91;

  font-weight: 400;

  letter-spacing: -.035em;

  text-transform: uppercase;

  color:
    var(--afn-heading) !important;
}

.atomic-newsletter-description {
  max-width: 520px;

  margin-top: 24px;

  color:
    rgba(255,255,255,.68);

  font-size: 14px;

  line-height: 1.8;
}

.atomic-newsletter-description p {
  margin: 0;
}

.atomic-newsletter-microcopy {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 24px;

  padding:
    8px 11px;

  border:
    1px solid
    rgba(255,255,255,.12);

  color:
    rgba(255,255,255,.55);

  background:
    rgba(255,255,255,.025);

  font-size: 8px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .13em;

  text-transform: uppercase;
}

.atomic-newsletter-microcopy__dot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background:
    var(--afn-accent);

  box-shadow:
    0 0 10px
    var(--afn-accent);
}


/* ==========================================================
   PANEL
========================================================== */

.atomic-newsletter-panel {
  position: relative;

  min-width: 0;

  overflow: hidden;

  border:
    1px solid
    rgba(255,255,255,.16);

  border-radius:
    var(--afn-radius);

  background:
    linear-gradient(
      145deg,
      rgba(4,12,29,.94),
      rgba(3,7,16,.84)
    );

  backdrop-filter:
    blur(12px);

  box-shadow:
    0 30px 90px
    rgba(0,0,0,.38);

  opacity: 0;

  transform:
    translateY(24px);

  transition:
    opacity .8s ease,
    transform .8s
    cubic-bezier(.22,.61,.36,1);
}

.atomic-newsletter-panel.is-visible {
  opacity: 1;

  transform: none;
}


/* top bar */

.atomic-newsletter-panel__top {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding:
    13px 16px;

  border-bottom:
    1px solid
    rgba(255,255,255,.09);

  color:
    rgba(255,255,255,.42);

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.atomic-newsletter-panel__top span:last-child {
  color:
    var(--afn-accent);
}


/* body */

.atomic-newsletter-panel__body {
  padding:
    32px 30px;
}

.atomic-newsletter-panel__copy {
  margin-bottom: 25px;
}

.atomic-newsletter-panel__eyebrow {
  display: block;

  margin-bottom: 9px;

  color:
    var(--afn-accent);

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.atomic-newsletter-panel__copy h3 {
  margin: 0;

  font-family:
    "Russo One",
    sans-serif !important;

  color:
    #ffffff;

  font-size:
    clamp(
      24px,
      2.5vw,
      36px
    );

  line-height: 1;

  font-weight: 400;

  text-transform: uppercase;
}


/* form */

.atomic-newsletter-form {
  width: 100%;
}

.atomic-newsletter-form__row {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    auto;

  gap: 8px;
}

.atomic-newsletter-form input {
  width: 100%;

  height: 48px;

  padding:
    0 14px;

  border:
    1px solid
    rgba(255,255,255,.16);

  border-radius: 0;

  outline: none;

  background:
    rgba(255,255,255,.035);

  color:
    #ffffff;

  font-size: 12px;

  transition:
    border-color .25s ease,
    background .25s ease;
}

.atomic-newsletter-form input::placeholder {
  color:
    rgba(255,255,255,.40);
}

.atomic-newsletter-form input:focus {
  border-color:
    var(--afn-accent);

  background:
    rgba(2,101,242,.06);
}

.atomic-newsletter-form button {
  min-width: 136px;

  height: 48px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 13px;

  padding:
    0 17px;

  border: 0;

  border-radius: 0;

  background:
    var(--afn-accent);

  color:
    #ffffff;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .11em;

  text-transform: uppercase;

  cursor: pointer;

  transition:
    background .25s ease,
    transform .25s ease;
}

.atomic-newsletter-form button b {
  font-size: 16px;

  font-weight: 400;

  transition:
    transform .25s ease;
}

.atomic-newsletter-form button:hover {
  background:
    #0343C0;

  transform:
    translateY(-2px);
}

.atomic-newsletter-form button:hover b {
  transform:
    translate(3px,-3px);
}


/* messages */

.atomic-newsletter-message {
  margin-top: 13px;

  font-size: 11px;

  line-height: 1.6;
}

.atomic-newsletter-message--success {
  color:
    #66d58a;
}

.atomic-newsletter-message--error {
  color:
    #ff6d76;
}


/* bottom */

.atomic-newsletter-panel__bottom {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding:
    12px 16px;

  border-top:
    1px solid
    rgba(255,255,255,.08);

  color:
    rgba(255,255,255,.38);

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .13em;

  text-transform: uppercase;
}


/* ==========================================================
   MOBILE
========================================================== */

@media screen and (max-width: 989px) {

  .atomic-newsletter-container {
    grid-template-columns:
      1fr;

    gap:
      40px;

    padding:
      62px 0;
  }

  .atomic-newsletter-intro {
    max-width: 700px;
  }

  .atomic-newsletter-panel {
    max-width: 700px;

    width: 100%;

    justify-self: start;
  }
}


@media screen and (max-width: 749px) {

  .atomic-newsletter-background {
    min-height:
      auto;
  }

  .atomic-newsletter-container {
    width:
      calc(100% - 28px);

    padding:
      48px 0 52px;

    gap:
      30px;
  }

  .atomic-newsletter-heading {
    font-size:
      43px;
  }

  .atomic-newsletter-description {
    font-size:
      13px;

    margin-top:
      18px;
  }

  .atomic-newsletter-panel__body {
    padding:
      25px 20px;
  }

  .atomic-newsletter-panel__copy h3 {
    font-size:
      25px;
  }

  .atomic-newsletter-form__row {
    grid-template-columns:
      1fr;
  }

  .atomic-newsletter-form button {
    width:
      100%;
  }

  .atomic-newsletter-panel__bottom {
    flex-direction:
      column;

    align-items:
      flex-start;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Footer Newsletter",
  "tag": "section",
  "class": "atomic-footer-newsletter-section",

  "enabled_on": {
    "groups": ["footer"]
  },

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "APEX LAB / STAY IN THE LOOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY AHEAD OF THE CURVE."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get new product releases, performance insights, exclusive offers and stories from the world of automotive performance.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_microcopy",
      "label": "Show microcopy",
      "default": true
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Microcopy",
      "default": "No noise. Only performance."
    },

    {
      "type": "header",
      "content": "Newsletter panel"
    },
    {
      "type": "text",
      "id": "panel_label",
      "label": "Panel label",
      "default": "NEWSLETTER"
    },
    {
      "type": "text",
      "id": "panel_number",
      "label": "Panel number",
      "default": "01 / 01"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Form eyebrow",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "GET THE NEXT BUILD."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in. Welcome to the performance community."
    },
    {
      "type": "text",
      "id": "bottom_left_label",
      "label": "Panel bottom left",
      "default": "GENUINE PERFORMANCE"
    },
    {
      "type": "text",
      "id": "bottom_right_label",
      "label": "Panel bottom right",
      "default": "NO SPAM / EVER"
    },

    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Newsletter background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "center right",
          "label": "Right"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
