{% comment %}
  ============================================================
  APEX WISHLIST DRAWER
  UI + localStorage based wishlist rendering
  ============================================================
{% endcomment %}

<apex-wishlist-drawer
  id="ApexWishlistDrawer"
  class="apex-wishlist-drawer"
  aria-hidden="true"
>
  <!-- Overlay -->
  <div
    class="apex-wishlist-overlay"
    data-wishlist-close
  ></div>

  <!-- Drawer -->
  <aside
    class="apex-wishlist-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Wishlist"
  >

    <!-- Header -->
    <div class="apex-wishlist-header">

      <div class="apex-wishlist-heading">
        <span class="apex-wishlist-eyebrow">
          SAVED PERFORMANCE
        </span>

        <h2>WISHLIST</h2>
      </div>

      <button
        type="button"
        class="apex-wishlist-close"
        aria-label="Close wishlist"
        data-wishlist-close
      >
        ×
      </button>

    </div>

    <!-- Content -->
    <div
      class="apex-wishlist-content"
      data-wishlist-content
    >
      <!-- JS renders wishlist items here -->
    </div>

  </aside>
</apex-wishlist-drawer>


<style>
/* ============================================================
   APEX WISHLIST DRAWER
   ============================================================ */

.apex-wishlist-drawer {
  position: fixed;
  inset: 0;
  z-index: 99999;
  pointer-events: none;
  visibility: hidden;
}

/* ACTIVE */

.apex-wishlist-drawer.is-open {
  pointer-events: auto;
  visibility: visible;
}


/* ============================================================
   OVERLAY
   ============================================================ */

.apex-wishlist-overlay {
  position: absolute;
  inset: 0;

  background: rgba(7, 13, 24, 0.58);

  opacity: 0;

  backdrop-filter: blur(7px);
  -webkit-backdrop-filter: blur(7px);

  transition: opacity 0.35s ease;
}

.apex-wishlist-drawer.is-open .apex-wishlist-overlay {
  opacity: 1;
}


/* ============================================================
   DRAWER PANEL
   ============================================================ */

.apex-wishlist-panel {
  position: absolute;

  top: 0;
  right: 0;

  width: min(40vw, 720px);
  min-width: 520px;

  height: 100%;

  background: #ffffff;

  transform: translateX(100%);

  transition: transform 0.4s cubic-bezier(.22,.61,.36,1);

  display: flex;
  flex-direction: column;

  overflow: hidden;

  box-shadow:
    -20px 0 60px rgba(0,0,0,0.10);
}

.apex-wishlist-drawer.is-open .apex-wishlist-panel {
  transform: translateX(0);
}


/* ============================================================
   HEADER
   ============================================================ */

.apex-wishlist-header {
  min-height: 187px;

  padding:
    36px
    48px
    32px;

  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  border-bottom: 1px solid #e6e9ed;

  background: #ffffff;
}

.apex-wishlist-heading {
  display: flex;
  flex-direction: column;
}

.apex-wishlist-eyebrow {
  display: block;

  margin-bottom: 8px;

  font-size: 11px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: 2px;

  color: #56677d;
}

.apex-wishlist-heading h2 {
  margin: 0;

  font-size: 38px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: 0.5px;

  color: #1d2f49;
}


/* ============================================================
   CLOSE BUTTON
   ============================================================ */

.apex-wishlist-close {
  width: 48px;
  height: 48px;

  flex: 0 0 48px;

  border-radius: 50%;

  border: 1px solid #d8dee6;

  background: #ffffff;

  color: #1d2f49;

  font-size: 32px;

  font-weight: 300;

  line-height: 1;

  display: flex;

  align-items: center;
  justify-content: center;

  cursor: pointer;

  padding: 0;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.apex-wishlist-close:hover {
  background: #26385f;

  color: #ffffff;

  border-color: #26385f;

  transform: rotate(90deg);
}


/* ============================================================
   CONTENT
   ============================================================ */

.apex-wishlist-content {
  flex: 1;

  overflow-y: auto;

  padding: 26px 24px 50px;

  background: #ffffff;
}


/* ============================================================
   WISHLIST ITEM
   ============================================================ */

.apex-wishlist-item {
  width: 100%;

  min-height: 132px;

  padding: 12px;

  display: grid;

  grid-template-columns:
    104px
    minmax(0, 1fr)
    40px;

  align-items: center;

  column-gap: 20px;

  border: 1px solid #dfe4ea;

  background: #ffffff;

  margin-bottom: 12px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.apex-wishlist-item:hover {
  border-color: #bfc8d3;

  box-shadow:
    0 8px 28px rgba(20, 35, 60, 0.08);

  transform: translateY(-1px);
}


/* IMAGE */

.apex-wishlist-image-wrap {
  width: 104px;
  height: 104px;

  overflow: hidden;

  background: #f4f5f7;

  display: flex;

  align-items: center;
  justify-content: center;
}

.apex-wishlist-image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* PRODUCT INFO */

.apex-wishlist-product-info {
  min-width: 0;
}

.apex-wishlist-product-title {
  margin: 0 0 10px;

  font-size: 20px;

  line-height: 1.25;

  font-weight: 700;

  color: #1d2f49;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.apex-wishlist-product-price {
  margin: 0;

  font-size: 16px;

  line-height: 1.4;

  font-weight: 700;

  color: #1d2f49;
}


/* REMOVE BUTTON */

.apex-wishlist-remove {
  width: 40px;
  height: 40px;

  border: 0;

  background: transparent;

  color: #1d2f49;

  font-size: 23px;

  line-height: 1;

  cursor: pointer;

  display: flex;

  align-items: center;
  justify-content: center;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.apex-wishlist-remove:hover {
  background: #f3f5f7;

  color: #d62828;
}


/* ============================================================
   EMPTY STATE
   ============================================================ */

.apex-wishlist-empty {
  min-height: 400px;

  display: flex;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 40px;
}

.apex-wishlist-empty-inner {
  max-width: 360px;
}

.apex-wishlist-empty h3 {
  margin: 0 0 12px;

  color: #1d2f49;

  font-size: 28px;

  font-weight: 700;
}

.apex-wishlist-empty p {
  margin: 0 0 26px;

  color: #657084;

  font-size: 16px;

  line-height: 1.6;
}

.apex-wishlist-browse {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 52px;

  padding: 0 28px;

  border-radius: 999px;

  background: #26385f;

  color: #ffffff;

  text-decoration: none;

  font-size: 16px;

  font-weight: 700;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.apex-wishlist-browse:hover {
  background: #172746;

  transform: translateY(-1px);
}


/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width: 749px) {

  .apex-wishlist-panel {
    width: 100%;

    min-width: 0;
  }

  .apex-wishlist-header {
    min-height: 140px;

    padding:
      28px
      20px
      24px;
  }

  .apex-wishlist-heading h2 {
    font-size: 30px;
  }

  .apex-wishlist-content {
    padding: 18px 14px 40px;
  }

  .apex-wishlist-item {
    grid-template-columns:
      82px
      minmax(0, 1fr)
      34px;

    column-gap: 14px;

    min-height: 106px;
  }

  .apex-wishlist-image-wrap {
    width: 82px;
    height: 82px;
  }

  .apex-wishlist-product-title {
    font-size: 16px;

    white-space: normal;
  }

  .apex-wishlist-product-price {
    font-size: 14px;
  }

}
</style>


<script>
(function () {

  const STORAGE_KEYS = [
    'apex_lab_wishlist_v1',
    'apex_lab_wishlist',
    'apex_wishlist'
  ];


  function getWishlistStorageKey() {

    for (const key of STORAGE_KEYS) {

      if (localStorage.getItem(key) !== null) {
        return key;
      }

    }

    return STORAGE_KEYS[0];

  }


  function getWishlistItems() {

    const storageKey = getWishlistStorageKey();

    try {

      const data = JSON.parse(
        localStorage.getItem(storageKey) || '[]'
      );

      return Array.isArray(data)
        ? data
        : [];

    } catch (error) {

      return [];

    }

  }


  function saveWishlistItems(items) {

    const storageKey = getWishlistStorageKey();

    localStorage.setItem(
      storageKey,
      JSON.stringify(items)
    );

  }


  function escapeHtml(value) {

    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

  }


  function getProductId(item) {

    return String(
      item.id ||
      item.product_id ||
      item.handle ||
      item.variant_id ||
      ''
    );

  }


  function getProductTitle(item) {

    return (
      item.title ||
      item.product_title ||
      item.name ||
      'Product'
    );

  }


  function getProductImage(item) {

    return (
      item.image ||
      item.image_url ||
      item.featured_image ||
      ''
    );

  }


  function getProductPrice(item) {

    if (item.price_formatted) {
      return item.price_formatted;
    }

    if (item.price) {

      if (typeof item.price === 'number') {

        return 'Rs. ' +
          new Intl.NumberFormat('en-IN')
            .format(item.price);

      }

      return item.price;

    }

    return '';

  }


  function renderWishlist() {

    const drawer = document.getElementById(
      'ApexWishlistDrawer'
    );

    if (!drawer) return;

    const content = drawer.querySelector(
      '[data-wishlist-content]'
    );

    if (!content) return;

    const items = getWishlistItems();


    /* EMPTY */

    if (!items.length) {

      content.innerHTML = `
        <div class="apex-wishlist-empty">
          <div class="apex-wishlist-empty-inner">

            <h3>Nothing saved yet</h3>

            <p>
              Tap the ♡ on any part to save it here.
            </p>

            <a
              href="/collections/all"
              class="apex-wishlist-browse"
            >
              Browse catalog →
            </a>

          </div>
        </div>
      `;

      return;

    }


    /* ITEMS */

    content.innerHTML = items.map(function (item) {

      const id = escapeHtml(
        getProductId(item)
      );

      const title = escapeHtml(
        getProductTitle(item)
      );

      const image = escapeHtml(
        getProductImage(item)
      );

      const price = escapeHtml(
        getProductPrice(item)
      );


      return `
        <div
          class="apex-wishlist-item"
          data-wishlist-item="${id}"
        >

          <div class="apex-wishlist-image-wrap">

            ${
              image
                ? `
                  <img
                    src="${image}"
                    alt="${title}"
                    class="apex-wishlist-image"
                    loading="lazy"
                  >
                `
                : ''
            }

          </div>


          <div class="apex-wishlist-product-info">

            <h3 class="apex-wishlist-product-title">
              ${title}
            </h3>

            ${
              price
                ? `
                  <p class="apex-wishlist-product-price">
                    ${price}
                  </p>
                `
                : ''
            }

          </div>


          <button
            type="button"
            class="apex-wishlist-remove"
            aria-label="Remove ${title}"
            data-wishlist-remove="${id}"
          >
            ×
          </button>

        </div>
      `;

    }).join('');

  }


  function openDrawer() {

    const drawer = document.getElementById(
      'ApexWishlistDrawer'
    );

    if (!drawer) return;

    renderWishlist();

    drawer.classList.add('is-open');

    drawer.setAttribute(
      'aria-hidden',
      'false'
    );

    document.documentElement.style.overflow = 'hidden';

  }


  function closeDrawer() {

    const drawer = document.getElementById(
      'ApexWishlistDrawer'
    );

    if (!drawer) return;

    drawer.classList.remove('is-open');

    drawer.setAttribute(
      'aria-hidden',
      'true'
    );

    document.documentElement.style.overflow = '';

  }


  /* OPEN FROM HEADER */

  document.addEventListener(
    'click',
    function (event) {

      const trigger = event.target.closest(
        '[data-apex-wishlist-trigger]'
      );

      if (trigger) {

        event.preventDefault();

        openDrawer();

      }

    }
  );


  /* CLOSE */

  document.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest('[data-wishlist-close]')
      ) {

        closeDrawer();

      }

    }
  );


  /* REMOVE */

  document.addEventListener(
    'click',
    function (event) {

      const button = event.target.closest(
        '[data-wishlist-remove]'
      );

      if (!button) return;

      const id = String(
        button.dataset.wishlistRemove
      );

      const items = getWishlistItems();

      const updatedItems = items.filter(
        function (item) {

          return getProductId(item) !== id;

        }
      );

      saveWishlistItems(updatedItems);

      renderWishlist();


      /* Notify other wishlist UI */

      document.dispatchEvent(
        new CustomEvent(
          'apex:wishlist:changed',
          {
            detail: {
              items: updatedItems
            }
          }
        )
      );

    }
  );


  /* UPDATE DRAWER WHEN WISHLIST CHANGES */

  document.addEventListener(
    'apex:wishlist:changed',
    function () {

      const drawer = document.getElementById(
        'ApexWishlistDrawer'
      );

      if (
        drawer &&
        drawer.classList.contains('is-open')
      ) {

        renderWishlist();

      }

    }
  );


  /* ESC KEY */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        closeDrawer();

      }

    }
  );


  /* INITIAL */

  document.addEventListener(
    'DOMContentLoaded',
    function () {

      renderWishlist();

    }
  );


  /* GLOBAL FUNCTIONS */

  window.ApexWishlistDrawer = {

    open: openDrawer,

    close: closeDrawer,

    render: renderWishlist

  };

})();
</script>