<section
  class="apex-hero"
  style="
    --hero-bg: {{ section.settings.background }};
    --hero-accent: {{ section.settings.accent }};
    --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>
  <div class="apex-hero__background">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2800
        | image_tag:
          class: 'apex-hero__image',
          loading: 'eager',
          widths: '900,1200,1600,2000,2400,2800'
      }}
    {% endif %}

    <div class="apex-hero__base"></div>
    <div class="apex-hero__overlay"></div>
    <div class="apex-hero__grid"></div>

    {% if section.settings.show_glow %}
      <div class="apex-hero__glow"></div>
    {% endif %}
  </div>

  <div class="apex-hero__container">
    <div class="apex-hero__content apex-reveal">

      {% if section.settings.kicker != blank %}
        <p class="apex-kicker">
          {{ section.settings.kicker }}
        </p>
      {% endif %}

      <h1>
        {{ section.settings.heading }}
        <span>{{ section.settings.accent_word }}</span>
      </h1>

      {% if section.settings.description != blank %}
        <div class="apex-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="apex-hero__buttons">
        {% if section.settings.primary_label != blank %}
          <a
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
            class="apex-button apex-button--blue"
          >
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            href="{{ section.settings.secondary_link | default: routes.collections_url }}"
            class="apex-button apex-button--outline"
          >
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="apex-hero__bottom apex-reveal">

      <div class="apex-hero__stats">
        {% for block in section.blocks %}
          <div class="apex-hero__stat" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_scroll %}
        <div class="apex-hero__scroll">
          SCROLL
          <span></span>
        </div>
      {% endif %}

    </div>
  </div>
</section>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root) return;

  const elements = root.querySelectorAll('.apex-reveal');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      elements.forEach((element, index) => {
        setTimeout(() => {
          element.classList.add('is-visible');
        }, index * 120);
      });

      observer.disconnect();
    });
  }, {
    threshold: 0.1
  });

  observer.observe(root);
})();
</script>

{% stylesheet %}
.apex-hero {
  position: relative;
  min-height: {{ section.settings.desktop_height }}px;
  overflow: hidden;
  background: var(--hero-bg);
  color: #fff;
}

.apex-hero__background,
.apex-hero__base,
.apex-hero__overlay,
.apex-hero__grid,
.apex-hero__glow {
  position: absolute;
  inset: 0;
}

.apex-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: {{ section.settings.image_position }};
  display: block;
}

.apex-hero__base {
  background:
    linear-gradient(
      135deg,
      #000 0%,
      #061127 55%,
      var(--hero-accent) 180%
    );
}

.apex-hero__image ~ .apex-hero__base {
  opacity: .42;
}

.apex-hero__overlay {
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.92),
      rgba(0,0,0,.62) 38%,
      rgba(0,0,0,.22) 72%,
      rgba(0,0,0,.60)
    );
}

.apex-hero__grid {
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size: 55px 55px;
  mask-image: linear-gradient(to right, #000, transparent 78%);
}

.apex-hero__glow {
  left: 55%;
  top: 35%;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(2,101,242,.25),
    transparent 70%
  );
  filter: blur(20px);
}

.apex-hero__container {
  position: relative;
  z-index: 2;

  width: min(1320px, calc(100% - 48px));
  min-height: inherit;

  margin: 0 auto;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 110px 0 30px;
}

.apex-hero__content {
  max-width: 820px;
}

.apex-hero h1 {
  margin: 0;

  font-size: clamp(52px, 7.5vw, 108px);
  line-height: .88;
  letter-spacing: -.055em;

  text-transform: uppercase;
  font-weight: 800;
}

.apex-hero h1 span {
  color: var(--hero-accent);
  display: block;
}

.apex-hero__description {
  max-width: 520px;
  margin-top: 24px;

  font-size: 15px;
  line-height: 1.7;

  color: rgba(255,255,255,.76);
}

.apex-hero__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;

  margin-top: 30px;
}

.apex-button {
  min-height: 48px;
  padding: 0 24px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;

  text-decoration: none;
  text-transform: uppercase;

  border: 1px solid currentColor;

  transition:
    transform .3s ease,
    background .3s ease,
    color .3s ease;
}

.apex-button:hover {
  transform: translateY(-2px);
}

.apex-button--blue {
  background: var(--hero-accent);
  border-color: var(--hero-accent);
  color: #fff;
}

.apex-button--outline {
  background: transparent;
  color: #fff;
  border-color: rgba(255,255,255,.3);
}

.apex-hero__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  padding-top: 18px;

  border-top: 1px solid rgba(255,255,255,.16);
}

.apex-hero__stats {
  display: grid;
  grid-template-columns: repeat(3, 150px);
  gap: 25px;
}

.apex-hero__stat {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.apex-hero__stat strong {
  font-size: 18px;
}

.apex-hero__stat span {
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
}

.apex-hero__scroll {
  display: flex;
  align-items: center;
  gap: 12px;

  font-size: 9px;
  letter-spacing: .16em;
}

.apex-hero__scroll span {
  width: 34px;
  height: 1px;
  background: #fff;
  position: relative;
}

.apex-hero__scroll span::after {
  content: "";

  position: absolute;
  right: 0;
  top: -2px;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--hero-accent);
}

.apex-reveal {
  opacity: 0;
  transform: translateY(25px);

  transition:
    opacity .8s ease,
    transform .8s cubic-bezier(.22,.61,.36,1);
}

.apex-reveal.is-visible {
  opacity: 1;
  transform: none;
}

@media screen and (max-width: 749px) {
  .apex-hero {
    min-height: {{ section.settings.mobile_height }}px;
  }

  .apex-hero__container {
    width: calc(100% - 28px);
    min-height: {{ section.settings.mobile_height }}px;
    padding: 65px 0 22px;
  }

  .apex-hero h1 {
    font-size: 48px;
  }

  .apex-hero__description {
    font-size: 13px;
  }

  .apex-hero__buttons {
    flex-direction: column;
  }

  .apex-button {
    width: 100%;
  }

  .apex-hero__stats {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .apex-hero__scroll {
    display: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "APEX Hero Premium",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "APEX LAB / PERFORMANCE DIVISION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "ENGINEERED FOR"
    },
    {
      "type": "text",
      "id": "accent_word",
      "label": "Accent word",
      "default": "PERFORMANCE."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Genuine performance parts, selected with precision for people who push their machines further.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "SHOP PERFORMANCE PARTS"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "EXPLORE BRANDS"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#0265F2"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "center right", "label": "Right" },
        { "value": "center left", "label": "Left" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 560,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show blue glow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show scroll cue",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Hero stat",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "01"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "PRECISION ENGINEERED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APEX Hero Premium",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}