{% liquid
  assign announcement_count = section.blocks.size
%}

<div
  class="automotive-announcement"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-text: {{ section.settings.text_color }};
    --announcement-accent: {{ section.settings.accent_color }};
    --announcement-padding-top: {{ section.settings.padding_top }}px;
    --announcement-padding-bottom: {{ section.settings.padding_bottom }}px;
    --announcement-speed: {{ section.settings.speed }}s;
  "
>
  <div class="automotive-announcement__inner">

    {% if announcement_count > 0 %}

      {% if section.settings.enable_marquee %}

        <div class="automotive-announcement__marquee">
          <div class="automotive-announcement__track">

            {% for block in section.blocks %}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="automotive-announcement__item"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.show_icon %}
                  <span class="automotive-announcement__icon">
                    {{ block.settings.icon }}
                  </span>
                {% endif %}

                <span>{{ block.settings.text }}</span>

                {% if block.settings.show_arrow %}
                  <span class="automotive-announcement__arrow">→</span>
                {% endif %}
              </a>
            {% endfor %}

            {% for block in section.blocks %}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="automotive-announcement__item"
                aria-hidden="true"
              >
                {% if block.settings.show_icon %}
                  <span class="automotive-announcement__icon">
                    {{ block.settings.icon }}
                  </span>
                {% endif %}

                <span>{{ block.settings.text }}</span>

                {% if block.settings.show_arrow %}
                  <span class="automotive-announcement__arrow">→</span>
                {% endif %}
              </a>
            {% endfor %}

          </div>
        </div>

      {% else %}

        <div class="automotive-announcement__static">

          {% for block in section.blocks %}
            <a
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% endif %}
              class="automotive-announcement__item"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.show_icon %}
                <span class="automotive-announcement__icon">
                  {{ block.settings.icon }}
                </span>
              {% endif %}

              <span>{{ block.settings.text }}</span>

              {% if block.settings.show_arrow %}
                <span class="automotive-announcement__arrow">→</span>
              {% endif %}
            </a>
          {% endfor %}

        </div>

      {% endif %}

    {% else %}

      <div class="automotive-announcement__empty">
        Add an announcement
      </div>

    {% endif %}

  </div>
</div>

<style>
  .automotive-announcement {
    width: 100%;
    background: var(--announcement-bg);
    color: var(--announcement-text);
    padding-top: var(--announcement-padding-top);
    padding-bottom: var(--announcement-padding-bottom);
    overflow: hidden;
  }

  .automotive-announcement__inner {
    width: 100%;
    overflow: hidden;
  }

  .automotive-announcement__marquee {
    width: 100%;
    overflow: hidden;
  }

  .automotive-announcement__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: automotiveAnnouncementScroll var(--announcement-speed) linear infinite;
  }

  .automotive-announcement__marquee:hover
  .automotive-announcement__track {
    animation-play-state: paused;
  }

  .automotive-announcement__static {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
  }

  .automotive-announcement__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 0 28px;
    color: var(--announcement-text);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .automotive-announcement__item:hover {
    color: var(--announcement-accent);
  }

  .automotive-announcement__icon {
    color: var(--announcement-accent);
    font-size: 15px;
  }

  .automotive-announcement__arrow {
    color: var(--announcement-accent);
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .automotive-announcement__item:hover
  .automotive-announcement__arrow {
    transform: translateX(4px);
  }

  .automotive-announcement__empty {
    text-align: center;
    font-size: 13px;
  }

  @keyframes automotiveAnnouncementScroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .automotive-announcement {
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .automotive-announcement__item {
      padding: 0 18px;
      font-size: 11px;
      letter-spacing: 0.05em;
    }

    .automotive-announcement__static {
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .automotive-announcement__track {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Automotive announcement",
  "tag": "section",
  "class": "automotive-announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0265F2"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable scrolling announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "sec",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Performance parts • Fast shipping • Expert support"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon",
          "default": true
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✦"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Automotive announcement",
      "blocks": [
        {
          "type": "announcement"
        },
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}