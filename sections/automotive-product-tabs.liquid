{% comment %}
  Automotive Product Tabs
  Dynamic 2-4 collection tabs.
  Uses the same automotive-product-card snippet as Automotive Products.
{% endcomment %}

<section
  id="AutomotiveProductTabs-{{ section.id }}"
  class="apt"
  style="
    --apt-bg: {{ section.settings.background_color }};
    --apt-text: {{ section.settings.text_color }};
    --apt-tab-text: {{ section.settings.tab_text_color }};
    --apt-active: {{ section.settings.tab_active_color }};
    --apt-border: {{ section.settings.tab_border_color }};
    --apt-card-bg: {{ section.settings.card_background }};
    --apt-gap: {{ section.settings.card_gap }}px;
    --apt-top: {{ section.settings.padding_top }}px;
    --apt-bottom: {{ section.settings.padding_bottom }}px;
    --apt-columns: {{ section.settings.products_per_row }};
    --apt-card-radius: {{ section.settings.card_radius }}px;
    --apt-image-bg: {{ section.settings.image_background }};
    --apt-sale-bg: {{ section.settings.sale_badge_background }};
    --apt-sale-text: {{ section.settings.sale_badge_text_color }};
    --apt-meta-bg: {{ section.settings.meta_badge_background }};
    --apt-meta-text: {{ section.settings.meta_badge_text_color }};
    --apt-tab-size: {{ section.settings.tab_font_size }}px;
    --apt-tab-weight: {{ section.settings.tab_font_weight }};
    --apt-tab-padding: {{ section.settings.tab_spacing }}px;
    --apc-columns: {{ section.settings.products_per_row }};
    --apc-gap: {{ section.settings.card_gap }}px;
    --apc-text: {{ section.settings.text_color }};
    --apc-card-bg: {{ section.settings.card_background }};
    --apc-badge-bg: {{ section.settings.badge_background }};
    --apc-badge-text: {{ section.settings.badge_text_color }};
  "
>
  <div class="apt__inner">

    {% if section.blocks.size > 0 %}

      <div class="apt__tabs" role="tablist" aria-label="Product categories">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}

          <button
            type="button"
            id="APTTab-{{ section.id }}-{{ block.id }}"
            class="apt__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="APTPanel-{{ section.id }}-{{ block.id }}"
            data-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <span class="apt__tab-text">
              {{ block.settings.title | default: collection.title | default: 'PRODUCTS' }}
            </span>
            <span class="apt__tab-line"></span>
          </button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        <div
          id="APTPanel-{{ section.id }}-{{ block.id }}"
          class="apt__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          data-panel="{{ block.id }}"
          aria-labelledby="APTTab-{{ section.id }}-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >

          {% if collection != blank and collection.products_count > 0 %}

            <div class="apt__grid">
              {% for product in collection.products limit: section.settings.products_to_show %}
                <div
                  class="apt__item"
                  style="--apt-item-index: {{ forloop.index0 }};"
                >
                  {% assign product_badge = blank %}

                  {% if section.settings.show_metafield_badge and section.settings.badge_namespace != blank and section.settings.badge_key != blank %}
                    {% assign product_badge = product.metafields[section.settings.badge_namespace][section.settings.badge_key].value %}
                  {% endif %}

                  {% assign discount_percent = 0 %}
                  {% if product.compare_at_price > product.price %}
                    {% assign discount_difference = product.compare_at_price | minus: product.price %}
                    {% assign discount_percent = discount_difference | times: 100 | divided_by: product.compare_at_price | round %}
                  {% endif %}

                  {% if product_badge != blank or section.settings.show_sale_badge and discount_percent > 0 %}
                    <div class="apt__custom-badges" aria-label="Product offers">
                      {% if product_badge != blank %}
                        <span class="apt__custom-badge apt__custom-badge--meta">
                          {{ product_badge | escape }}
                        </span>
                      {% endif %}

                      {% if section.settings.show_sale_badge and discount_percent > 0 %}
                        <span class="apt__custom-badge apt__custom-badge--sale">
                          {% if section.settings.show_sale_percentage %}
                            {{ discount_percent }}% {{ section.settings.sale_badge_text }}
                          {% else %}
                            {{ section.settings.sale_badge_text }}
                          {% endif %}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% render 'automotive-product-card',
                    product: product,
                    section: section
                  %}
                </div>
              {% endfor %}
            </div>

            {% if section.settings.show_collection_link %}
              <div class="apt__all">
                <a href="{{ collection.url }}">
                  {{ section.settings.collection_link_text }}
                </a>
              </div>
            {% endif %}

          {% elsif collection != blank %}

            {% if request.design_mode %}
              <div class="apt__empty">
                {{ section.settings.empty_collection_text }}
              </div>
            {% endif %}

          {% elsif request.design_mode %}

            <div class="apt__editor-message">
              Select a collection for this tab from the Theme Editor.
            </div>

          {% endif %}

        </div>
      {% endfor %}

    {% elsif request.design_mode %}

      <div class="apt__editor-message">
        Add product tabs from the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>

<style>
  #AutomotiveProductTabs-{{ section.id }}.apt {
    width: 100%;
    background: var(--apt-bg);
    color: var(--apt-text);
    padding: var(--apt-top) 0 var(--apt-bottom);
  }

  #AutomotiveProductTabs-{{ section.id }} *,
  #AutomotiveProductTabs-{{ section.id }} *::before,
  #AutomotiveProductTabs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__inner {
    width: 100%;
    max-width: 1900px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* -----------------------------
     TABS
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__tabs {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: max-content;
    max-width: 100%;
    margin: 0 auto 40px;
    border-bottom: 1px solid var(--apt-border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tabs::-webkit-scrollbar {
    display: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab {
    position: relative;
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    color: var(--apt-tab-text);
    padding: 0 var(--apt-tab-padding) 17px;
    margin: 0;
    font-family: inherit;
    font-size: var(--apt-tab-size);
    font-weight: var(--apt-tab-weight);
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color .25s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab:hover,
  #AutomotiveProductTabs-{{ section.id }} .apt__tab.is-active {
    color: var(--apt-active);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab-line {
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 0;
    height: 3px;
    background: var(--apt-active);
    transform: translateX(-50%);
    transition: width .3s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab.is-active .apt__tab-line {
    width: calc(100% - (var(--apt-tab-padding) * 2));
  }

  /* -----------------------------
     PANELS
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__panel[hidden] {
    display: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__panel.is-active {
    animation: aptFadeIn-{{ section.id }} .25s ease;
  }

  @keyframes aptFadeIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* -----------------------------
     FEATURED PRODUCTS — SAME CARD UI
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__grid {
    display: grid;
    grid-template-columns: repeat(var(--apt-columns), minmax(0, 1fr));
    column-gap: var(--apt-gap);
    row-gap: 34px;
    width: 100%;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__item {
    position: relative;
    min-width: 0;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity .65s ease,
      transform .65s cubic-bezier(.22,.61,.36,1);
    transition-delay:
      calc(var(--apt-item-index, 0) * 25ms);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__item.is-visible {
    opacity: 1;
    transform: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__item .apc-card {
    position: relative !important;
    overflow: hidden !important;
    height: 100% !important;
    min-width: 0;

    border:
      1px solid rgba(0,0,0,.10) !important;

    border-radius:
      var(--apt-card-radius) !important;

    background:
      var(--apc-card-bg) !important;

    color:
      var(--apc-text) !important;

    box-shadow:
      none;

    transition:
      transform .4s cubic-bezier(.22,.61,.36,1),
      box-shadow .4s ease,
      border-color .3s ease !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__item:hover .apc-card {
    transform:
      translateY(-7px) !important;

    border-color:
      rgba(2,101,242,.40) !important;

    box-shadow:
      0 20px 55px rgba(8,23,52,.12) !important;
  }

  /* EXACT FEATURED-PRODUCTS IMAGE PRESENTATION */

  #AutomotiveProductTabs-{{ section.id }} .apc-card__image {
    position: relative !important;

    width: 100% !important;

    aspect-ratio:
      1 / .92 !important;

    overflow: hidden !important;

    display: block !important;

    background:
      #eef1f5 !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__image::after {
    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:
      linear-gradient(
        to top,
        rgba(4,11,24,.10),
        transparent 35%
      );
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__image-link {
    display: block !important;

    width: 100% !important;
    height: 100% !important;

    text-decoration: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__img {
    display: block !important;

    width: 100% !important;
    height: 100% !important;

    max-width: none !important;

    padding: 0 !important;

    object-fit:
      cover !important;

    object-position:
      center !important;

    transform:
      scale(1.01);

    transition:
      transform .65s cubic-bezier(.22,.61,.36,1),
      filter .4s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__item:hover .apc-card__img {
    transform:
      scale(1.065);

    filter:
      saturate(1.04)
      contrast(1.02);
  }

  /* BADGES — same featured placement */

  #AutomotiveProductTabs-{{ section.id }} .apc-card__badge {
    position: absolute !important;

    top: 12px !important;
    left: 12px !important;

    z-index: 15 !important;

    padding:
      7px 9px !important;

    border: 0 !important;
    border-radius: 0 !important;

    background:
      var(--apc-badge-bg) !important;

    color:
      var(--apc-badge-text) !important;

    font-size: 8px !important;
    line-height: 1 !important;

    font-weight: 800 !important;

    letter-spacing: .10em !important;

    text-transform: uppercase;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__badge--special {
    background:
      #0B1D4F !important;

    color:
      #ffffff !important;
  }

  /* CUSTOM METAFIELD / SALE BADGES */

  #AutomotiveProductTabs-{{ section.id }} .apt__custom-badges {
    position: absolute;

    top: 12px;
    left: 12px;

    z-index: 18;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 6px;

    max-width:
      calc(100% - 70px);

    pointer-events: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__custom-badge {
    display: inline-flex;

    align-items: center;

    min-height: 26px;

    padding:
      0 9px;

    font-size: 8px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: .10em;

    text-transform: uppercase;

    box-shadow:
      0 6px 16px rgba(0,0,0,.12);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__custom-badge--meta {
    background:
      var(--apt-meta-bg);

    color:
      var(--apt-meta-text);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__custom-badge--sale {
    background:
      var(--apt-sale-bg);

    color:
      var(--apt-sale-text);
  }

  /* WISHLIST — same featured placement */

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish {
    position: absolute !important;

    top: 7px !important;
    right: 7px !important;
    left: auto !important;
    bottom: auto !important;

    z-index: 7 !important;

    width:
      38px !important;

    height:
      38px !important;

    display: grid !important;

    place-items: center !important;

    padding: 0 !important;
    margin: 0 !important;

    border:
      1px solid rgba(0,0,0,.08) !important;

    border-radius:
      50% !important;

    background:
      rgba(255,255,255,.92) !important;

    color:
      #071329 !important;

    box-shadow:
      0 6px 18px rgba(0,0,0,.08) !important;

    backdrop-filter:
      blur(8px);

    cursor:
      pointer;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg {
    width:
      20px !important;

    height:
      20px !important;

    fill:
      none !important;

    stroke:
      currentColor !important;

    stroke-width:
      1.5;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg *,
  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg path,
  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg use {
    fill:
      none !important;

    stroke:
      currentColor !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish:hover {
    background:
      #ffffff !important;

    color:
      var(--apt-active) !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added {
    color:
      var(--apt-active) !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added svg,
  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added svg *,
  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added svg path,
  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added svg use {
    fill:
      currentColor !important;

    stroke:
      currentColor !important;
  }

  /* HOVER ADD TO CART — same featured presentation */

  #AutomotiveProductTabs-{{ section.id }} .apc-card__form {
    position: absolute;

    left: 50%;
    bottom: 12px;

    z-index: 16;

    width:
      calc(100% - 24px);

    margin: 0;

    opacity: 0;

    visibility: hidden;

    transform:
      translate(-50%, 14px);

    transition:
      opacity .25s ease,
      transform .25s ease,
      visibility .25s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card:hover .apc-card__form {
    opacity: 1;

    visibility: visible;

    transform:
      translate(-50%, 0);
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__cart {
    width: 100%;

    min-height:
      46px;
        border: 1px solid #ddd;

    background:
      rgba(255,255,255,.96);

    color:
      #111111;

    font-size:
      15px;

    font-weight:
      500;

    letter-spacing:
      .10em;

    text-transform:
      uppercase;

    transition:
      background .25s ease,
      color .25s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__cart:hover {
    background:
      #111;

    color:
      #ffffff;
  }

  /* CONTENT — same featured presentation */

  #AutomotiveProductTabs-{{ section.id }} .apc-card__content {
    padding:
      16px 15px 18px !important;

    min-height:
      0 !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__vendor {
    margin-bottom:
      7px !important;

    color:
      rgba(0,0,0,.45) !important;

    font-size:
      8px !important;

    line-height:
      1.2 !important;

    font-weight:
      800 !important;

    letter-spacing:
      .15em !important;

    text-transform:
      uppercase;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__title {
    display:
      block !important;

    color:
      var(--apc-text) !important;

    font-size:
      14px !important;

    line-height:
      1.35 !important;

    font-weight:
      650 !important;

    text-decoration:
      none !important;

    transition:
      color .2s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__title:hover {
    color:
      var(--apt-active) !important;

    text-decoration:
      none !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__price {
    margin-top:
      11px !important;

    color:
      #111111 !important;

    font-size:
      15px !important;

    line-height:
      1.2 !important;

    font-weight:
      800 !important;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__price del {
    color:
      #8c8c8c !important;

    font-size:
      11px !important;
  }

  /* -----------------------------
     VIEW ALL
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__all {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__all a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    min-height: 42px;
    padding: 0 24px;
    background: #0265F2;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__all a:hover {
    background: #111;
    transform: translateY(-2px);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__empty,
  #AutomotiveProductTabs-{{ section.id }} .apt__editor-message {
    padding: 45px 20px;
    border: 1px dashed var(--apt-border);
    text-align: center;
    font-size: 14px;
  }

  @media (max-width: 1100px) {
    #AutomotiveProductTabs-{{ section.id }} .apt__inner {
      padding: 0 28px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 34px;
    }
  }

  @media (max-width: 750px) {
    #AutomotiveProductTabs-{{ section.id }} .apt__inner {
      padding: 0 16px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__tabs {
      justify-content: flex-start;

      width: 100%;

      margin-bottom:
        24px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__tab {
      padding:
        0 17px 13px;

      font-size:
        12px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      column-gap:
        14px;

      row-gap:
        22px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__image {
      aspect-ratio:
        1 / .92;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__content {
      padding:
        11px 10px 13px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__vendor {
      font-size:
        7px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__title {
      font-size:
        11px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__price {
      font-size:
        12px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__badge {
      top:
        7px !important;

      left:
        7px !important;

      padding:
        5px 6px !important;

      font-size:
        7px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__custom-badges {
      top:
        7px;

      left:
        7px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__wish {
      top:
        6px !important;

      right:
        6px !important;

      width:
        30px !important;

      height:
        30px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg {
      width:
        17px !important;

      height:
        17px !important;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__form {
      display:
        none;
    }
  }
</style>

<script>
(() => {
  const section = document.getElementById('AutomotiveProductTabs-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;
  section.dataset.initialized = 'true';

  const tabs = Array.from(section.querySelectorAll('[data-tab]'));
  const panels = Array.from(section.querySelectorAll('[data-panel]'));

  const revealCards = (panel) => {
    panel.querySelectorAll('.apt__item').forEach((item, index) => {
      item.classList.remove('is-visible');
      window.setTimeout(() => {
        item.classList.add('is-visible');
      }, index * 55);
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selectedId = tab.dataset.tab;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === selectedId;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);

        if (active) revealCards(panel);
      });
    });
  });

  const initialPanel = panels.find((panel) => !panel.hidden);
  if (initialPanel) revealCards(initialPanel);

  section.querySelectorAll('.apc-card__wish').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();

      const added = button.classList.toggle('is-added');
      button.setAttribute(
        'aria-label',
        added ? 'Remove from wishlist' : 'Add to wishlist'
      );
    });
  });
})();
</script>

{% schema %}
{
  "name": "Automotive Product Tabs",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
