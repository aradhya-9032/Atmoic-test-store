<div class="faq-reference-section">
  <div class="faq-reference-container">

    {% if section.settings.heading != blank %}
      <h2 class="faq-reference-heading" style="font-family: 'Russo One', sans-serif !important;"> 
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="faq-reference-list">
      {% for block in section.blocks %}
        <details
          class="faq-reference-item"
          {{ block.shopify_attributes }}
        >
          <summary class="faq-reference-question">
            <span>{{ block.settings.question }}</span>
            <span class="faq-reference-icon"></span>
          </summary>

          {% if block.settings.answer != blank %}
            <div class="faq-reference-answer">
              {{ block.settings.answer }}
            </div>
          {% endif %}
        </details>
      {% endfor %}
    </div>

  </div>
</div>

{% stylesheet %}

/* =========================================
   FAQ REFERENCE SECTION
   ========================================= */

@import url('https://fonts.googleapis.com/css2?family=Russo+One&display=swap');

.faq-reference-section {
  width: 100%;
  background: #ffffff;
  box-sizing: border-box;
}

.faq-reference-container {
  width: 100%;
  max-width: 920px;
  margin: 0 auto;
  padding: 28px 20px 55px;
  box-sizing: border-box;
}

/* =========================================
   HEADING
   ========================================= */

.faq-reference-heading {
  margin: 0 0 42px;
  text-align: center;
 font-family: "Russo One", sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: uppercase;
  color: #172c42;
}

/* =========================================
   FAQ LIST
   ========================================= */

.faq-reference-list {
  width: 100%;
  max-width: 502px;
  margin: 0 auto;
}

/* =========================================
   FAQ ITEM
   ========================================= */

.faq-reference-item {
  width: 100%;
  border-bottom: 1px solid #e5e5e5;
  box-sizing: border-box;
}

/* =========================================
   QUESTION
   ========================================= */

.faq-reference-question {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: 17px 16px;

  cursor: pointer;

  list-style: none;

  color: #111111;
  background: transparent;

  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
}

.faq-reference-question::-webkit-details-marker {
  display: none;
}

.faq-reference-question::marker {
  display: none;
}

/* =========================================
   PLUS / MINUS ICON
   ========================================= */

.faq-reference-icon {
  position: relative;

  width: 14px;
  height: 14px;

  flex: 0 0 14px;

  margin-left: 20px;
}

/* Horizontal line */
.faq-reference-icon::before {
  content: "";

  position: absolute;

  top: 50%;
  left: 0;

  width: 10px;
  height: 2px;

  background: #222222;

  transform: translateY(-50%);
}

/* Vertical line */
.faq-reference-icon::after {
  content: "";

  position: absolute;

  top: 0;
  left: 4px;

  width: 2px;
  height: 10px;

  background: #222222;

  transform: translateY(2px);

  transition: opacity 0.2s ease;
}

/* When opened -> minus */
.faq-reference-item[open] .faq-reference-icon::after {
  opacity: 0;
}

/* =========================================
   ANSWER
   ========================================= */

.faq-reference-answer {
  padding: 0 16px 18px;

  color: #555555;

  font-size: 13px;
  line-height: 1.6;
}

.faq-reference-answer p {
  margin: 0 0 10px;
}

.faq-reference-answer p:last-child {
  margin-bottom: 0;
}

/* =========================================
   HOVER
   ========================================= */

.faq-reference-question:hover {
  color: #222222;
}

/* =========================================
   TABLET
   ========================================= */

@media screen and (max-width: 749px) {

  .faq-reference-container {
    padding: 30px 16px 45px;
  }

  .faq-reference-heading {
    margin-bottom: 30px;
    font-family: "Russo One", sans-serif;
    font-size: 26px;
    line-height: 1.25;
  }

  .faq-reference-list {
    max-width: 100%;
  }

  .faq-reference-question {
    padding: 16px 8px;
    font-size: 13px;
  }

  .faq-reference-answer {
    padding-left: 8px;
    padding-right: 8px;
  }

}

/* =========================================
   SMALL MOBILE
   ========================================= */

@media screen and (max-width: 480px) {

  .faq-reference-heading {
    font-size: 22px;
    font-family: "Russo One", sans-serif;
  }

  .faq-reference-question {
    font-size: 12px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "FAQ Reference",
  "tag": "section",
  "class": "faq-reference-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS (FAQ)"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your performance parts genuine?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, all our performance parts are genuine and sourced from trusted manufacturers.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Reference",
      "category": "Custom"
    }
  ]
}
{% endschema %}