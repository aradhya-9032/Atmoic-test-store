{% comment %}
  Automotive Product Tabs
  Dynamic 2-4 collection tabs.
  Uses the same automotive-product-card snippet as Automotive Products.
{% endcomment %}

<section
  id="AutomotiveProductTabs-{{ section.id }}"
  class="apt"
  style="
    --apt-bg: {{ section.settings.background_color }};
    --apt-text: {{ section.settings.text_color }};
    --apt-tab-text: {{ section.settings.tab_text_color }};
    --apt-active: {{ section.settings.tab_active_color }};
    --apt-border: {{ section.settings.tab_border_color }};
    --apt-card-bg: {{ section.settings.card_background }};
    --apt-gap: {{ section.settings.card_gap }}px;
    --apt-top: {{ section.settings.padding_top }}px;
    --apt-bottom: {{ section.settings.padding_bottom }}px;
    --apt-columns: {{ section.settings.products_per_row }};
    --apt-tab-size: {{ section.settings.tab_font_size }}px;
    --apt-tab-weight: {{ section.settings.tab_font_weight }};
    --apt-tab-padding: {{ section.settings.tab_spacing }}px;
    --apc-columns: {{ section.settings.products_per_row }};
    --apc-gap: {{ section.settings.card_gap }}px;
    --apc-text: {{ section.settings.text_color }};
    --apc-card-bg: {{ section.settings.card_background }};
    --apc-badge-bg: {{ section.settings.badge_background }};
    --apc-badge-text: {{ section.settings.badge_text_color }};
  "
>
  <div class="apt__inner">

    {% if section.blocks.size > 0 %}

      <div class="apt__tabs" role="tablist" aria-label="Product categories">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}

          <button
            type="button"
            id="APTTab-{{ section.id }}-{{ block.id }}"
            class="apt__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="APTPanel-{{ section.id }}-{{ block.id }}"
            data-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <span class="apt__tab-text">
              {{ block.settings.title | default: collection.title | default: 'PRODUCTS' }}
            </span>
            <span class="apt__tab-line"></span>
          </button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        <div
          id="APTPanel-{{ section.id }}-{{ block.id }}"
          class="apt__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          data-panel="{{ block.id }}"
          aria-labelledby="APTTab-{{ section.id }}-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >

          {% if collection != blank and collection.products_count > 0 %}

            <div class="apt__grid">
              {% for product in collection.products limit: section.settings.products_to_show %}
                {% render 'automotive-product-card',
                  product: product,
                  section: section
                %}
              {% endfor %}
            </div>

            {% if section.settings.show_collection_link %}
              <div class="apt__all">
                <a href="{{ collection.url }}">
                  {{ section.settings.collection_link_text }}
                </a>
              </div>
            {% endif %}

          {% elsif collection != blank %}

            {% if request.design_mode %}
              <div class="apt__empty">
                {{ section.settings.empty_collection_text }}
              </div>
            {% endif %}

          {% elsif request.design_mode %}

            <div class="apt__editor-message">
              Select a collection for this tab from the Theme Editor.
            </div>

          {% endif %}

        </div>
      {% endfor %}

    {% elsif request.design_mode %}

      <div class="apt__editor-message">
        Add product tabs from the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>

<style>
  #AutomotiveProductTabs-{{ section.id }}.apt {
    width: 100%;
    background: var(--apt-bg);
    color: var(--apt-text);
    padding: var(--apt-top) 0 var(--apt-bottom);
  }

  #AutomotiveProductTabs-{{ section.id }} *,
  #AutomotiveProductTabs-{{ section.id }} *::before,
  #AutomotiveProductTabs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__inner {
    width: 100%;
    max-width: 1900px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* -----------------------------
     TABS
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__tabs {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: max-content;
    max-width: 100%;
    margin: 0 auto 40px;
    border-bottom: 1px solid var(--apt-border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tabs::-webkit-scrollbar {
    display: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab {
    position: relative;
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    color: var(--apt-tab-text);
    padding: 0 var(--apt-tab-padding) 17px;
    margin: 0;
    font-family: inherit;
    font-size: var(--apt-tab-size);
    font-weight: var(--apt-tab-weight);
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color .25s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab:hover,
  #AutomotiveProductTabs-{{ section.id }} .apt__tab.is-active {
    color: var(--apt-active);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab-line {
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 0;
    height: 3px;
    background: var(--apt-active);
    transform: translateX(-50%);
    transition: width .3s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__tab.is-active .apt__tab-line {
    width: calc(100% - (var(--apt-tab-padding) * 2));
  }

  /* -----------------------------
     PANELS
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__panel[hidden] {
    display: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__panel.is-active {
    animation: aptFadeIn-{{ section.id }} .25s ease;
  }

  @keyframes aptFadeIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* -----------------------------
     SHARED PRODUCT CARD
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__grid {
    display: grid;
    grid-template-columns: repeat(var(--apt-columns), minmax(0, 1fr));
    column-gap: var(--apt-gap);
    row-gap: 55px;
    width: 100%;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card {
    position: relative;
    min-width: 0;
    background: var(--apc-card-bg);
    color: var(--apc-text);
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__image-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 5px;
    object-fit: contain;
    transition: transform .35s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card:hover .apc-card__img {
    transform: scale(1.04);
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__placeholder svg {
    width: 70%;
    height: 70%;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 5;
    padding: 5px 9px;
    background: var(--apc-badge-bg);
    color: var(--apc-badge-text);
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__badge--special {
    background: #f2f2f2;
    color: #111;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish {
    position: absolute;
    top: 7px;
    right: 7px;
    z-index: 7;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: rgba(255,255,255,.92);
    color: #333;
    border-radius: 50%;
    cursor: pointer;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform .2s ease, fill .2s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish:hover svg {
    transform: scale(1.1);
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added {
    color: #e21d2d;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__wish.is-added svg {
    fill: currentColor;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__form {
    position: absolute;
    left: 50%;
    bottom: 12px;
    z-index: 6;
    width: calc(100% - 24px);
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 14px);
    transition: opacity .25s ease, transform .25s ease, visibility .25s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card:hover .apc-card__form {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__cart {
    width: 100%;
    min-height: 54px;
    border: 1px solid #ddd;
    background: rgba(255,255,255,.97);
    color: #111;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__cart:hover {
    background: #111;
    color: #fff;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__content {
    padding: 15px 0 0;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__vendor {
    margin-bottom: 7px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    text-transform: uppercase;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__title {
    display: block;
    color: inherit;
    font-size: 15px;
    line-height: 1.45;
    text-decoration: none;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__title:hover {
    text-decoration: underline;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__price {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 700;
  }

  #AutomotiveProductTabs-{{ section.id }} .apc-card__price del {
    margin-left: 7px;
    color: #777;
    font-size: 13px;
    font-weight: 400;
  }

  /* -----------------------------
     VIEW ALL
  ----------------------------- */

  #AutomotiveProductTabs-{{ section.id }} .apt__all {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__all a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    min-height: 42px;
    padding: 0 24px;
    background: #e52b20;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__all a:hover {
    background: #111;
    transform: translateY(-2px);
  }

  #AutomotiveProductTabs-{{ section.id }} .apt__empty,
  #AutomotiveProductTabs-{{ section.id }} .apt__editor-message {
    padding: 45px 20px;
    border: 1px dashed var(--apt-border);
    text-align: center;
    font-size: 14px;
  }

  @media (max-width: 1100px) {
    #AutomotiveProductTabs-{{ section.id }} .apt__inner {
      padding: 0 28px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 42px;
    }
  }

  @media (max-width: 750px) {
    #AutomotiveProductTabs-{{ section.id }} .apt__inner {
      padding: 0 16px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__tabs {
      justify-content: flex-start;
      width: 100%;
      margin-bottom: 28px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__tab {
      padding-left: 17px;
      padding-right: 17px;
      padding-bottom: 13px;
      font-size: 12px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apt__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 30px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__content {
      padding-top: 10px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__vendor {
      font-size: 10px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__title {
      font-size: 12px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__price {
      font-size: 13px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__badge {
      top: 6px;
      left: 6px;
      padding: 4px 6px;
      font-size: 9px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__wish {
      top: 4px;
      right: 4px;
      width: 30px;
      height: 30px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__wish svg {
      width: 18px;
      height: 18px;
    }

    #AutomotiveProductTabs-{{ section.id }} .apc-card__cart {
      min-height: 44px;
      font-size: 13px;
    }
  }
</style>

<script>
(() => {
  const section = document.getElementById('AutomotiveProductTabs-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;
  section.dataset.initialized = 'true';

  const tabs = Array.from(section.querySelectorAll('[data-tab]'));
  const panels = Array.from(section.querySelectorAll('[data-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selectedId = tab.dataset.tab;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.dataset.panel === selectedId;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    });
  });

  section.querySelectorAll('.apc-card__wish').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();

      const added = button.classList.toggle('is-added');
      button.setAttribute(
        'aria-label',
        added ? 'Remove from wishlist' : 'Add to wishlist'
      );
    });
  });
})();
</script>

{% schema %}
{
  "name": "Automotive Product Tabs",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "NEW ARRIVALS"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Products per row",
      "options": [
        {"value": "2", "label": "2"},
        {"value": "3", "label": "3"},
        {"value": "4", "label": "4"},
        {"value": "5", "label": "5"},
        {"value": "6", "label": "6"}
      ],
      "default": "6"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "Tab text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "tab_font_weight",
      "label": "Tab text weight",
      "options": [
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi bold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "tab_spacing",
      "label": "Tab spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock_badge",
      "label": "Show stock badge",
      "default": true
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In stock text",
      "default": "IN STOCK"
    },
    {
      "type": "text",
      "id": "special_order_text",
      "label": "Special order text",
      "default": "SPECIAL ORDER"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hover_add_to_cart",
      "label": "Show hover Add to Cart",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to cart text",
      "default": "+ Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_collection_link",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "collection_link_text",
      "label": "View All button text",
      "default": "VIEW ALL"
    },
    {
      "type": "text",
      "id": "empty_collection_text",
      "label": "Empty collection message",
      "default": "No products available in this collection."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Tab border color",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Stock badge background",
      "default": "#008b68"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Stock badge text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Automotive Product Tabs",
      "blocks": [
        {"type": "tab", "settings": {"title": "NEW ARRIVALS"}},
        {"type": "tab", "settings": {"title": "BEST SELLERS"}},
        {"type": "tab", "settings": {"title": "DISCOUNTS"}},
        {"type": "tab", "settings": {"title": "LATEST RELEASES"}}
      ]
    }
  ]
}
{% endschema %}
