{% liquid
  assign video = section.settings.video
  assign mobile_video = section.settings.mobile_video
%}

<section
  id="AutomotiveVideoHero-{{ section.id }}"
  class="automotive-video-hero"
  style="
    --hero-height: {{ section.settings.height }}px;
    --hero-height-mobile: {{ section.settings.mobile_height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-max-width: {{ section.settings.content_width }}px;
  "
>
  <div class="automotive-video-hero__media">

    {% if section.settings.youtube_video_url != blank %}

  {% assign youtube_id = section.settings.youtube_video_url
    | split: 'v='
    | last
    | split: '&'
    | first
  %}

    <iframe
        class="automotive-video-hero__youtube-background"
        src="https://www.youtube.com/embed/{{ youtube_id }}?autoplay=1&mute=1&loop=1&playlist={{ youtube_id }}&controls=0&playsinline=1"
        title="Background video"
        frameborder="0"
        allow="autoplay; fullscreen"
        allowfullscreen>
    </iframe>

    {% elsif video != blank %}

    {{
        video
        | video_tag:
        autoplay: section.settings.autoplay,
        loop: section.settings.loop,
        muted: true,
        controls: false,
        playsinline: true,
        class: 'automotive-video-hero__video'
    }}

    {% elsif section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          class: 'automotive-video-hero__image'
      }}

    {% else %}

      {{ 'lifestyle-1' | placeholder_svg_tag: 'automotive-video-hero__placeholder' }}

    {% endif %}


    {% if mobile_video != blank %}

      <div class="automotive-video-hero__mobile-video">
        {{
          mobile_video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'automotive-video-hero__video'
        }}
      </div>

    {% endif %}


    <div class="automotive-video-hero__overlay"></div>


    <!-- HERO CONTENT -->

    <div class="automotive-video-hero__content">

      {% if section.settings.eyebrow != blank %}

        <p class="automotive-video-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </p>

      {% endif %}


      {% if section.settings.heading != blank %}

        <h2 class="automotive-video-hero__heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.button_text != blank %}

        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="automotive-video-hero__button"
        >
          {{ section.settings.button_text }}
        </a>

      {% endif %}

    </div>


    <!-- YOUTUBE -->

    {% if section.settings.youtube_text != blank %}

      <div class="automotive-video-hero__youtube">

        {% if section.settings.youtube_link != blank %}

          <a
            href="{{ section.settings.youtube_link }}"
            target="_blank"
            rel="noopener"
            class="automotive-video-hero__youtube-link"
          >

            <!-- YouTube text -->

            <span class="automotive-video-hero__youtube-text">
              {{ section.settings.youtube_text }}
            </span>


            <!-- YouTube badge -->

            <span class="automotive-video-hero__youtube-badge">

              <span class="automotive-video-hero__youtube-icon">

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.9V8.1l6.5 3.9-6.5 3.9Z"
                  />
                </svg>

                <span class="automotive-video-hero__youtube-label">
                  YouTube
                </span>

              </span>


              {% if section.settings.youtube_count != blank %}

                <span class="automotive-video-hero__youtube-count">
                  {{ section.settings.youtube_count }}
                </span>

              {% endif %}

            </span>

          </a>


        {% else %}

          <div class="automotive-video-hero__youtube-link">

            <!-- YouTube text -->

            <span class="automotive-video-hero__youtube-text">
              {{ section.settings.youtube_text }}
            </span>


            <!-- YouTube badge -->

            <span class="automotive-video-hero__youtube-badge">

              <span class="automotive-video-hero__youtube-icon">

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.9V8.1l6.5 3.9-6.5 3.9Z"
                  />
                </svg>

                <span class="automotive-video-hero__youtube-label">
                  YouTube
                </span>

              </span>


              {% if section.settings.youtube_count != blank %}

                <span class="automotive-video-hero__youtube-count">
                  {{ section.settings.youtube_count }}
                </span>

              {% endif %}

            </span>

          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>
</section>


{% stylesheet %}


/* =========================================================
   MAIN HERO
   ========================================================= */

.automotive-video-hero {
  width: 100%;
  position: relative;
  overflow: hidden;

  font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   MEDIA
   ========================================================= */

.automotive-video-hero__media {
  width: 100%;
  height: var(--hero-height);

  position: relative;
  overflow: hidden;

  background: #111;
}
.automotive-video-hero__youtube-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  pointer-events: none;
  transform: scale(1.35);
}

.automotive-video-hero__video,
.automotive-video-hero__image,
.automotive-video-hero__placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}


.automotive-video-hero__placeholder {
  background: #222;
}


.automotive-video-hero__mobile-video {
  display: none;
}


/* =========================================================
   DARK OVERLAY
   ========================================================= */

.automotive-video-hero__overlay {
  position: absolute;

  inset: 0;

  z-index: 2;

  background: rgba(
    0,
    0,
    0,
    var(--overlay-opacity)
  );
}


/* =========================================================
   CENTER CONTENT
   ========================================================= */

.automotive-video-hero__content {
  position: absolute;

  inset: 0;

  z-index: 3;

  width: min(
    90%,
    var(--content-max-width)
  );

  margin: auto;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   EYEBROW
   ========================================================= */

.automotive-video-hero__eyebrow {
  margin: 0 0 14px;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 11px;

  line-height: 14px;

  font-weight: 700;

  letter-spacing: 0.02em;

  text-transform: uppercase;

  text-align: center;
}


/* =========================================================
   MAIN HEADING
   ========================================================= */

.automotive-video-hero__heading {
  margin: 0 0 20px;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 44px;

  line-height: 46px;

  font-weight: 800;

  letter-spacing: 0.01em;

  text-transform: uppercase;

  text-align: center;
}


/* =========================================================
   BUTTON
   ========================================================= */

.automotive-video-hero__button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 52px;

  padding: 0 30px;

  background: #ed1c24;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: 0;

  text-decoration: none;

  text-transform: uppercase;

  border: 0;

  border-radius: 0;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}


.automotive-video-hero__button:hover {
  background: #c9151c;

  color: #fff;

  transform: translateY(-2px);
}


/* =========================================================
   YOUTUBE CONTAINER
   ========================================================= */

.automotive-video-hero__youtube {
  position: absolute;

  left: 50%;

  bottom: 30px;

  z-index: 4;

  transform: translateX(-50%);

  width: max-content;

  text-align: center;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   YOUTUBE LINK
   ========================================================= */

.automotive-video-hero__youtube-link {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  width: max-content;

  margin: 0 auto;

  padding: 0;

  color: #fff;

  text-decoration: none;

  background: transparent;

  font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   YOUTUBE TEXT

   Reference:
   Watch the Nürburgring test drive with Misha Charoudin
   ========================================================= */

.automotive-video-hero__youtube-text {
  display: block;

  margin: 0 0 8px;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 12px;

  line-height: 16px;

  font-weight: 500;

  white-space: nowrap;

  text-align: center;
}


/* =========================================================
   YOUTUBE BADGE

   [ YouTube ] [ 1.75M ]
   ========================================================= */

.automotive-video-hero__youtube-badge {
  display: flex;

  align-items: stretch;

  justify-content: center;

  height: 25px;

  margin: 0;

  padding: 0;
}


/* =========================================================
   RED YOUTUBE AREA
   ========================================================= */

.automotive-video-hero__youtube-icon {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 4px;

  width: auto;

  min-width: 86px;

  height: 25px;

  padding: 0 9px;

  background: #ff0000;

  color: #fff;

  box-sizing: border-box;
}


.automotive-video-hero__youtube-icon svg {
  display: block;

  width: 17px;

  height: 17px;

  flex-shrink: 0;
}


.automotive-video-hero__youtube-label {
  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 12px;

  line-height: 25px;

  font-weight: 600;

  white-space: nowrap;
}


/* =========================================================
   VIEW COUNT
   ========================================================= */

.automotive-video-hero__youtube-count {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  height: 25px;

  min-width: 38px;

  padding: 0 7px;

  background: #fff;

  color: #555;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 10px;

  line-height: 25px;

  font-weight: 600;

  white-space: nowrap;

  box-sizing: border-box;
}


/* =========================================================
   DESKTOP
   ========================================================= */

@media screen and (min-width: 750px) {

  .automotive-video-hero__eyebrow {
    font-size: 11px;

    line-height: 14px;

    margin-bottom: 14px;
  }


  .automotive-video-hero__heading {
    font-size: 44px;

    line-height: 46px;

    margin-bottom: 20px;
  }


  .automotive-video-hero__button {
    min-height: 52px;

    padding-left: 30px;

    padding-right: 30px;

    font-size: 13px;
  }


  .automotive-video-hero__youtube {
    bottom: 30px;
  }


  .automotive-video-hero__youtube-text {
    font-size: 12px;

    line-height: 16px;

    margin-bottom: 8px;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (min-width: 750px) and (max-width: 1100px) {

  .automotive-video-hero__heading {
    font-size: 38px;

    line-height: 41px;
  }


  .automotive-video-hero__eyebrow {
    font-size: 10px;

    line-height: 13px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .automotive-video-hero__media {
    height: var(--hero-height-mobile);
  }


  .automotive-video-hero__mobile-video {
    display: block;
  }


  .automotive-video-hero__mobile-video
    + .automotive-video-hero__overlay {
    z-index: 2;
  }


  .automotive-video-hero__media
    > .automotive-video-hero__video {
    display: none;
  }


  /* Eyebrow */

  .automotive-video-hero__eyebrow {
    font-size: 9px;

    line-height: 12px;

    margin-bottom: 10px;

    letter-spacing: 0.02em;
  }


  /* Heading */

  .automotive-video-hero__heading {
    font-size: 28px;

    line-height: 31px;

    margin-bottom: 16px;

    letter-spacing: 0.01em;
  }


  /* Button */

  .automotive-video-hero__button {
    min-height: 44px;

    padding-left: 22px;

    padding-right: 22px;

    font-size: 11px;
  }


  /* YouTube */

  .automotive-video-hero__youtube {
    bottom: 18px;
  }


  .automotive-video-hero__youtube-text {
    font-size: 10px;

    line-height: 14px;

    margin-bottom: 6px;
  }


  .automotive-video-hero__youtube-badge {
    height: 23px;
  }


  .automotive-video-hero__youtube-icon {
    min-width: 78px;

    height: 23px;

    padding: 0 7px;
  }


  .automotive-video-hero__youtube-icon svg {
    width: 16px;

    height: 16px;
  }


  .automotive-video-hero__youtube-label {
    font-size: 10px;

    line-height: 23px;
  }


  .automotive-video-hero__youtube-count {
    height: 23px;

    min-width: 34px;

    padding-left: 6px;

    padding-right: 6px;

    font-size: 9px;

    line-height: 23px;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 480px) {

  .automotive-video-hero__eyebrow {
    font-size: 8px;

    line-height: 11px;

    margin-bottom: 8px;
  }


  .automotive-video-hero__heading {
    font-size: 23px;

    line-height: 26px;

    margin-bottom: 13px;
  }


  .automotive-video-hero__button {
    min-height: 40px;

    padding-left: 18px;

    padding-right: 18px;

    font-size: 10px;
  }


  .automotive-video-hero__youtube {
    bottom: 14px;
  }


  .automotive-video-hero__youtube-text {
    font-size: 9px;

    line-height: 12px;

    margin-bottom: 5px;
  }


  .automotive-video-hero__youtube-badge {
    height: 21px;
  }


  .automotive-video-hero__youtube-icon {
    min-width: 70px;

    height: 21px;

    padding: 0 6px;
  }


  .automotive-video-hero__youtube-icon svg {
    width: 15px;

    height: 15px;
  }


  .automotive-video-hero__youtube-label {
    font-size: 9px;

    line-height: 21px;
  }


  .automotive-video-hero__youtube-count {
    height: 21px;

    min-width: 30px;

    padding-left: 5px;

    padding-right: 5px;

    font-size: 8px;

    line-height: 21px;
  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Automotive Video Hero",

  "tag": "section",

  "class": "automotive-video-hero-section",

  "settings": [

    {
      "type": "header",
      "content": "Video"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Desktop video"
    },

    {
       "type": "url",
       "id": "youtube_video_url",
       "label": "Background YouTube Video URL",
       "info": "Paste YouTube video URL"
    },

    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },


    {
      "type": "header",
      "content": "Hero content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "PRECISION. POWER. PERFECTION. BUILT FOR THOSE WHO DEMAND MORE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "VW GOLF R MK8.5 PROJECT"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP THE COLLECTION"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },


    {
      "type": "header",
      "content": "YouTube"
    },

    {
      "type": "text",
      "id": "youtube_text",
      "label": "YouTube text",
      "default": "Watch the Nürburgring test drive with Misha Charoudin"
    },

    {
      "type": "url",
      "id": "youtube_link",
      "label": "YouTube link"
    },

    {
      "type": "text",
      "id": "youtube_count",
      "label": "Subscriber count",
      "default": "1.75M"
    },


    {
      "type": "header",
      "content": "Size"
    },

    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    }

  ],


  "presets": [
    {
      "name": "Automotive Video Hero"
    }
  ]

}

{% endschema %}