/* =========================================
   CATEGORY + FILTER ACCORDION
========================================= */

.apex-category-list {
  display: grid;
  gap: 4px;
}

.apex-filter-row--category {
  margin: 0;
}

.apex-filter-row--category.is-active {
  background: #1f315f;
  color: #fff;
  font-weight: 700;
}

.apex-filter-row--category .apex-filter-arrow {
  transform: rotate(180deg);
}

.apex-filter-row--category[aria-expanded="true"] .apex-filter-arrow {
  transform: rotate(0deg);
}

.apex-category-content {
  display: block;
  margin-top: 4px;
}

.apex-category-content.is-collapsed {
  display: none;
}

.apex-filter-item[hidden] {
  display: none !important;
}

.apex-filter-item.is-active > .apex-filter-row {
