          "label": "Show icon",
          "default": true
        },


        {
          "type": "select",
          "id": "icon",
          "label": "Icon",

          "options": [

            {
              "value": "support",
              "label": "Support"
            },

            {
              "value": "shipping",
              "label": "Shipping"
            },

            {
              "value": "authenticity",
              "label": "Authenticity"
            },

            {
              "value": "experience",
              "label": "Experience"
            }

          ],

          "default": "support"
        },


        {
          "type": "text",
          "id": "title",
