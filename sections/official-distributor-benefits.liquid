<section
  class="atomic-distributor-benefits"
  style="
    --adb-top-bg: {{ section.settings.top_background }};
    --adb-bottom-bg: {{ section.settings.bottom_background }};
    --adb-heading: {{ section.settings.heading_color }};
    --adb-first-text: {{ section.settings.first_description_color }};
    --adb-second-text: {{ section.settings.second_description_color }};
    --adb-benefit-heading: {{ section.settings.benefit_heading_color }};
    --adb-benefit-text: {{ section.settings.benefit_text_color }};
    --adb-icon: {{ section.settings.icon_color }};
    --adb-accent: {{ section.settings.accent_color }};
    --adb-max-width: {{ section.settings.content_width }}px;
    --adb-top-padding: {{ section.settings.top_padding }}px;
    --adb-bottom-padding: {{ section.settings.bottom_padding }}px;
    --adb-grid-opacity: {{ section.settings.grid_opacity | divided_by: 100.0 }};
  "
>
  {% if section.settings.show_distributor %}
    <section class="adb-distributor">
      <div class="adb-distributor__grid"></div>

      <div class="adb-container">
        <div class="adb-distributor__header adb-reveal">
          <div class="adb-distributor__title-area">
            {% if section.settings.kicker != blank %}
              <p class="adb-kicker">
                <span></span>
                {{ section.settings.kicker }}
              </p>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h2>{{ section.settings.heading }}</h2>
            {% endif %}

            {% if section.settings.accent_heading != blank %}
              <div class="adb-accent-heading">
                {{ section.settings.accent_heading }}
              </div>
            {% endif %}
          </div>

          <div class="adb-distributor__brand-count">
            <strong>{{ section.settings.brand_count }}</strong>
            <span>{{ section.settings.brand_count_label }}</span>
          </div>
        </div>

        <div class="adb-distributor__copy adb-reveal">
          {% if section.settings.first_description != blank %}
            <div class="adb-description adb-description--first">
              {{ section.settings.first_description }}
            </div>
          {% endif %}

          {% if section.settings.second_description != blank %}
            <div class="adb-description adb-description--second">
              {{ section.settings.second_description }}
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_brand_strip %}
          <div class="adb-brand-strip adb-reveal">
            <span>AKRAPOVIC</span>
            <span>DODSON</span>
            <span>PAGID</span>
            <span>GIRODISC</span>
            <span>RECARO</span>
            <span>EVENTURI</span>
            <span>HKS</span>
            <span>AP RACING</span>
            <span>BBS</span>
            <span>KW AUTOMOTIVE</span>
            <span>GARRETT</span>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_benefits %}
    <section class="adb-benefits">
      <div class="adb-benefits__grid"></div>

      <div class="adb-benefits__inner adb-container">
        <div class="adb-benefits__intro adb-reveal">
          <div>
            {% if section.settings.benefits_kicker != blank %}
              <p class="adb-kicker adb-kicker--light">
                <span></span>
                {{ section.settings.benefits_kicker }}
              </p>
            {% endif %}

            {% if section.settings.benefits_heading != blank %}
              <h2>{{ section.settings.benefits_heading }}</h2>
            {% endif %}
          </div>

          {% if section.settings.benefits_intro != blank %}
            <div class="adb-benefits__intro-text">
              {{ section.settings.benefits_intro }}
            </div>
          {% endif %}
        </div>

        <div class="adb-benefits__cards">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <article class="adb-benefit adb-reveal" {{ block.shopify_attributes }}>
                <div class="adb-benefit__top">
                  <span class="adb-benefit__number">
                    {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                  </span>

                  {% if block.settings.show_icon %}
                    <div class="adb-benefit__icon">
                      {% case block.settings.icon %}
                        {% when 'support' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 13v-1a8 8 0 0 1 16 0v1"/>
                            <path d="M4 13h3v5H4z"/>
                            <path d="M17 13h3v5h-3z"/>
                            <path d="M7 18c1 2 3 3 5 3h2"/>
                          </svg>

                        {% when 'shipping' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 6h11v12H3z"/>
                            <path d="M14 10h4l3 3v5h-7z"/>
                            <circle cx="7" cy="19" r="2"/>
                            <circle cx="18" cy="19" r="2"/>
                          </svg>

                        {% when 'authenticity' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="9" r="5"/>
                            <path d="M9 14l-2 7 5-3 5 3-2-7"/>
                          </svg>

                        {% when 'experience' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 9h14v10H5z"/>
                            <path d="M8 9V6h8v3"/>
                            <path d="M3 9h18"/>
                          </svg>
                      {% endcase %}
                    </div>
                  {% endif %}
                </div>

                <div class="adb-benefit__content">
                  {% if block.settings.title != blank %}
                    <h3>{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <p>{{ block.settings.description }}</p>
                  {% endif %}
                </div>

                <div class="adb-benefit__bottom">
                  <span>{{ section.settings.card_footer_label }}</span>
                  <span class="adb-benefit__arrow">↗</span>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section) return;

    const items = section.querySelectorAll('.adb-reveal');

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          items.forEach((item, index) => {
            setTimeout(() => item.classList.add('is-visible'), index * 90);
          });

          observer.disconnect();
        });
      },
      { threshold: 0.08 }
    );

    observer.observe(section);
  })();
</script>

{% stylesheet %}

.atomic-distributor-benefits {
  width: 100%;
  overflow: hidden;
}

.adb-container {
  width: min(var(--adb-max-width), calc(100% - 48px));
  margin: 0 auto;
}

.adb-kicker {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 18px;
  font-size: 10px;
  line-height: 1;
  letter-spacing: .18em;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--adb-accent);
}

.adb-kicker span {
  width: 28px;
  height: 1px;
  background: currentColor;
}

.adb-distributor {
  position: relative;
  overflow: hidden;
  padding: var(--adb-top-padding) 0 var(--adb-bottom-padding);
  background: var(--adb-top-bg);
  color: var(--adb-heading);
}

.adb-distributor__grid,
.adb-benefits__grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.adb-distributor__grid {
  opacity: var(--adb-grid-opacity);
  background-image:
    linear-gradient(rgba(11,29,79,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11,29,79,.08) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: linear-gradient(to right, black, transparent 85%);
}

.adb-distributor__header {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 50px;
  padding-bottom: 28px;
  border-bottom: 1px solid rgba(0,0,0,.12);
}

.adb-distributor__title-area h2 {
  max-width: 900px;
  margin: 0;
  font-family: "Russo One", sans-serif !important;
  font-size: clamp(42px, 5.3vw, 78px);
  line-height: .93;
  font-weight: 400;
  letter-spacing: -.025em;
  text-transform: uppercase;
  color: var(--adb-heading) !important;
}

.adb-accent-heading {
  margin-top: 8px;
  font-family: "Russo One", sans-serif !important;
  font-size: clamp(28px, 3.4vw, 52px);
  line-height: 1;
  text-transform: uppercase;
  color: var(--adb-accent);
}

.adb-distributor__brand-count {
  min-width: 175px;
  padding: 18px 20px;
  border-left: 1px solid rgba(0,0,0,.12);
}

.adb-distributor__brand-count strong {
  display: block;
  font-size: clamp(42px, 5vw, 70px);
  line-height: .9;
  font-weight: 800;
  letter-spacing: -.05em;
  color: var(--adb-accent);
}

.adb-distributor__brand-count span {
  display: block;
  margin-top: 10px;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(0,0,0,.54);
}

.adb-distributor__copy {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr .8fr;
  gap: 55px;
  padding-top: 28px;
}

.adb-description {
  font-size: 14px;
  line-height: 1.75;
  font-weight: 400;
}

.adb-description p {
  margin: 0;
}

.adb-description--first,
.adb-description--first p {
  color: var(--adb-first-text) !important;
}

.adb-description--second,
.adb-description--second p {
  color: var(--adb-second-text) !important;
}

.adb-brand-strip {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 26px;
  margin-top: 32px;
  padding: 16px 0;
  overflow: hidden;
  white-space: nowrap;
  border-top: 1px solid rgba(0,0,0,.10);
  border-bottom: 1px solid rgba(0,0,0,.10);
}

.adb-brand-strip span {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
  color: rgba(0,0,0,.47);
}

.adb-brand-strip span::after {
  content: "•";
  margin-left: 26px;
  color: var(--adb-accent);
}

.adb-benefits {
  position: relative;
  overflow: hidden;
  padding: 72px 0 80px;
  background: var(--adb-bottom-bg);
  color: var(--adb-benefit-heading);
}

.adb-benefits__grid {
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: linear-gradient(to right, black, transparent 90%);
}

.adb-benefits__inner {
  position: relative;
  z-index: 2;
}

.adb-benefits__intro {
  display: grid;
  grid-template-columns: 1fr .65fr;
  gap: 60px;
  align-items: end;
  margin-bottom: 38px;
}

.adb-benefits__intro h2 {
  margin: 0;
  max-width: 760px;
  font-family: "Russo One", sans-serif !important;
  font-size: clamp(38px, 4.7vw, 68px);
  line-height: .92;
  font-weight: 400;
  letter-spacing: -.025em;
  text-transform: uppercase;
  color: var(--adb-benefit-heading) !important;
}

.adb-benefits__intro-text {
  max-width: 420px;
  justify-self: end;
  color: rgba(255,255,255,.57);
  font-size: 13px;
  line-height: 1.75;
}

.adb-benefits__intro-text p {
  margin: 0;
}

.adb-benefits__cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.adb-benefit {
  position: relative;
  min-height: 310px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.12);
  background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.018));
  transition: transform .4s cubic-bezier(.22,.61,.36,1), border-color .3s ease, background .3s ease, box-shadow .4s ease;
}

.adb-benefit::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2px;
  background: var(--adb-accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .35s ease;
}

.adb-benefit:hover {
  transform: translateY(-7px);
  border-color: var(--adb-accent);
  background: linear-gradient(145deg, rgba(2,101,242,.15), rgba(255,255,255,.025));
  box-shadow: 0 20px 50px rgba(0,0,0,.28);
}

.adb-benefit:hover::before {
  transform: scaleX(1);
}

.adb-benefit__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.adb-benefit__number {
  color: var(--adb-accent);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .16em;
}

.adb-benefit__icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.14);
  color: var(--adb-icon);
  transition: border-color .25s ease, color .25s ease, transform .25s ease;
}

.adb-benefit:hover .adb-benefit__icon {
  border-color: var(--adb-accent);
  color: var(--adb-accent);
  transform: translateY(-2px);
}

.adb-benefit__icon svg {
  width: 23px;
  height: 23px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.55;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.adb-benefit__content {
  margin-top: 40px;
}

.adb-benefit h3 {
  margin: 0 0 12px;
  max-width: 260px;
  font-size: 16px;
  line-height: 1.18;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--adb-benefit-heading) !important;
}

.adb-benefit p {
  max-width: 270px;
  margin: 0;
  font-size: 12px;
  line-height: 1.7;
  font-weight: 400;
  color: var(--adb-benefit-text) !important;
  opacity: .72;
}

.adb-benefit__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding-top: 15px;
  margin-top: 20px;
  border-top: 1px solid rgba(255,255,255,.08);
  color: rgba(255,255,255,.42);
  font-size: 8px;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.adb-benefit__arrow {
  font-size: 19px;
  color: var(--adb-accent);
  transition: transform .25s ease;
}

.adb-benefit:hover .adb-benefit__arrow {
  transform: translate(3px, -3px);
}

.adb-reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .75s ease, transform .75s cubic-bezier(.22,.61,.36,1);
}

.adb-reveal.is-visible {
  opacity: 1;
  transform: none;
}

@media screen and (max-width: 989px) {
  .adb-distributor__header,
  .adb-distributor__copy,
  .adb-benefits__intro {
    grid-template-columns: 1fr;
  }

  .adb-distributor__brand-count {
    width: fit-content;
    border-left: 0;
    border-top: 1px solid rgba(0,0,0,.12);
    padding: 18px 0 0;
  }

  .adb-benefits__intro-text {
    justify-self: start;
  }

  .adb-benefits__cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 749px) {
  .adb-container {
    width: calc(100% - 28px);
  }

  .adb-distributor {
    padding: 55px 0 60px;
  }

  .adb-distributor__title-area h2,
  .adb-benefits__intro h2 {
    font-size: 40px;
  }

  .adb-accent-heading {
    font-size: 31px;
  }

  .adb-description {
    font-size: 13px;
  }

  .adb-brand-strip {
    gap: 18px;
  }

  .adb-brand-strip span {
    font-size: 8px;
  }

  .adb-benefits {
    padding: 58px 0 62px;
  }

  .adb-benefits__cards {
    grid-template-columns: 1fr;
  }

  .adb-benefit {
    min-height: 260px;
  }

  .adb-benefit__content {
    margin-top: 28px;
  }
}

{% endstylesheet %}

