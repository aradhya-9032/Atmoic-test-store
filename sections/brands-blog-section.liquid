<section
  class="atomic-brands-blog"
  style="
    --abb-bg: {{ section.settings.background_color }};
    --abb-heading: {{ section.settings.heading_color }};
    --abb-button: {{ section.settings.button_color }};
    --abb-button-text: {{ section.settings.button_text_color }};
    --abb-card-border: {{ section.settings.card_border_color }};
  "
>

  {% comment %}
    =========================================================
    BRANDS
    =========================================================
  {% endcomment %}

  {% if section.settings.show_brands %}

    <div class="abb-brands">

      {% if section.settings.brands_heading != blank %}
        <h2 class="abb-heading">
          {{ section.settings.brands_heading }}
        </h2>
      {% endif %}

      <div class="abb-brands-slider-wrap">

        {% if section.settings.show_brand_arrows %}
          <button
            type="button"
            class="abb-arrow abb-arrow--prev"
            data-abb-prev
            aria-label="Previous brands"
          >
            &#8592;
          </button>
        {% endif %}

        <div class="abb-brands-slider" data-abb-slider>

          {% for block in section.blocks %}

            {% if block.type == 'brand' %}

              <div
                class="abb-brand"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">
                {% endif %}

                  {% if block.settings.logo != blank %}

                    {{
                      block.settings.logo
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        class: 'abb-brand__image'
                    }}

                  {% else %}

                    <span class="abb-brand__name">
                      {{ block.settings.name }}
                    </span>

                  {% endif %}

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}

              </div>

            {% endif %}

          {% endfor %}

        </div>

        {% if section.settings.show_brand_arrows %}
          <button
            type="button"
            class="abb-arrow abb-arrow--next"
            data-abb-next
            aria-label="Next brands"
          >
            &#8594;
          </button>
        {% endif %}

      </div>

      {% if section.settings.show_brands_button %}

        <div class="abb-button-wrap">

          <a
            href="{{ section.settings.brands_button_link | default: '#' }}"
            class="abb-button"
          >
            {{ section.settings.brands_button_text }}
          </a>

        </div>

      {% endif %}

    </div>

  {% endif %}


  {% comment %}
    =========================================================
    BLOG POSTS
    =========================================================
  {% endcomment %}

  {% if section.settings.show_blog %}

    <div class="abb-blog">

      {% if section.settings.blog_heading != blank %}
        <h2 class="abb-heading">
          {{ section.settings.blog_heading }}
        </h2>
      {% endif %}


      {% assign selected_blog = section.settings.blog %}

      {% if selected_blog != blank %}

        <div
          class="abb-blog-grid abb-blog-grid--{{ section.settings.blog_columns }}"
        >

          {% for article in selected_blog.articles limit: section.settings.blog_limit %}

            <article
              class="abb-blog-card"
            >

              {% if section.settings.show_blog_image %}

                {% if article.image != blank %}

                  <a
                    href="{{ article.url }}"
                    class="abb-blog-card__image-link"
                  >

                    {{
                      article.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        class: 'abb-blog-card__image'
                    }}

                  </a>

                {% endif %}

              {% endif %}


              {% if section.settings.show_blog_title %}

                <h3 class="abb-blog-card__title">

                  <a href="{{ article.url }}">
                    {{ article.title }}
                  </a>

                </h3>

              {% endif %}


              {% if section.settings.show_blog_excerpt %}

                {% if article.excerpt != blank %}

                  <div class="abb-blog-card__excerpt">
                    {{ article.excerpt | strip_html | truncate: 140 }}
                  </div>

                {% else %}

                  <div class="abb-blog-card__excerpt">
                    {{ article.content | strip_html | truncate: 140 }}
                  </div>

                {% endif %}

              {% endif %}


              {% if section.settings.show_blog_button %}

                <a
                  href="{{ article.url }}"
                  class="abb-blog-readmore"
                >
                  {{ section.settings.blog_button_text }}
                </a>

              {% endif %}

            </article>

          {% endfor %}

        </div>

      {% else %}

        <div class="abb-empty">
          Select a blog from the Theme Editor.
        </div>

      {% endif %}

    </div>

  {% endif %}

</section>


{% stylesheet %}

/* =========================================================
   MAIN
   ========================================================= */

.atomic-brands-blog {
  width: 100%;
  background: var(--abb-bg);
  color: var(--abb-heading);
}


/* =========================================================
   COMMON HEADING
   ========================================================= */

.abb-heading {
  margin: 0;
  text-align: center;
  font-family:"Russo One", san serif;
  font-size: 36px;
  line-height: 1.1;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .01em;
}


/* =========================================================
   BRANDS
   ========================================================= */

.abb-brands {
  padding: 50px 40px 45px;
}

.abb-brands-slider-wrap {
  position: relative;

  display: flex;
  align-items: center;

  width: 100%;

  margin-top: 45px;
}

.abb-brands-slider {
  width: 100%;

  display: flex;
  align-items: center;

  justify-content: center;

  gap: 55px;

  overflow-x: auto;

  scrollbar-width: none;

  scroll-behavior: smooth;

  padding: 10px 55px;
}

.abb-brands-slider::-webkit-scrollbar {
  display: none;
}


.abb-brand {
  flex: 0 0 130px;

  height: 65px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.abb-brand a {
  display: flex;

  width: 100%;
  height: 100%;

  align-items: center;
  justify-content: center;

  text-decoration: none;
}

.abb-brand__image {
  display: block;

  width: auto;
  max-width: 125px;

  max-height: 100px;

  object-fit: contain;
}

.abb-brand__name {
  font-size: 16px;
  font-weight: 700;

  text-align: center;
}


/* =========================================================
   BRAND ARROWS
   ========================================================= */

.abb-arrow {
  position: absolute;

  top: 50%;

  transform: translateY(-50%);

  z-index: 2;

  width: 44px;
  height: 44px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #ffffff;

  border: 1px solid #dddddd;

  color: #222222;

  cursor: pointer;

  font-size: 20px;
}

.abb-arrow:hover {
  background: var(--abb-button);
  color: #ffffff;

  border-color: var(--abb-button);
}

.abb-arrow--prev {
  left: 0;
}

.abb-arrow--next {
  right: 0;
}


/* =========================================================
   BUTTON
   ========================================================= */

.abb-button-wrap {
  display: flex;

  justify-content: center;

  margin-top: 35px;
}

.abb-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 100px;
  min-height: 40px;

  padding: 12px 25px;

  background: var(--abb-button);

  color: var(--abb-button-text);

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  text-transform: uppercase;

  transition: opacity .2s ease;
}

.abb-button:hover {
  opacity: .85;
}


/* =========================================================
   BLOG
   ========================================================= */

.abb-blog {
  padding: 50px 40px 60px;
}

.abb-blog-grid {
  display: grid;

  gap: 35px;

  margin-top: 45px;
}

.abb-blog-grid--2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.abb-blog-grid--3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.abb-blog-grid--4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}


/* =========================================================
   BLOG CARD
   ========================================================= */

.abb-blog-card {
  min-width: 0;
}

.abb-blog-card__image-link {
  display: block;

  overflow: hidden;

  border: 1px solid var(--abb-card-border);
}

.abb-blog-card__image {
  display: block;

  width: 100%;
  height: auto;

  aspect-ratio: 1 / .82;

  object-fit: cover;

  transition: transform .3s ease;
}

.abb-blog-card:hover .abb-blog-card__image {
  transform: scale(1.03);
}

.abb-blog-card__title {
  margin: 16px 0 0;

  font-size: 20px;

  line-height: 1.15;

  font-weight: 800;
}

.abb-blog-card__title a {
  color: inherit;

  text-decoration: none;
}

.abb-blog-card__excerpt {
  margin-top: 10px;

  font-size: 14px;

  line-height: 1.5;

  opacity: .8;
}

.abb-blog-readmore {
  display: inline-block;

  margin-top: 14px;

  color: var(--abb-heading);

  font-size: 12px;

  font-weight: 700;

  text-transform: uppercase;

  text-decoration: underline;
}

.abb-empty {
  margin-top: 30px;

  text-align: center;

  padding: 30px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .abb-brands {
    padding: 35px 20px;
  }

  .abb-blog {
    padding: 35px 20px 45px;
  }

  .abb-heading {
    font-size: 28px;
  }

  .abb-brands-slider {
    justify-content: flex-start;

    gap: 30px;

    padding-inline: 45px;
  }

  .abb-brand {
    flex-basis: 110px;
  }

  .abb-brand__image {
    max-width: 105px;
  }

  .abb-blog-grid--2,
  .abb-blog-grid--3,
  .abb-blog-grid--4 {
    grid-template-columns: 1fr;
  }

  .abb-blog-grid {
    gap: 30px;
  }

  .abb-blog-card__title {
    font-size: 18px;
  }

}

{% endstylesheet %}


<script>
  document.addEventListener('DOMContentLoaded', function () {

    const slider = document.querySelector('[data-abb-slider]');
    const prev = document.querySelector('[data-abb-prev]');
    const next = document.querySelector('[data-abb-next]');

    if (!slider) return;

    if (prev) {
      prev.addEventListener('click', function () {
        slider.scrollBy({
          left: -300,
          behavior: 'smooth'
        });
      });
    }

    if (next) {
      next.addEventListener('click', function () {
        slider.scrollBy({
          left: 300,
          behavior: 'smooth'
        });
      });
    }

  });
</script>


