{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  {{ section.shopify_attributes }}
>
  <div
    class="atomic-utilities utilities--blocks-{{ section.blocks.size }} spacing-style"
    style="
      {% render 'spacing-style', settings: section.settings %}
      --utilities-gap: {{ section.settings.gap }}px;
      --utilities-border-width: {{ section.settings.divider_thickness }}px;
      --utilities-border-color: {{ section.settings.divider_color | default: 'rgba(255,255,255,0.12)' }};
      --utilities-background: {{ section.settings.background_color | default: '#242424' }};
      --utilities-text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
    "
    data-testid="footer-utilities"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}

/* =========================================================
   ATOMIC UTILITIES
========================================================= */

.atomic-utilities {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: var(--utilities-gap);

  box-sizing: border-box;

  background: var(--utilities-background);
  color: var(--utilities-text-color);

  border-top:
    var(--utilities-border-width)
    solid
    var(--utilities-border-color);

  text-wrap: nowrap;
}


/* =========================================================
   FORCE TEXT COLOR
========================================================= */

.atomic-utilities,
.atomic-utilities * {
  color: var(--utilities-text-color);
}


/* =========================================================
   LINKS
========================================================= */

.atomic-utilities a,
.atomic-utilities button {
  color: var(--utilities-text-color);
  text-decoration: none;
}

.atomic-utilities a:hover,
.atomic-utilities button:hover {
  color: #0265F2;
}


/* =========================================================
   BLOCKS
========================================================= */

.atomic-utilities > * {
  text-align: center;
}


/* =========================================================
   COPYRIGHT
========================================================= */

.atomic-utilities .footer-copyright,
.atomic-utilities .footer-copyright * {
  color: var(--utilities-text-color);
  font-size: 11px;
}


/* =========================================================
   POLICY LINKS
========================================================= */

.atomic-utilities .footer-policy-list,
.atomic-utilities .footer-policy-list * {
  color: var(--utilities-text-color);
  font-size: 11px;
}

.atomic-utilities .footer-policy-list a:hover {
  color: #0265F2;
}


/* =========================================================
   SOCIAL ICONS
========================================================= */

.atomic-utilities .social-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0;
}

.atomic-utilities .social-links a {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(255,255,255,0.12);

  color: var(--utilities-text-color);
}

.atomic-utilities .social-links a:hover {
  background: #0265F2;
  border-color: #0265F2;
  color: #ffffff;
}


/* =========================================================
   DESKTOP
========================================================= */

@media screen and (min-width: 750px) {

  .atomic-utilities {
    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    column-gap: var(--utilities-gap);

    row-gap: 10px;

    text-align: left;
  }

  /* LEFT - COPYRIGHT */

  .atomic-utilities > *:nth-child(1) {
    justify-self: start;
    text-align: left;
  }

  /* CENTER - POLICIES */

  .atomic-utilities > *:nth-child(2) {
    justify-self: center;
    text-align: center;
  }

  /* RIGHT - SOCIAL */

  .atomic-utilities > *:nth-child(3) {
    justify-self: end;
    text-align: right;
  }
}


/* =========================================================
   TABLET
========================================================= */

@media screen and (min-width: 750px) and (max-width: 989px) {

  .atomic-utilities {
    column-gap: 25px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  .atomic-utilities {
    display: flex;

    flex-direction: column;

    gap: 14px;

    padding-inline: 15px;

    text-wrap: wrap;

    text-align: center;
  }

  .atomic-utilities > * {
    width: 100%;

    text-align: center;

    justify-content: center;
  }

  .atomic-utilities .social-links {
    justify-content: center;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 3,

  "enabled_on": {
    "groups": ["footer"]
  },

  "settings": [

    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",

      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],

      "default": "full-width"
    },

    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",

      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",

      "default": 24
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",

      "default": "#242424"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",

      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",

      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",

      "default": 1
    },

    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",

      "default": "rgba(255,255,255,0.12)"
    },

    {
      "type": "header",
      "content": "t:content.padding"
    },

    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",

      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",

      "default": 20
    },

    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",

      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",

      "default": 20
    }
  ],

  "blocks": [
    {
      "type": "footer-copyright"
    },

    {
      "type": "footer-policy-list"
    },

    {
      "type": "social-links"
    }
  ],

  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",

      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },

        "policy_list": {
          "type": "footer-policy-list"
        },

        "social_icons": {
          "type": "social-links"
        }
      },

      "block_order": [
        "copyright",
        "policy_list",
        "social_icons"
      ]
    }
  ]
}
{% endschema %}