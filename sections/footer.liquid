<footer
  class="apex-footer"
  style="
    --apex-footer-bg: {{ section.settings.background_color }};
    --apex-footer-text: {{ section.settings.text_color }};
    --apex-footer-heading: {{ section.settings.heading_color }};
    --apex-footer-accent: {{ section.settings.accent_color }};
    --apex-footer-border: {{ section.settings.border_color }};
    --apex-footer-max-width: {{ section.settings.max_width }}px;
    --apex-footer-top: {{ section.settings.top_padding }}px;
    --apex-footer-bottom: {{ section.settings.bottom_padding }}px;
    --apex-footer-gap: {{ section.settings.column_gap }}px;
    --apex-footer-font-size: {{ section.settings.font_size }}px;
  "
>
  <div class="apex-footer__main">
    <div class="apex-footer__inner">

      {% if section.settings.show_support %}
        <div class="apex-footer__column apex-footer__support">
          {% if section.settings.support_heading != blank %}
            <h2 class="apex-footer__heading">{{ section.settings.support_heading }}</h2>
          {% endif %}

          {% if section.settings.support_content != blank %}
            <div class="apex-footer__support-content">
              {{ section.settings.support_content | newline_to_br }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_company %}
        <div class="apex-footer__column">
          {% if section.settings.company_heading != blank %}
            <h2 class="apex-footer__heading">{{ section.settings.company_heading }}</h2>
          {% endif %}

          {% if section.settings.company_menu != blank %}
            <ul class="apex-footer__menu">
              {% for link in section.settings.company_menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_information %}
        <div class="apex-footer__column">
          {% if section.settings.information_heading != blank %}
            <h2 class="apex-footer__heading">{{ section.settings.information_heading }}</h2>
          {% endif %}

          {% if section.settings.information_menu != blank %}
            <ul class="apex-footer__menu">
              {% for link in section.settings.information_menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_policies %}
        <div class="apex-footer__column">
          {% if section.settings.policies_heading != blank %}
            <h2 class="apex-footer__heading">{{ section.settings.policies_heading }}</h2>
          {% endif %}

          {% if section.settings.policies_menu != blank %}
            <ul class="apex-footer__menu">
              {% for link in section.settings.policies_menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_follow %}
        <div class="apex-footer__column apex-footer__follow">
          {% if section.settings.follow_heading != blank %}
            <h2 class="apex-footer__heading">{{ section.settings.follow_heading }}</h2>
          {% endif %}

          {% if section.settings.follow_description != blank %}
            <div class="apex-footer__follow-description">
              {{ section.settings.follow_description | newline_to_br }}
            </div>
          {% endif %}

          {% if section.settings.show_social %}
            <div class="apex-footer__socials">
              {% if section.settings.facebook_url != blank %}
                <a
                  href="{{ section.settings.facebook_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                >
                  <span>f</span>
                </a>
              {% endif %}

              {% if section.settings.instagram_url != blank %}
                <a
                  href="{{ section.settings.instagram_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  <span>IG</span>
                </a>
              {% endif %}

              {% if section.settings.youtube_url != blank %}
                <a
                  href="{{ section.settings.youtube_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="YouTube"
                >
                  <span>YT</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>

  {% if section.settings.show_bottom_row %}
    <div class="apex-footer__bottom">
      <div class="apex-footer__bottom-inner">

        <div class="apex-footer__bottom-left">
          {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
            {% form 'localization', id: 'ApexFooterCountryForm' %}
              <label class="visually-hidden" for="ApexFooterCountry">
                Country or region
              </label>

              <select
                id="ApexFooterCountry"
                name="country_code"
                class="apex-footer__country-select"
                onchange="this.form.submit()"
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            {% endform %}
          {% elsif section.settings.currency_text != blank %}
            <span>{{ section.settings.currency_text }}</span>
          {% endif %}
        </div>

        <div class="apex-footer__copyright">
          <span>© {{ 'now' | date: '%Y' }}</span>
          <span>{{ section.settings.copyright_text | default: shop.name }}</span>
        </div>

        <div class="apex-footer__payments">
          {% if section.settings.payment_text != blank %}
            <span class="apex-footer__payment-label">{{ section.settings.payment_text }}</span>
          {% endif %}

          {% if section.settings.show_payment_icons %}
            <div class="apex-footer__payment-icons">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'apex-footer__payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  {% endif %}
</footer>

{% stylesheet %}
/* =========================================================
   APEX FOOTER — REFERENCE UI
   Shopify menus + localization + payment functionality kept
========================================================= */

.apex-footer,
.apex-footer * {
  box-sizing: border-box;
}

.apex-footer {
  width: 100%;
  background: var(--apex-footer-bg);
  color: var(--apex-footer-text);
  border-top: 1px solid var(--apex-footer-border);
  font-size: var(--apex-footer-font-size);
}

.apex-footer__main {
  width: 100%;
}

.apex-footer__inner {
  width: min(var(--apex-footer-max-width), calc(100% - 48px));
  margin: 0 auto;
  padding: var(--apex-footer-top) 0 var(--apex-footer-bottom);
  display: grid;
  grid-template-columns: 1.35fr repeat(3, 1fr) 1.45fr;
  gap: var(--apex-footer-gap);
  align-items: start;
}

.apex-footer__column {
  min-width: 0;
}

.apex-footer__heading {
  margin: 0 0 16px;
  color: var(--apex-footer-heading);
  font-size: 10px;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.apex-footer__menu {
  margin: 0;
  padding: 0;
  list-style: none;
}

.apex-footer__menu li + li {
  margin-top: 12px;
}

.apex-footer__menu a {
  color: var(--apex-footer-text);
  text-decoration: none;
  line-height: 1.45;
  opacity: .82;
  transition: color .2s ease, opacity .2s ease;
}

.apex-footer__menu a:hover {
  color: var(--apex-footer-accent);
  opacity: 1;
}

.apex-footer__support-content,
.apex-footer__follow-description {
  color: var(--apex-footer-text);
  line-height: 1.75;
  opacity: .82;
}

.apex-footer__follow-description {
  max-width: 270px;
}

.apex-footer__socials {
  display: flex;
  gap: 8px;
  margin-top: 18px;
}

.apex-footer__socials a {
  width: 46px;
  height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--apex-footer-border);
  border-radius: 12px;
  color: var(--apex-footer-heading);
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  transition: border-color .2s ease, color .2s ease, background .2s ease;
}

.apex-footer__socials a:hover {
  border-color: var(--apex-footer-accent);
  color: #ffffff;
  background: var(--apex-footer-accent);
}

.apex-footer__bottom {
  border-top: 1px solid var(--apex-footer-border);
}

.apex-footer__bottom-inner {
  width: min(var(--apex-footer-max-width), calc(100% - 48px));
  min-height: 66px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24px;
}

.apex-footer__bottom-left,
.apex-footer__copyright,
.apex-footer__payments {
  color: var(--apex-footer-text);
  font-size: 10px;
  opacity: .8;
}

.apex-footer__copyright {
  display: flex;
  justify-content: center;
  gap: 5px;
  text-align: center;
  white-space: nowrap;
}

.apex-footer__payments {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
}

.apex-footer__payment-label {
  white-space: nowrap;
}

.apex-footer__payment-icons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  flex-wrap: wrap;
}

.apex-footer__payment-icon {
  width: 38px;
  height: auto;
  max-height: 24px;
}

.apex-footer__country-select {
  max-width: 190px;
  padding: 9px 32px 9px 12px;
  border: 1px solid var(--apex-footer-border);
  border-radius: 8px;
  background: transparent;
  color: var(--apex-footer-text);
  font-size: 10px;
  cursor: pointer;
}

.apex-footer__country-select option {
  color: #111111;
  background: #ffffff;
}

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

@media screen and (max-width: 1100px) {
  .apex-footer__inner {
    grid-template-columns: repeat(3, 1fr);
    row-gap: 40px;
  }

  .apex-footer__support,
  .apex-footer__follow {
    grid-column: span 3;
  }
}

@media screen and (max-width: 749px) {
  .apex-footer__inner {
    width: calc(100% - 32px);
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 42px 0;
  }

  .apex-footer__support,
  .apex-footer__follow {
    grid-column: auto;
  }

  .apex-footer__bottom-inner {
    width: calc(100% - 32px);
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 14px;
    padding: 18px 0;
  }

  .apex-footer__copyright,
  .apex-footer__payments {
    justify-content: center;
    text-align: center;
    flex-wrap: wrap;
    white-space: normal;
  }

  .apex-footer__payment-icons {
    justify-content: center;
  }
}
{% endstylesheet %}

