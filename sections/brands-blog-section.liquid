<section
  class="atomic-brands-blog"
  data-abb-section="{{ section.id }}"
  style="
    --abb-bg: {{ section.settings.background_color }};
    --abb-panel: {{ section.settings.panel_background }};
    --abb-heading: {{ section.settings.heading_color }};
    --abb-muted: {{ section.settings.muted_text_color }};
    --abb-accent: {{ section.settings.accent_color }};
    --abb-button: {{ section.settings.button_color }};
    --abb-button-text: {{ section.settings.button_text_color }};
    --abb-card-border: {{ section.settings.card_border_color }};
    --abb-grid-opacity: {{ section.settings.grid_opacity | divided_by: 100.0 }};
    --abb-max-width: {{ section.settings.content_width }}px;
    --abb-brand-card-width: {{ section.settings.brand_card_width }}px;
    --abb-brand-card-height: {{ section.settings.brand_card_height }}px;
    --abb-brand-gap: {{ section.settings.brand_gap }}px;
    --abb-blog-gap: {{ section.settings.blog_card_gap }}px;
    --abb-blog-card-padding: {{ section.settings.blog_card_padding }}px;
    --abb-blog-media-height: {{ section.settings.blog_media_height }}px;
  "
>
  <div class="abb-grid"></div>

  {% if section.settings.show_brands %}
    <section class="abb-brands">

      <div class="abb-container">

        <div class="abb-section-header abb-reveal hidden">
          <div>
            {% if section.settings.brands_kicker != blank %}
              <p class="abb-kicker">
                <span></span>
                {{ section.settings.brands_kicker }}
              </p>
            {% endif %}

            {% if section.settings.brands_heading != blank %}
              <h2 class="abb-heading">
                {{ section.settings.brands_heading }}
              </h2>
            {% endif %}

            {% if section.settings.brands_description != blank %}
              <div class="abb-description">
                {{ section.settings.brands_description }}
              </div>
            {% endif %}
          </div>

          <div class="abb-header-meta">
            <strong>{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</strong>
            <span>{{ section.settings.brands_count_label }}</span>
          </div>
        </div>


        <div class="abb-brands-slider-wrap abb-reveal">

          {% if section.settings.show_brand_arrows %}
            <button
              type="button"
              class="abb-arrow abb-arrow--prev"
              data-abb-prev
              aria-label="Previous brands"
            >
              <span>←</span>
            </button>
          {% endif %}

          <div
            class="abb-brands-slider"
            data-abb-slider
            tabindex="0"
            aria-label="Performance brands"
          >
            <div class="abb-brand-track" data-abb-track>
              {% for block in section.blocks %}
              {% if block.type == 'brand' %}
                <div
                  class="abb-brand"
                  {{ block.shopify_attributes }}
                >
                  <a
                    href="{{ block.settings.link | default: '#' }}"
                    class="abb-brand__link"
                    {% if block.settings.link == blank %}
                      aria-disabled="true"
                    {% endif %}
                  >

                    <div class="abb-brand__top">
                      <span class="abb-brand__index">
                        {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                      </span>
                    </div>

                    <div class="abb-brand__visual">
                      {% if block.settings.logo != blank %}
                        {{
                          block.settings.logo
                          | image_url: width: 360
                          | image_tag:
                            loading: 'lazy',
                            widths: '140,220,320,360',
                            class: 'abb-brand__image',
                            alt: block.settings.name | default: 'Brand'
                        }}
                      {% else %}
                        <span class="abb-brand__name">
                          {{ block.settings.name }}
                        </span>
                      {% endif %}
                    </div>

                    <div class="abb-brand__bottom">
                      <span>
                        {{ block.settings.name }}
                      </span>
                      <b aria-hidden="true">↗</b>
                    </div>

                  </a>
                </div>
              {% endif %}
            {% endfor %}
            </div>
          </div>

          {% if section.settings.show_brand_arrows %}
            <button
              type="button"
              class="abb-arrow abb-arrow--next"
              data-abb-next
              aria-label="Next brands"
            >
              <span>→</span>
            </button>
          {% endif %}

        </div>

        {% if section.settings.show_brand_pagination %}
          <div
            class="abb-brand-pagination"
            data-abb-pagination
            aria-label="Brand carousel pagination"
          ></div>
        {% endif %}


        {% if section.settings.show_brands_button %}
          <div class="abb-button-wrap abb-reveal">
            <a
              href="{{ section.settings.brands_button_link | default: '#' }}"
              class="abb-button"
            >
              <span>{{ section.settings.brands_button_text }}</span>
            </a>
          </div>
        {% endif %}

      </div>
    </section>
  {% endif %}


  {% if section.settings.show_blog %}
    <section class="abb-blog">

      <div class="abb-container">

        <div class="abb-section-header abb-section-header--blog abb-reveal">
          <div>
            {% if section.settings.blog_kicker != blank %}
              <p class="abb-kicker">
                <span></span>
                {{ section.settings.blog_kicker }}
              </p>
            {% endif %}

            {% if section.settings.blog_heading != blank %}
              <h2 class="abb-heading">
                {{ section.settings.blog_heading }}
              </h2>
            {% endif %}

            {% if section.settings.blog_description != blank %}
              <div class="abb-description">
                {{ section.settings.blog_description }}
              </div>
            {% endif %}
          </div>

          {% if section.settings.blog_button_text != blank and section.settings.blog != blank %}
            <a
              href="{{ section.settings.blog.url }}"
              class="abb-inline-link"
            >
              <span>{{ section.settings.blog_button_text }}</span>
              <b aria-hidden="true">↗</b>
            </a>
          {% endif %}
        </div>


        {% assign selected_blog = section.settings.blog %}

        {% if selected_blog != blank %}

          <div
            class="abb-blog-grid abb-blog-grid--{{ section.settings.blog_columns }}"
          >
            {% for article in selected_blog.articles limit: section.settings.blog_limit %}

              <article
                class="abb-blog-card abb-reveal"
                style="--abb-index: {{ forloop.index0 }};"
              >

                <div class="abb-blog-card__media">

                  {% if section.settings.show_blog_image and article.image != blank %}

                    <a
                      href="{{ article.url }}"
                      class="abb-blog-card__image-link"
                    >
                      {{
                        article.image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '600,800,1000,1200',
                          class: 'abb-blog-card__image',
                          alt: article.image.alt | default: article.title
                      }}
                    </a>

                  {% else %}

                    <a
                      href="{{ article.url }}"
                      class="abb-blog-card__image-link abb-blog-card__image-link--empty"
                      aria-label="{{ article.title }}"
                    >
                      <span>APEX LAB / JOURNAL</span>
                    </a>

                  {% endif %}

                  <div class="abb-blog-card__overlay"></div>

                  <div class="abb-blog-card__top">
                    <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

                    {% if article.tags.first != blank %}
                      <span>{{ article.tags.first }}</span>
                    {% else %}
                      <span>JOURNAL</span>
                    {% endif %}
                  </div>

                  <a
                    href="{{ article.url }}"
                    class="abb-blog-card__read"
                  >
                    <span>{{ section.settings.blog_button_text }}</span>
                    <b aria-hidden="true">↗</b>
                  </a>

                </div>


                <div class="abb-blog-card__content">

                  {% if section.settings.show_blog_title %}
                    <h3 class="abb-blog-card__title">
                      <a href="{{ article.url }}">
                        {{ article.title }}
                      </a>
                    </h3>
                  {% endif %}

                  {% if section.settings.show_blog_excerpt %}
                    <div class="abb-blog-card__excerpt">
                      {% if article.excerpt != blank %}
                        {{ article.excerpt | strip_html | truncate: 150 }}
                      {% else %}
                        {{ article.content | strip_html | truncate: 150 }}
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="abb-blog-card__meta">
                    <span>
                      {{ article.published_at | date: '%d %b %Y' }}
                    </span>
                    <span>PERFORMANCE JOURNAL</span>
                  </div>

                </div>

              </article>

            {% endfor %}
          </div>

        {% else %}

          <div class="abb-empty">
            <span class="abb-empty__number">00</span>
            <div>
              <strong>SELECT A BLOG</strong>
              <p>Select a blog from the Theme Editor to populate the journal.</p>
            </div>
          </div>

        {% endif %}

      </div>
    </section>
  {% endif %}

</section>


<script>
  (() => {
    const root = document.querySelector('[data-abb-section="{{ section.id }}"]');
    if (!root) return;

    const slider = root.querySelector('[data-abb-slider]');
    const track = root.querySelector('[data-abb-track]');
    const prev = root.querySelector('[data-abb-prev]');
    const next = root.querySelector('[data-abb-next]');
    const pagination = root.querySelector('[data-abb-pagination]');

    if (!slider || !track) return;

    let animationFrame = null;
    let lastTime = 0;
    let paused = false;
    let sequenceWidth = 0;
    let totalPages = 1;
    let originalCards = [];

    const getGap = () => {
      const styles = window.getComputedStyle(track);
      return parseFloat(styles.columnGap || styles.gap || '0') || 0;
    };

    const getOriginalCards = () =>
      Array.from(track.querySelectorAll('.abb-brand:not([data-marquee-clone="true"])'));

    const removeClones = () => {
      track.querySelectorAll('.abb-brand[data-marquee-clone="true"]').forEach((clone) => clone.remove());
    };

    const getSequenceWidth = () => {
      const cards = getOriginalCards();
      if (!cards.length) return 0;

      const gap = getGap();
      return cards.reduce((total, card) => total + card.getBoundingClientRect().width, 0)
        + Math.max(0, cards.length - 1) * gap;
    };

    const buildInfiniteTrack = () => {
      removeClones();
      originalCards = getOriginalCards();
      if (!originalCards.length) return;

      sequenceWidth = Math.max(1, getSequenceWidth());

      // Add enough repeated cards so the browser can scroll at least one full
      // original sequence even on very wide desktop screens.
      const minimumTrackWidth = slider.clientWidth + sequenceWidth + getGap();
      let safety = 0;

      while (track.scrollWidth < minimumTrackWidth && safety < 20) {
        originalCards.forEach((card) => {
          const clone = card.cloneNode(true);
          clone.dataset.marqueeClone = 'true';
          clone.removeAttribute('data-shopify-editor');
          track.appendChild(clone);
        });
        safety += 1;
      }

      totalPages = Math.max(1, Math.ceil(originalCards.length / 2));
    };

    const updatePagination = () => {
      if (!pagination) return;

      const activeIndex = Math.min(
        totalPages - 1,
        Math.floor(((slider.scrollLeft % sequenceWidth) / sequenceWidth) * totalPages)
      );

      pagination.querySelectorAll('.abb-pagination-dot').forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
    };

    const buildPagination = () => {
      if (!pagination) return;

      pagination.innerHTML = '';

      if (totalPages <= 1) {
        pagination.hidden = true;
        return;
      }

      pagination.hidden = false;

      for (let index = 0; index < totalPages; index += 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'abb-pagination-dot';
        dot.setAttribute('aria-label', `Go to brand group ${index + 1}`);

        dot.addEventListener('click', () => {
          paused = true;
          slider.scrollTo({
            left: (sequenceWidth / totalPages) * index,
            behavior: 'smooth'
          });
          window.setTimeout(() => { paused = false; }, 700);
        });

        pagination.appendChild(dot);
      }

      updatePagination();
    };

    const move = (direction) => {
      const card = originalCards[0];
      if (!card || !sequenceWidth) return;

      const distance = card.getBoundingClientRect().width + getGap();
      paused = true;

      let target = slider.scrollLeft + distance * direction;
      if (target < 0) target += sequenceWidth;
      if (target >= sequenceWidth) target -= sequenceWidth;

      slider.scrollTo({ left: target, behavior: 'smooth' });
      window.setTimeout(() => { paused = false; }, 700);
    };

    if (prev) prev.addEventListener('click', () => move(-1));
    if (next) next.addEventListener('click', () => move(1));

    {% if section.settings.brand_pause_on_hover %}
      slider.addEventListener('mouseenter', () => { paused = true; });
      slider.addEventListener('mouseleave', () => { paused = false; });
      slider.addEventListener('touchstart', () => { paused = true; }, { passive: true });
      slider.addEventListener('touchend', () => {
        window.setTimeout(() => { paused = false; }, 500);
      }, { passive: true });
    {% endif %}

    slider.addEventListener('scroll', updatePagination, { passive: true });

    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        move(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        move(1);
      }
    });

    const animate = (time) => {
      if (!lastTime) lastTime = time;
      const delta = Math.min(50, time - lastTime);
      lastTime = time;

      {% if section.settings.brand_autoplay %}
        if (!paused && sequenceWidth > 0) {
          const speed = {{ section.settings.brand_autoplay_speed | default: 5 }};
          const pixelsPerSecond = Math.max(12, 52 - (speed * 2.5));

          slider.scrollLeft += (pixelsPerSecond * delta) / 1000;

          if (slider.scrollLeft >= sequenceWidth) {
            slider.scrollLeft -= sequenceWidth;
          }
        }
      {% endif %}

      animationFrame = window.requestAnimationFrame(animate);
    };

    const initialize = () => {
      buildInfiniteTrack();
      buildPagination();
      lastTime = 0;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = window.requestAnimationFrame(animate);
    };

    const waitForImages = () => {
      const images = Array.from(track.querySelectorAll('img'));
      if (!images.length) {
        initialize();
        return;
      }

      Promise.all(images.map((image) => {
        if (image.complete) return Promise.resolve();
        return new Promise((resolve) => {
          image.addEventListener('load', resolve, { once: true });
          image.addEventListener('error', resolve, { once: true });
        });
      })).then(initialize);
    };

    window.setTimeout(waitForImages, 80);

    let resizeTimer;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(initialize, 150);
    }, { passive: true });

    const animated = root.querySelectorAll('.abb-reveal');
    if (!('IntersectionObserver' in window)) {
      animated.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.08 });

      animated.forEach((item) => observer.observe(item));
    }
  })();
</script>


{% stylesheet %}

/* ==========================================================
   APEX LAB — BRANDS + BLOG
========================================================== */

.atomic-brands-blog {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #F7F6F3;
  color: var(--abb-heading);
}

.atomic-brands-blog,
.atomic-brands-blog * {
  box-sizing: border-box;
}

.abb-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: var(--abb-grid-opacity);

  background-image:
    linear-gradient(
      rgba(2,101,242,.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(2,101,242,.035) 1px,
      transparent 1px
    );

  background-size: 52px 52px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 90%
    );
}

.abb-container {
  position: relative;
  z-index: 2;
  width: min(
    var(--abb-max-width),
    calc(100% - 48px)
  );
  margin: 0 auto;
}

/* ==========================================================
   SHARED HEADER
========================================================== */

.abb-section-header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 50px;

  padding-bottom: 28px;

  border-bottom:
    1px solid
    rgba(7,24,43,.12);
}

.abb-section-header--blog {
  margin-bottom: 34px;
}

.abb-kicker {
  display: flex;
  align-items: center;
  gap: 10px;

  margin: 0 0 14px;

  color: var(--abb-accent);

  font-size: 9px;
  line-height: 1;
  font-weight: 800;

  letter-spacing: .18em;
  text-transform: uppercase;
}

.abb-kicker span {
  width: 27px;
  height: 1px;
  background: currentColor;
}

.abb-heading {
  margin: 0;

  font-family:
    "Russo One",
    sans-serif !important;

  font-size:
    clamp(
      42px,
      5vw,
      72px
    );

  line-height: .94;
  font-weight: 400;

  letter-spacing: -.025em;
  text-transform: uppercase;

  color:
    var(--abb-heading) !important;

  text-align: left;
}

.abb-description {
  max-width: 470px;

  margin-top: 17px;

  color:
    var(--abb-muted);

  font-size: 13px;
  line-height: 1.75;
}

.abb-description p {
  margin: 0;
}

.abb-header-meta {
  min-width: 120px;

  padding-left: 18px;

  border-left:
    1px solid
    rgba(7,24,43,.12);
}

.abb-header-meta strong {
  display: block;

  color:
    var(--abb-accent);

  font-size: 44px;
  line-height: .85;

  letter-spacing: -.05em;
}

.abb-header-meta span {
  display: block;

  margin-top: 8px;

  color:
    rgba(7,24,43,.46);

  font-size: 8px;
  line-height: 1.3;

  font-weight: 800;

  letter-spacing: .13em;
  text-transform: uppercase;
}

/* ==========================================================
   BRANDS — MINIMAL HORIZONTAL BRAND STRIP
   UI redesign only:
   - Existing Liquid blocks remain unchanged
   - Existing links remain unchanged
   - Existing autoplay / loop / arrows / pagination remain unchanged
========================================================== */

.abb-brands {
  position: relative;
  padding: 54px 0 46px;
}

.abb-brands-slider-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.abb-brands-slider {
  width: 100%;
  display: flex;
  align-items: stretch;
  gap: var(--abb-brand-gap);
  overflow-x: auto;
  scroll-behavior: auto;
  scrollbar-width: none;
  scroll-snap-type: none;
  padding: 0 2px 4px;
}

.abb-brands-slider::-webkit-scrollbar {
  display: none;
}

.abb-brand-track {
  display: flex;
  align-items: stretch;
  gap: var(--abb-brand-gap);
  width: max-content;
  min-width: 100%;
}


@media screen and (min-width: 990px) {
  .abb-brand {
    flex-basis: clamp(145px, 15vw, var(--abb-brand-card-width));
  }
}

/* ==========================================================
   BRAND CARDS — KEEP EDITOR-UPLOADED LOGOS VISIBLE
========================================================== */

.abb-brand {
  position: relative;
  flex: 0 0 var(--abb-brand-card-width);
  min-width: 0;
  height: var(--abb-brand-card-height);
  overflow: hidden;
  background: transparent;
  scroll-snap-align: none;
}

.abb-brand__link {
  width: 100%;
  height: 100%;
  min-height: var(--abb-brand-card-height);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  color: inherit;
  text-decoration: none;
}

.abb-brand__top,
.abb-brand__bottom {
  display: none;
}

.abb-brand__visual {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.abb-brand__image {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: calc(var(--abb-brand-card-height) - 20px);
  object-fit: contain;
  object-position: center;
}

.abb-brand__name {
  display: block;
  color: var(--abb-heading);
  font-size: clamp(12px, 1.05vw, 17px);
  font-weight: 800;
  letter-spacing: .16em;
  line-height: 1.2;
  text-align: center;
  text-transform: uppercase;
}

.abb-brand:hover .abb-brand__image {
  transform: scale(1.04);
}

.abb-brand__image {
  transition: transform .3s ease;
}

/* ==========================================================
   BRAND PAGINATION
========================================================== */

.abb-brand-pagination {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 7px;

  min-height: 6px;

  margin-top: 14px;
}

.abb-pagination-dot {
  width: 6px;
  height: 6px;

  padding: 0;

  border: 0;
  border-radius: 999px;

  background:
    rgba(7,24,43,.20);

  cursor: pointer;

  transition:
    width .25s ease,
    background .25s ease,
    transform .25s ease;
}

.abb-pagination-dot:hover {
  transform:
    scale(1.2);

  background:1B2A5B;
}

.abb-pagination-dot.is-active {
  width: 20px;

  background:
    var(--abb-accent);
}

/* ==========================================================
   ARROWS
========================================================== */

.abb-arrow {
  position: absolute;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 50%;
  top: 50%;
  z-index: 4;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border:
    1px solid
    rgba(7,24,43,.14);
  background:
    rgba(255,255,255,.96);
  color:
    var(--abb-heading);
  font-size: 18px;
  cursor: pointer;
  transform:
    translateY(-50%);
  transition:
    background .25s ease,
    color .25s ease,
    border-color .25s ease,
    transform .25s ease;
}

.abb-arrow:hover {
  background:1B2A5B;

  border-color:1B2A5B;

  color:
    #ffffff;

  transform:
    translateY(-50%)
    scale(1.04);
}

.abb-arrow--prev {
  left: -16px;
}

.abb-arrow--next {
  right: -16px;
}

/* ==========================================================
   BUTTONS
========================================================== */

.abb-button-wrap {
  display: flex;

  justify-content: center;

  margin-top: 25px;
}

.abb-button {
  position: relative;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 22px;

  min-width: 195px;
  min-height: 46px;

  padding: 0 19px;

  overflow: hidden;

  background:
    var(--abb-button);

  color:
    var(--abb-button-text);

  border:
    1px solid
    var(--abb-button);

  text-decoration: none;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .14em;
  text-transform: uppercase;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}

.abb-button b {
  font-size: 16px;
  font-weight: 400;

  transition:
    transform .25s ease;
}

.abb-button:hover {
  background:#111;

  color:var(--abb-button-text);

  transform:translateY(-3px);
}

.abb-button:hover b {
  transform:
    translate(
      3px,
      -3px
    );
}

.abb-inline-link {
  display: inline-flex;

  align-items: center;

  gap: 12px;

  color:
    var(--abb-heading);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .13em;

  text-decoration: none;

  text-transform: uppercase;
}

.abb-inline-link b {
  color:
    var(--abb-accent);

  font-size: 16px;

  font-weight: 400;
}

.abb-inline-link:hover {
  color:
    var(--abb-accent);
}

/* ==========================================================
   BLOG
========================================================== */

.abb-blog {
  position: relative;

  padding:
    66px 0 82px;

  background:
    var(--abb-panel);

  border-top:
    1px solid
    rgba(7,24,43,.08);
}

.abb-blog-grid {
  display: grid;

  gap:
    var(--abb-blog-gap);
}

.abb-blog-grid--2 {
  grid-template-columns:
    repeat(2,minmax(0,1fr));
}

.abb-blog-grid--3 {
  grid-template-columns:
    repeat(3,minmax(0,1fr));
}

.abb-blog-grid--4 {
  grid-template-columns:
    repeat(4,minmax(0,1fr));
}

.abb-blog-card {
  min-width: 0;

  overflow: hidden;

  border:
    1px solid
    var(--abb-card-border);

  background:
    #ffffff;

  opacity: 0;

  transform:
    translateY(22px);

  transition:
    opacity .7s ease,
    transform .7s cubic-bezier(.22,.61,.36,1),
    box-shadow .4s ease,
    border-color .3s ease;
}

.abb-blog-card.is-visible {
  opacity: 1;

  transform: none;

  transition-delay:
    calc(var(--abb-index) * 70ms);
}

.abb-blog-card:hover {
  border-color:
    rgba(2,101,242,.34);

  box-shadow:
    0 20px 55px
    rgba(7,24,43,.10);
}

.abb-blog-card__media {
  position: relative;

  height:
    var(--abb-blog-media-height);

  aspect-ratio:
    auto;

  overflow: hidden;

  background:
    #0A1220;
}

.abb-blog-card__image-link {
  position: absolute;

  inset: 0;

  display: block;

  overflow: hidden;
}

.abb-blog-card__image-link--empty {
  display: grid;
  place-items: center;

  color:
    rgba(255,255,255,.56);

  text-decoration: none;

  background:
    linear-gradient(
      145deg,
      #071329,
      #0b1d4f
    );

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .17em;

  text-transform: uppercase;
}

.abb-blog-card__image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transform:
    scale(1.02);

  filter:
    saturate(.82)
    contrast(1.04)
    brightness(.88);

  transition:
    transform .7s cubic-bezier(.22,.61,.36,1),
    filter .45s ease;
}

.abb-blog-card:hover .abb-blog-card__image {
  transform:
    scale(1.07);

  filter:
    saturate(1)
    contrast(1.05)
    brightness(.96);
}

.abb-blog-card__overlay {
  position: absolute;

  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.82),
      rgba(0,0,0,.06) 70%
    );
}

.abb-blog-card__top {
  position: absolute;

  top: 13px;
  left: 13px;
  right: 13px;

  z-index: 2;

  display: flex;

  justify-content: space-between;

  gap: 12px;

  color:
    rgba(255,255,255,.62);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .13em;

  text-transform: uppercase;
}

.abb-blog-card__top span:first-child {
  color:
    #ffffff;
}

.abb-blog-card__read {
  position: absolute;

  right: 13px;
  bottom: 13px;

  z-index: 3;

  display: inline-flex;

  align-items: center;

  gap: 11px;

  color:
    #ffffff;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .12em;

  text-decoration: none;

  text-transform: uppercase;
}

.abb-blog-card__read b {
  color:
    var(--abb-accent);

  font-size: 15px;

  font-weight: 400;

  transition:
    transform .25s ease;
}

.abb-blog-card:hover .abb-blog-card__read b {
  transform:
    translate(
      3px,
      -3px
    );
}

.abb-blog-card__content {
  padding:
    17px 17px 18px;
}

.abb-blog-card__title {
  margin: 0;

  font-size:
    clamp(
      18px,
      1.7vw,
      24px
    );

  line-height: 1.08;

  font-weight: 800;

  letter-spacing: -.02em;
}

.abb-blog-card__title a {
  color:
    var(--abb-heading);

  text-decoration: none;

  transition:
    color .25s ease;
}

.abb-blog-card__title a:hover {
  color:
    var(--abb-accent);
}

.abb-blog-card__excerpt {
  margin-top: 9px;

  color:
    var(--abb-muted);

  font-size: 12px;

  line-height: 1.65;
}

.abb-blog-card__meta {
  display: flex;

  justify-content: space-between;

  gap: 10px;

  padding-top: 15px;
  margin-top: 16px;

  border-top:
    1px solid
    rgba(7,24,43,.09);

  color:
    rgba(7,24,43,.43);

  font-size: 7px;

  font-weight: 800;

  letter-spacing: .12em;

  text-transform: uppercase;
}

/* ==========================================================
   REVEAL
========================================================== */

.abb-reveal {
  opacity: 0;

  transform:
    translateY(22px);

  transition:
    opacity .7s ease,
    transform .7s cubic-bezier(.22,.61,.36,1);
}

.abb-reveal.is-visible {
  opacity: 1;

  transform: none;
}

.abb-empty {
  display: flex;

  align-items: center;

  gap: 18px;

  padding:
    38px 20px;

  border:
    1px dashed
    rgba(7,24,43,.18);
}

.abb-empty__number {
  color:
    var(--abb-accent);

  font-size:
    32px;

  font-weight: 800;

  letter-spacing: -.05em;
}

.abb-empty strong {
  display: block;

  font-size: 14px;
  font-weight: 800;

  letter-spacing: .1em;
}

.abb-empty p {
  margin:
    7px 0 0;

  color:
    var(--abb-muted);

  font-size: 12px;
}

/* ==========================================================
   TABLET
========================================================== */

@media screen and (max-width: 989px) {

  .abb-section-header {
    grid-template-columns:
      1fr;

    gap: 20px;
  }

  .abb-header-meta {
    width: fit-content;

    padding-left: 0;

    padding-top: 14px;

    border-left: 0;

    border-top:
      1px solid
      rgba(7,24,43,.12);
  }

  .abb-blog-grid--4 {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .abb-arrow--prev {
    left: -8px;
  }

  .abb-arrow--next {
    right: -8px;
  }
}

/* ==========================================================
   MOBILE
========================================================== */

@media screen and (max-width: 749px) {

  .abb-container {
    width:
      calc(100% - 28px);
  }

  .abb-brands {
    padding:
      50px 0 45px;
  }

  .abb-blog {
    padding:
      48px 0 58px;
  }

  .abb-heading {
    font-size:
      39px;
  }

  .abb-description {
    font-size:
      12px;
  }

  .abb-brands-slider {
    gap:
      0;

    padding:
      0 0 8px;
  }

  .abb-brand-track {
    gap:
      var(--abb-brand-gap);
  }

  .abb-brand {
    flex-basis:
      170px;

    min-height:
      150px;
  }

  .abb-brand__link {
    min-height:
      150px;
  }

  .abb-arrow {
    display:
      none;
  }

  .abb-blog-grid--2,
  .abb-blog-grid--3,
  .abb-blog-grid--4 {
    grid-template-columns:
      1fr;
  }

  .abb-blog-card__title {
    font-size:
      17px;
  }

  .abb-section-header--blog {
    margin-bottom:
      27px;
  }

  .abb-inline-link {
    margin-top:
      4px;
  }
}

{% endstylesheet %}


