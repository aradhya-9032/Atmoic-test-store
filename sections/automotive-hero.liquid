{% liquid
  assign slide_count = section.blocks.size
%}

<section
  id="AutomotiveHero-{{ section.id }}"
  class="automotive-hero"
  style="--hero-height: {{ section.settings.height }}px;
  --hero-mobile-height: {{ section.settings.mobile_height }}px;
  --slide-duration: {{ section.settings.autoplay_speed }}s;
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>

  <div class="automotive-hero__slider">
    {% for block in section.blocks %}
      <div class="automotive-hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>

        {% if block.settings.image != blank %}
          <div class="automotive-hero__image">
            {{ block.settings.image
              | image_url: width: 3840
              | image_tag: widths: '750, 1200, 1600, 1920, 2560, 3840',
                sizes: '100vw',
                loading: 'eager',
                alt: block.settings.image.alt }}
          </div>
        {% else %}
          <div class="automotive-hero__image automotive-hero__image--placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.overlay %}
          <div class="automotive-hero__overlay"
            style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};">
          </div>
        {% endif %}

        <div class="automotive-hero__content automotive-hero__content--{{ block.settings.content_position }}">
          {% if block.settings.logo != blank %}
            {{ block.settings.logo
              | image_url: width: 700
              | image_tag: class: 'automotive-hero__logo',
                widths: '250, 400, 550, 700',
                sizes: '(max-width: 749px) 60vw, 35vw',
                alt: block.settings.logo.alt }}
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="automotive-hero__text">{{ block.settings.text }}</div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link | default: '#' }}" class="automotive-hero__button">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if slide_count > 1 and section.settings.show_arrows %}
    <button type="button" class="automotive-hero__arrow automotive-hero__arrow--prev" aria-label="Previous slide">‹</button>
    <button type="button" class="automotive-hero__arrow automotive-hero__arrow--next" aria-label="Next slide">›</button>
  {% endif %}

  {% if slide_count > 1 and section.settings.show_dots %}
    <div class="automotive-hero__dots" role="tablist">
      {% for block in section.blocks %}
        <button type="button"
          class="automotive-hero__dot{% if forloop.first %} is-active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}">
        </button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
.automotive-hero {
  position: relative;
  width: 100%;
  height: var(--hero-height);
  overflow: hidden;
  background: #111;
}
.automotive-hero__slider {
  position: relative;
  width: 100%;
  height: 100%;
}
.automotive-hero__slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity .5s ease;
}
.automotive-hero__slide.is-active {
  position: relative;
  opacity: 1;
  visibility: visible;
  z-index: 2;
}
.automotive-hero__image,
.automotive-hero__image img,
.automotive-hero__image svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.automotive-hero__image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}
.automotive-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: #000;
  opacity: var(--overlay-opacity);
}
.automotive-hero__content {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
  padding: 50px;
  max-width: 700px;
}
.automotive-hero__content--left {
  left: 0;
  align-items: flex-start;
  text-align: left;
}
.automotive-hero__content--center {
  left: 50%;
  transform: translateX(-50%);
  align-items: center;
  text-align: center;
}
.automotive-hero__content--right {
  right: 0;
  align-items: flex-end;
  text-align: right;
}
.automotive-hero__logo {
  width: min(360px, 70vw);
  height: auto;
}
.automotive-hero__content h2 {
  margin: 0;
  color: #fff;
  font-size: clamp(28px, 4vw, 58px);
  line-height: 1.05;
}
.automotive-hero__text {
  color: #fff;
  font-size: 18px;
}
.automotive-hero__button {
  display: inline-flex;
  padding: 10px 24px;
  border: 1px solid #fff;
  background: #fff;
  color: #111;
  text-decoration: none;
  font-weight: 600;
}
.automotive-hero__arrow {
  display: none !important;
  position: absolute;
  top: 50%;
  z-index: 5;
  width: 42px;
  height: 42px;
  border: 1px solid #fff;
  border-radius: 50%;
  background: rgb(0 0 0 / 35%);
  color: #fff;
  font-size: 30px;
  cursor: pointer;
  transform: translateY(-50%);
}
.automotive-hero__arrow--prev { left: 20px; }
.automotive-hero__arrow--next { right: 20px; }

.automotive-hero__dots {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;

  display: flex;
  gap: 18px;
}

.automotive-hero__dot {
  position: relative;
  width: 80px;
  height: 3px;

  padding: 0;
  border: 0;

  background: rgba(255, 255, 255, 0.35);

  overflow: hidden;
  cursor: pointer;
}

.automotive-hero__dot::after {
  content: '';

  position: absolute;
  left: 0;
  top: 0;

  width: 0;
  height: 100%;

  background: #ffffff;
}

.automotive-hero__dot.is-active::after {
  animation: heroProgress var(--slide-duration) linear forwards;
}

@keyframes heroProgress {
  from {
    width: 0;
  }

  to {
    width: 100%;
  }
}

@media screen and (max-width: 749px) {
  .automotive-hero {
    height: var(--hero-mobile-height);
  }

  .automotive-hero__content {
    padding: 30px 22px;
    max-width: 100%;
  }

  .automotive-hero__content h2 {
    font-size: 32px;
  }

  .automotive-hero__image img {
    object-fit: contain;
  }
  .automotive-hero__content h2 { font-size: 32px; }
}
{% endstylesheet %}

<script>
(() => {
  const init = (section) => {
    if (!section || section.dataset.initialized === 'true') return;

    const slides = [...section.querySelectorAll('.automotive-hero__slide')];
    const dots = [...section.querySelectorAll('.automotive-hero__dot')];
    const prev = section.querySelector('.automotive-hero__arrow--prev');
    const next = section.querySelector('.automotive-hero__arrow--next');

    if (slides.length <= 1) return;

    section.dataset.initialized = 'true';
    let current = 0;
    let timer;

    const show = (index) => {
        current = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
            slide.classList.toggle('is-active', i === current);
        });

        dots.forEach((dot, i) => {
            dot.classList.remove('is-active');

            if (i === current) {
            void dot.offsetWidth;
            dot.classList.add('is-active');
            }
        });
    };

    const start = () => {
      clearInterval(timer);
      if (section.dataset.autoplay === 'true') {
        timer = setInterval(() => show(current + 1),
          Number(section.dataset.speed) || 5000);
      }
    };

    prev?.addEventListener('click', () => { show(current - 1); start(); });
    next?.addEventListener('click', () => { show(current + 1); start(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));

    section.addEventListener('mouseenter', () => clearInterval(timer));
    section.addEventListener('mouseleave', start);
    start();
  };

  const run = () => document.querySelectorAll('.automotive-hero').forEach(init);
  run();
  document.addEventListener('shopify:section:load', run);
})();
</script>

{% schema %}
{
  "name": "Automotive Hero Slider",
  "tag": "section",
  "class": "automotive-hero-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slide image" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Automotive Performance" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Performance parts built for your vehicle.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "checkbox", "id": "overlay", "label": "Image overlay", "default": true },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Automotive Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
