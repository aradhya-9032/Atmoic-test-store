<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

<header-component
  class="apex-header"
  data-sticky="{{ section.settings.sticky }}"
>
  <div class="apex-header__inner">

    <!-- =====================================
      LEFT SIDE
    ====================================== -->
    <div class="apex-header__left">

      <!-- CATEGORIES -->
      <div class="apex-header__categories">

        <button
          class="apex-header__categories-btn"
          type="button"
          aria-expanded="false"
          aria-controls="ApexCategoriesMenu-{{ section.id }}"
        >
          <span>Categories</span>

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 9l6 6 6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>


        <!-- CATEGORIES DROPDOWN -->
        <div
          id="ApexCategoriesMenu-{{ section.id }}"
          class="apex-header__categories-menu"
        >
          {% if section.settings.menu != blank %}

            {% for link in section.settings.menu.links %}

              <div class="apex-header__category-item">

                <a href="{{ link.url }}">

                  <span>{{ link.title }}</span>

                  {% if link.links != blank %}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M9 18l6-6-6-6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  {% endif %}

                </a>


                <!-- SUB CATEGORIES -->
                {% if link.links != blank %}

                  <div class="apex-header__subcategory-menu">

                    {% for child in link.links %}

                      <a href="{{ child.url }}">
                        {{ child.title }}
                      </a>

                    {% endfor %}

                  </div>

                {% endif %}

              </div>

            {% endfor %}

          {% endif %}
        </div>

      </div>


      <!-- NEW ARRIVALS -->
      <a
        class="apex-header__new-arrivals"
        href="{{ routes.all_products_collection_url }}?sort_by=created-descending"
      >
        New arrivals
      </a>


      <!-- SEARCH -->
      <form
        class="apex-header__search"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="11"
            cy="11"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.8"
          />

          <path
            d="M16 16l4 4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>

        <input
          type="search"
          name="q"
          placeholder="Search parts..."
          aria-label="Search parts"
        >

        <input
          type="hidden"
          name="type"
          value="product"
        >

      </form>

    </div>


    <!-- =====================================
      CENTER LOGO
    ====================================== -->
    <a
      class="apex-header__logo"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name }}"
    >

      <img
        src="{{ 'apex-black-horizontal.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        loading="eager"
        width="220"
        height="50"
      >

    </a>


    <!-- =====================================
      RIGHT SIDE ACTIONS
    ====================================== -->
    <div class="apex-header__actions">


      <!-- ==========================
        ACCOUNT
        SHOPIFY DEFAULT FUNCTIONALITY
      =========================== -->
      {% if shop.customer_accounts_enabled %}

        <div class="apex-header__account-wrap">

          <shopify-account>

            {% if customer %}

              <div class="account-button__fallback"></div>

            {% else %}

              <span
                slot="signed-out-avatar"
                class="apex-header__account-icon"
                aria-hidden="true"
              >

                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                >

                  <circle
                    cx="12"
                    cy="8"
                    r="3.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />

                  <path
                    d="M4.5 20c.7-3.8 3.5-5.8 7.5-5.8s6.8 2 7.5 5.8"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />

                </svg>

              </span>

            {% endif %}

          </shopify-account>

        </div>

      {% endif %}


      <!-- ==========================
        WISHLIST
        EXISTING FUNCTIONALITY
      =========================== -->
      <button
        type="button"
        class="apex-header__wishlist automotive-wishlist automotive-wishlist__trigger"
        aria-label="Wishlist"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="AutomotiveWishlistDrawer"
        data-wishlist-trigger
      >

        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <span class="apex-header__wishlist-text">
          Wishlist
        </span>

        <span
          class="apex-header__count"
          data-wishlist-count
          aria-live="polite"
        >
          0
        </span>

      </button>


      <!-- ==========================
        CART
        SHOPIFY DRAWER FUNCTIONALITY
      =========================== -->

      {% capture apex_cart_content %}

        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <path
            d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L20.5 8H6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <circle
            cx="9"
            cy="20"
            r="1.2"
            fill="currentColor"
          />

          <circle
            cx="18"
            cy="20"
            r="1.2"
            fill="currentColor"
          />

        </svg>


        <span class="apex-header__cart-text">
          Cart
        </span>


        <cart-icon
          class="apex-header__cart-count"
          data-testid="cart-icon"
        >

          {% render 'cart-bubble', limit: 100 %}

        </cart-icon>

      {% endcapture %}


      {% if settings.cart_type == 'drawer' and template.name != 'cart' %}

        <button
          type="button"
          class="apex-header__cart"
          on:click="#cart-drawer/toggle"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="cart-drawer"
          aria-label="{{ 'accessibility.cart' | t }}"
          aria-describedby="cart-bubble-text"
          data-testid="cart-drawer-trigger"
        >

          {{ apex_cart_content }}

        </button>

      {% else %}

        <a
          class="apex-header__cart"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'accessibility.cart' | t }}"
          aria-describedby="cart-bubble-text"
        >

          {{ apex_cart_content }}

        </a>

      {% endif %}


      <!-- MOBILE MENU -->
      <button
        class="apex-header__menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="ApexMobileNavigation-{{ section.id }}"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>


  <!-- =====================================
    MOBILE NAVIGATION
  ====================================== -->
  <nav
    id="ApexMobileNavigation-{{ section.id }}"
    class="apex-header__mobile-nav"
    aria-label="Mobile navigation"
  >

    {% for link in section.settings.menu.links %}

      <div class="apex-header__mobile-item">

        <a href="{{ link.url }}">
          {{ link.title }}
        </a>


        {% if link.links != blank %}

          <div class="apex-header__mobile-children">

            {% for child in link.links %}

              <a href="{{ child.url }}">
                {{ child.title }}
              </a>

            {% endfor %}

          </div>

        {% endif %}

      </div>

    {% endfor %}

  </nav>

</header-component>


<script>
(() => {

  const header = document.currentScript.previousElementSibling;

  if (!header) return;


  /* =====================================
     ELEMENTS
  ====================================== */

  const categoriesButton = header.querySelector(
    '.apex-header__categories-btn'
  );

  const categoriesMenu = header.querySelector(
    '.apex-header__categories-menu'
  );

  const menuButton = header.querySelector(
    '.apex-header__menu'
  );

  const mobileNav = header.querySelector(
    '.apex-header__mobile-nav'
  );


  /* =====================================
     CLOSE CATEGORIES
  ====================================== */

  function closeCategories() {

    if (!categoriesButton || !categoriesMenu) return;

    categoriesButton.setAttribute(
      'aria-expanded',
      'false'
    );

    categoriesMenu.classList.remove('is-open');

  }


  /* =====================================
     CATEGORIES CLICK
  ====================================== */

  categoriesButton?.addEventListener('click', (event) => {

    event.stopPropagation();

    const isOpen =
      categoriesButton.getAttribute('aria-expanded') === 'true';

    categoriesButton.setAttribute(
      'aria-expanded',
      String(!isOpen)
    );

    categoriesMenu?.classList.toggle(
      'is-open',
      !isOpen
    );

  });


  /* =====================================
     CLOSE ON OUTSIDE CLICK
  ====================================== */

  document.addEventListener('click', (event) => {

    if (!header.contains(event.target)) {
      closeCategories();
    }

  });


  /* =====================================
     MOBILE MENU
  ====================================== */

  menuButton?.addEventListener('click', () => {

    const isOpen =
      menuButton.getAttribute('aria-expanded') === 'true';

    menuButton.setAttribute(
      'aria-expanded',
      String(!isOpen)
    );

    mobileNav?.classList.toggle(
      'is-open',
      !isOpen
    );

  });


  /* =====================================
     ESCAPE
  ====================================== */

  document.addEventListener('keydown', (event) => {

    if (event.key !== 'Escape') return;

    closeCategories();

    mobileNav?.classList.remove('is-open');

    menuButton?.setAttribute(
      'aria-expanded',
      'false'
    );

  });


})();
</script>


{% stylesheet %}

/* =========================================
   APEX LAB HEADER
   CUSTOM UI + SHOPIFY FUNCTIONALITY
========================================= */

.apex-header {
  --apex-navy: #2d405f;
  --apex-navy-hover: #243653;
  --apex-text: #303946;
  --apex-border: #d6d9de;
  --apex-bg: #f7f7f6;

  width: 100%;
  position: relative;
  z-index: 100;

  background: var(--apex-bg);
  border-bottom: 1px solid #e2e3e5;
}

.apex-header[data-sticky="true"] {
  position: sticky;
  top: 0;
}


/* =========================================
   MAIN LAYOUT
========================================= */

.apex-header__inner {
  width: 100%;
  max-width: 1600px;
  min-height: 108px;

  margin: 0 auto;
  padding: 0 32px;

  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);

  align-items: center;
  column-gap: 32px;
}


/* =========================================
   LEFT
========================================= */

.apex-header__left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}


/* =========================================
   CATEGORIES BUTTON
========================================= */

.apex-header__categories {
  position: relative;
  flex-shrink: 0;
}

.apex-header__categories-btn {
  padding: 14px 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  border: 0;
  border-radius: 999px;

  background: #1B2A5B;
  color: #fff;

  font-family: inherit;
  font-size: 16px;
  font-weight: 700;

  cursor: pointer;
  white-space: nowrap;
}

.apex-header__categories-btn:hover {
  background: var(--apex-navy-hover);
}

.apex-header__categories-btn svg {
  transition: transform .2s ease;
}

.apex-header__categories-btn[aria-expanded="true"] svg {
  transform: rotate(180deg);
}


/* =========================================
   NEW ARRIVALS
========================================= */

.apex-header__new-arrivals {
  padding: 10px 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--apex-border);
  border-radius: 999px;

  color: var(--apex-text);
  text-decoration: none;

  font-size: 16px;
  font-weight: 600;

  white-space: nowrap;
}

.apex-header__new-arrivals:hover {
  background: #fff;
}


/* =========================================
   SEARCH
========================================= */

.apex-header__search {
  width: 235px;

  padding: 10px 20px;

  display: flex;
  align-items: center;
  gap: 11px;

  border: 1px solid var(--apex-border);
  border-radius: 999px;

  background: transparent;
}

.apex-header__search:focus-within {
  background: #fff;
  border-color: #aeb5bf;
}

.apex-header__search svg {
  flex-shrink: 0;
  color: #596473;
}

.apex-header__search input {
  width: 100%;
  min-width: 0;

  padding: 0;

  border: 0;
  outline: none;

  background: transparent;
  color: var(--apex-text);

  font: inherit;
  font-size: 16px;
}


/* =========================================
   LOGO
========================================= */

.apex-header__logo {
  width: 170px;

  display: flex;
  align-items: center;
  justify-content: center;

  justify-self: center;

  text-decoration: none;
}

.apex-header__logo img {
  display: block;
  width: 100%;
  max-width: 180px;
  height: auto;
  max-height: 42px;
  object-fit: contain;
}


/* =========================================
   ACTIONS
========================================= */

.apex-header__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 10px;
}


/* =========================================
   ACCOUNT - SHOPIFY COMPONENT
========================================= */

.apex-header__account-wrap {
  position: relative;

  width: 56px;
  height: 56px;

  flex: 0 0 56px;
}

.apex-header__account-wrap shopify-account {
  width: 56px;
  height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.apex-header__account-wrap shopify-account::after {
  content: "✓";

  position: absolute;

  top: -2px;
  right: -2px;

  width: 18px;
  height: 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #36754d;
  color: #fff;

  border: 2px solid var(--apex-bg);

  font-size: 11px;
  font-weight: 800;

  pointer-events: none;
}

.apex-header__account-wrap shopify-account button,
.apex-header__account-wrap .account-button,
.apex-header__account-icon {
  width: 56px;
  height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--apex-border);
  border-radius: 50%;

  background: transparent;
  color: var(--apex-text);
}

.apex-header__account-icon {
  box-sizing: border-box;
}


/* =========================================
   WISHLIST
========================================= */

.apex-header__wishlist {
  height: 54px;
  padding: 0 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  border: 1px solid var(--apex-border);
  border-radius: 999px;

  background: transparent;
  color: var(--apex-text);

  font-family: inherit;
  font-size: 15px;
  font-weight: 600;

  cursor: pointer;
}

.apex-header__wishlist:hover {
  background: #fff;
}

.apex-header__wishlist svg {
  flex-shrink: 0;
}

.apex-header__count {
  min-width: 30px;
  height: 30px;

  padding: 0 8px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: #eceef1;
  color: #344052;

  font-size: 13px;
  font-weight: 700;
}


/* =========================================
   CART
========================================= */

.apex-header__cart {
  height: 54px;
  padding: 0 24px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  border: 0;
  border-radius: 999px;

  background: #1B2A5B;
  color: #fff;

  font-family: inherit;
  font-size: 16px;
  font-weight: 700;

  text-decoration: none;
  cursor: pointer;

  white-space: nowrap;
}

.apex-header__cart:hover {
  background: var(--apex-navy-hover);
}

.apex-header__cart-count {
  min-width: 30px;
  height: 30px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  position: relative;

  border-radius: 50%;

  background: #e9ebee;
  color: #1B2A5B
}

.apex-header__cart-count .cart-bubble {
  position: static !important;

  display: flex;
  align-items: center;
  justify-content: center;

  min-width: 100%;
  height: 100%;

  background: transparent !important;
  color: inherit !important;
}

.apex-header__cart-count .cart-bubble__text {
  font-size: 13px;
  font-weight: 800;
}


/* =========================================
   CATEGORY DROPDOWN
========================================= */

.apex-header__categories-menu {
  position: absolute;

  top: calc(100% + 12px);
  left: 0;

  width: 280px;

  padding: 10px;

  background: #fff;

  border: 1px solid #e3e5e8;
  border-radius: 16px;

  box-shadow: 0 20px 50px rgba(0, 0, 0, .12);

  opacity: 0;
  visibility: hidden;

  transform: translateY(-8px);

  transition: .2s ease;

  z-index: 500;
}

.apex-header__categories-menu.is-open {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}

.apex-header__category-item {
  position: relative;
}

.apex-header__category-item > a {
  min-height: 48px;

  padding: 0 14px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-radius: 10px;

  color: var(--apex-text);
  text-decoration: none;

  font-size: 15px;
  font-weight: 600;
}

.apex-header__category-item > a:hover {
  background: #f3f5f7;
}


/* SUB CATEGORIES */

.apex-header__subcategory-menu {
  display: none;

  padding: 5px 0 10px 18px;
}

.apex-header__category-item:hover .apex-header__subcategory-menu {
  display: grid;
}

.apex-header__subcategory-menu a {
  padding: 8px 10px;

  color: #697383;
  text-decoration: none;

  font-size: 14px;

  border-radius: 8px;
}

.apex-header__subcategory-menu a:hover {
  background: #f3f5f7;
}


/* =========================================
   MOBILE MENU
========================================= */

.apex-header__menu {
  display: none;

  width: 48px;
  height: 48px;

  padding: 0;

  border: 1px solid var(--apex-border);
  border-radius: 12px;

  background: #fff;

  cursor: pointer;
}

.apex-header__menu span {
  display: block;

  width: 21px;
  height: 2px;

  margin: 5px auto;

  background: var(--apex-text);
}


/* =========================================
   MOBILE NAV
========================================= */

.apex-header__mobile-nav {
  display: none;
}


/* =========================================
   TABLET
========================================= */

@media screen and (max-width: 1450px) {

  .apex-header__inner {
    padding: 0 24px;
    column-gap: 20px;
  }

  .apex-header__left {
    gap: 10px;
  }

  .apex-header__categories-btn {
    padding: 20px 22px;
  }

  .apex-header__new-arrivals {
    padding: 10px 20px;
  }

  .apex-header__search {
    width: 205px;
  }

  .apex-header__wishlist {
    padding: 0 15px;
  }

  .apex-header__cart {
    padding: 0 19px;
  }

}


@media screen and (max-width: 1200px) {

  .apex-header__inner {
    padding: 10px 18px;
    column-gap: 15px;
  }

  .apex-header__search {
    width: 170px;
  }

  .apex-header__new-arrivals {
    padding: 10px 15px;
  }

  .apex-header__categories-btn {
    padding: 14social-linkspx 18px;
  }

  .apex-header__wishlist-text {
    display: none;
  }

  .apex-header__wishlist {
    width: 54px;
    padding: 0;
  }

}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 900px) {

  .apex-header__inner {
    min-height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 16px;
  }

  .apex-header__left {
    display: none;
  }

  .apex-header__logo {
    width: 145px;

    justify-content: flex-start;
  }

  .apex-header__logo img {
    width: 140px;
    max-width: 140px;
  }

  .apex-header__actions {
    gap: 8px;
  }

  .apex-header__account-wrap,
  .apex-header__wishlist {
    display: none;
  }

  .apex-header__cart {
    height: 48px;
    padding: 0 15px;
  }

  .apex-header__cart-text {
    display: none;
  }

  .apex-header__menu {
    display: block;
  }


  /* MOBILE NAV */

  .apex-header__mobile-nav {
    position: absolute;

    top: 100%;
    left: 0;
    right: 0;

    display: block;

    padding: 15px 20px;

    background: #fff;

    border-top: 1px solid #e5e6e8;

    box-shadow: 0 15px 35px rgba(0, 0, 0, .10);

    opacity: 0;
    visibility: hidden;

    transform: translateY(-10px);

    transition: .2s ease;

    z-index: 150;
  }

  .apex-header__mobile-nav.is-open {
    opacity: 1;
    visibility: visible;

    transform: translateY(0);
  }

  .apex-header__mobile-item {
    padding: 8px 0;

    border-bottom: 1px solid #eceef0;
  }

  .apex-header__mobile-item:last-child {
    border-bottom: 0;
  }

  .apex-header__mobile-item > a {
    display: block;

    padding: 10px 5px;

    color: var(--apex-text);
    text-decoration: none;

    font-size: 16px;
    font-weight: 700;
  }

  .apex-header__mobile-children {
    display: grid;

    padding: 5px 0 8px 18px;
    gap: 4px;
  }

  .apex-header__mobile-children a {
    padding: 7px 0;

    color: #697383;
    text-decoration: none;
  }

}


@media screen and (max-width: 480px) {

  .apex-header__inner {
    padding: 0 12px;
  }

  .apex-header__logo {
    width: 115px;
  }

  .apex-header__logo img {
    width: 115px;
  }

  .apex-header__cart {
    padding: 0 12px;
  }

  .apex-header__cart-count {
    min-width: 27px;
    height: 27px;
  }

  .apex-header__menu {
    width: 44px;
    height: 44px;
  }

}

{% endstylesheet %}


