<div
  class="atomic-main-footer"
  style="
    --atomic-footer-bg: {{ section.settings.background_color }};
    --atomic-footer-text: {{ section.settings.text_color }};
    --atomic-footer-heading: {{ section.settings.heading_color }};
    --atomic-footer-link-hover: {{ section.settings.link_hover_color }};
    --atomic-footer-size: {{ section.settings.font_size }}px;
    --atomic-footer-top-padding: {{ section.settings.top_padding }}px;
    --atomic-footer-bottom-padding: {{ section.settings.bottom_padding }}px;
    --atomic-footer-bottom-border: {{ section.settings.bottom_border_color }};
  "
>
  <div class="atomic-footer-inner">

    <!-- CUSTOMER SUPPORT -->
    {% if section.settings.show_support %}
      <div class="atomic-footer-column atomic-footer-support">
        {% if section.settings.support_heading != blank %}
          <h3 class="atomic-footer-heading">
            {{ section.settings.support_heading }}
          </h3>
        {% endif %}

        {% if section.settings.support_content != blank %}
          <div class="atomic-footer-text">
            {{ section.settings.support_content | newline_to_br }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- COMPANY -->
    {% if section.settings.show_company %}
      <div class="atomic-footer-column">
        {% if section.settings.company_heading != blank %}
          <h3 class="atomic-footer-heading">
            {{ section.settings.company_heading }}
          </h3>
        {% endif %}

        {% if section.settings.company_links != blank %}
          <ul class="atomic-footer-menu">
            {% assign company_items = section.settings.company_links | newline_to_br | split: '<br />' %}
            {% for item in company_items %}
              {% assign parts = item | split: '|' %}
              {% assign item_title = parts[0] | strip %}
              {% assign item_url = parts[1] | strip %}
              {% if item_title != blank %}
                <li>
                  {% if item_url != blank %}
                    <a href="{{ item_url }}">{{ item_title }}</a>
                  {% else %}
                    <span>{{ item_title }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}

    <!-- INFORMATION -->
    {% if section.settings.show_information %}
      <div class="atomic-footer-column">
        {% if section.settings.information_heading != blank %}
          <h3 class="atomic-footer-heading">
            {{ section.settings.information_heading }}
          </h3>
        {% endif %}

        {% if section.settings.information_links != blank %}
          <ul class="atomic-footer-menu">
            {% assign information_items = section.settings.information_links | newline_to_br | split: '<br />' %}
            {% for item in information_items %}
              {% assign parts = item | split: '|' %}
              {% assign item_title = parts[0] | strip %}
              {% assign item_url = parts[1] | strip %}
              {% if item_title != blank %}
                <li>
                  {% if item_url != blank %}
                    <a href="{{ item_url }}">{{ item_title }}</a>
                  {% else %}
                    <span>{{ item_title }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}

    <!-- POLICIES -->
    {% if section.settings.show_policies %}
      <div class="atomic-footer-column">
        {% if section.settings.policies_heading != blank %}
          <h3 class="atomic-footer-heading">
            {{ section.settings.policies_heading }}
          </h3>
        {% endif %}

        {% if section.settings.policies_links != blank %}
          <ul class="atomic-footer-menu">
            {% assign policies_items = section.settings.policies_links | newline_to_br | split: '<br />' %}
            {% for item in policies_items %}
              {% assign parts = item | split: '|' %}
              {% assign item_title = parts[0] | strip %}
              {% assign item_url = parts[1] | strip %}
              {% if item_title != blank %}
                <li>
                  {% if item_url != blank %}
                    <a href="{{ item_url }}">{{ item_title }}</a>
                  {% else %}
                    <span>{{ item_title }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}

    <!-- FOLLOW US -->
    {% if section.settings.show_follow %}
      <div class="atomic-footer-column atomic-footer-follow">
        {% if section.settings.follow_heading != blank %}
          <h3 class="atomic-footer-heading">
            {{ section.settings.follow_heading }}
          </h3>
        {% endif %}

        {% if section.settings.follow_description != blank %}
          <div class="atomic-footer-follow-text">
            {{ section.settings.follow_description | newline_to_br }}
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="atomic-footer-social">
            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <span aria-hidden="true">f</span>
              </a>
            {% endif %}

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <span aria-hidden="true">◎</span>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>

  <!-- BOTTOM UTILITY ROW -->
  {% if section.settings.show_bottom_row %}
    <div class="atomic-footer-bottom">
      <div class="atomic-footer-bottom-inner">

        <div class="atomic-footer-currency">
          {% if section.settings.show_currency_selector and localization.available_countries.size > 1 %}
            {% form 'localization', id: 'AtomicFooterCountryForm', class: 'atomic-footer-localization' %}
              <label class="visually-hidden" for="AtomicFooterCountry">
                Country or region
              </label>

              <select
                id="AtomicFooterCountry"
                name="country_code"
                class="atomic-footer-country"
                onchange="this.form.submit()"
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            {% endform %}
          {% else %}
            <span>{{ section.settings.currency_text }}</span>
          {% endif %}
        </div>

        <div class="atomic-footer-copyright">
          {% if section.settings.copyright_text != blank %}
            {{ section.settings.copyright_text }}
          {% else %}
            © {{ 'now' | date: '%Y' }} {{ shop.name }}
          {% endif %}
        </div>

        <div class="atomic-footer-payments">
          {% if section.settings.payment_text != blank %}
            <span class="atomic-footer-payment-text">
              {{ section.settings.payment_text }}
            </span>
          {% endif %}

          {% if section.settings.show_payment_icons %}
            <div class="atomic-footer-payment-icons">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'atomic-footer-payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .atomic-main-footer {
    width: 100%;
    background: var(--atomic-footer-bg);
    color: var(--atomic-footer-text);
    box-sizing: border-box;
  }

  .atomic-main-footer,
  .atomic-main-footer * {
    box-sizing: border-box;
  }

  .atomic-footer-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--atomic-footer-top-padding) 38px var(--atomic-footer-bottom-padding);
    display: grid;
    grid-template-columns:
      minmax(230px, 1.5fr)
      minmax(130px, 1fr)
      minmax(130px, 1fr)
      minmax(130px, 1fr)
      minmax(230px, 1.5fr);
    column-gap: 35px;
    align-items: start;
  }

  .atomic-footer-column {
    min-width: 0;
  }

  .atomic-footer-heading {
    margin: 0 0 18px;
    color: var(--atomic-footer-heading) !important;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .atomic-footer-text {
    color: var(--atomic-footer-text);
    font-size: var(--atomic-footer-size);
    font-weight: 500;
    line-height: 1.75;
  }

  .atomic-footer-menu {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .atomic-footer-menu li {
    margin: 0;
    padding: 0;
  }

  .atomic-footer-menu a {
    color: var(--atomic-footer-text);
    font-size: var(--atomic-footer-size);
    font-weight: 500;
    line-height: 1.6;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .atomic-footer-menu a:hover {
    color: var(--atomic-footer-link-hover);
  }

  .atomic-footer-follow-text {
    max-width: 270px;
    color: var(--atomic-footer-text);
    font-size: var(--atomic-footer-size);
    font-weight: 500;
    line-height: 1.7;
  }

  .atomic-footer-social {
    display: flex;
    margin-top: 18px;
  }

  .atomic-footer-social a {
    width: 43px;
    height: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--atomic-footer-text);
    text-decoration: none;
    font-size: 18px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .atomic-footer-social a + a {
    border-left: none;
  }

  .atomic-footer-social a:hover {
    background: var(--atomic-footer-link-hover);
    border-color: var(--atomic-footer-link-hover);
    color: #ffffff;
  }

  /* BOTTOM ROW */
  .atomic-footer-bottom {
    width: 100%;
    border-top: 1px solid var(--atomic-footer-bottom-border);
  }

  .atomic-footer-bottom-inner {
    width: 100%;
    max-width: 1400px;
    min-height: 58px;
    margin: 0 auto;
    padding: 12px 38px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 24px;
  }

  .atomic-footer-currency,
  .atomic-footer-copyright,
  .atomic-footer-payments {
    color: var(--atomic-footer-text);
    font-size: 11px;
    line-height: 1.4;
  }

  .atomic-footer-copyright {
    text-align: center;
    white-space: nowrap;
  }

  .atomic-footer-payments {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .atomic-footer-payment-text {
    white-space: nowrap;
  }

  .atomic-footer-payment-icons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    flex-wrap: wrap;
  }

  .atomic-footer-payment-icon {
    width: 34px;
    height: auto;
    max-height: 24px;
  }

  .atomic-footer-localization {
    margin: 0;
  }

  .atomic-footer-country {
    min-width: 105px;
    max-width: 145px;
    padding: 6px 24px 6px 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0;
    background: transparent;
    color: var(--atomic-footer-text);
    font-size: 11px;
    cursor: pointer;
  }

  .atomic-footer-country option {
    color: #222222;
    background: #ffffff;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .atomic-footer-inner {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 40px;
      column-gap: 30px;
      padding-left: 30px;
      padding-right: 30px;
    }

    .atomic-footer-bottom-inner {
      padding-left: 30px;
      padding-right: 30px;
    }

    .atomic-footer-follow-text {
      max-width: 350px;
    }
  }

  @media screen and (max-width: 749px) {
    .atomic-footer-inner {
      grid-template-columns: 1fr;
      row-gap: 35px;
      padding: 40px 22px 30px;
    }

    .atomic-footer-column {
      width: 100%;
    }

    .atomic-footer-heading {
      margin-bottom: 12px;
    }

    .atomic-footer-follow-text {
      max-width: 100%;
    }

    .atomic-footer-social {
      margin-top: 15px;
    }

    .atomic-footer-bottom-inner {
      grid-template-columns: 1fr;
      row-gap: 12px;
      justify-items: center;
      padding: 16px 22px;
    }

    .atomic-footer-currency,
    .atomic-footer-copyright,
    .atomic-footer-payments {
      text-align: center;
      justify-content: center;
    }

    .atomic-footer-payments {
      flex-wrap: wrap;
    }

    .atomic-footer-payment-icons {
      justify-content: center;
    }
  }
{% endstylesheet %}

