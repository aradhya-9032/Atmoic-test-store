<section class="apex-newsletter apex-section"><div class="apex-newsletter__texture"></div><div class="apex-container apex-newsletter__inner"><div><div class="apex-label">{{ section.settings.eyebrow }}</div><h2 class="apex-display">{{ section.settings.heading }}</h2><div class="apex-newsletter__copy">{{ section.settings.body }}</div></div><div class="apex-newsletter__form-wrap">{% form 'customer', class:'apex-newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button type="submit">{{ section.settings.button_label }} →</button>{% if form.posted_successfully? %}<p class="apex-newsletter__success">{{ section.settings.success_message }}</p>{% endif %}{% endform %}</div></div></section>
{% stylesheet %}
.apex-newsletter{background:linear-gradient(120deg,#000 0%,#07122a 55%,#0b1d4f 100%);color:#fff;padding:78px 0}.apex-newsletter__texture{position:absolute;inset:0;opacity:.23;background-image:linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:48px 48px}.apex-newsletter__inner{position:relative;display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.apex-newsletter h2{font-size:58px;line-height:.95;margin:12px 0 18px;text-transform:uppercase}.apex-newsletter__copy{max-width:540px;color:rgba(255,255,255,.68);font-size:16px;line-height:1.7}.apex-newsletter__form-wrap{align-self:center}.apex-newsletter__form{display:grid;grid-template-columns:1fr auto;gap:10px}.apex-newsletter__form input{min-height:54px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.05);color:#fff;padding:0 16px;outline:none}.apex-newsletter__form button{min-height:54px;padding:0 24px;border:0;background:var(--apex-brandeis);color:#fff;font-weight:700;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.apex-newsletter__success{color:var(--apex-electric);font-size:12px;margin-top:10px}@media(max-width:800px){.apex-newsletter__inner{grid-template-columns:1fr;gap:32px}.apex-newsletter h2{font-size:44px}.apex-newsletter__form{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}
{"name":"APEX Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"08 / STAY AHEAD"},{"type":"text","id":"heading","label":"Heading","default":"BUILD BETTER. KNOW MORE."},{"type":"richtext","id":"body","label":"Body","default":"<p>Performance builds, new arrivals and technical knowledge. Straight to your inbox.</p>"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Your email address"},{"type":"text","id":"button_label","label":"Button","default":"Join"},{"type":"text","id":"success_message","label":"Success message","default":"You're on the list."}],"presets":[{"name":"APEX Newsletter"}]}
{% endschema %}
